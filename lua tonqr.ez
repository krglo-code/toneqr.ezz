    local function makeThemeColor(which, fallback)
        local LT = Lumen and Lumen.Theme;
        if LT then
            if which == "MainColor" then return LT.Surface or fallback end
            if which == "BackgroundColor" then return LT.Background or fallback end
            if which == "AccentColor" then return LT.Accent or fallback end
            if which == "FontColor" then return LT.Text or fallback end
            if which == "OutlineColor" then return LT.Border or fallback end
        end
        if which == "MainColor" then return Color3.fromRGB(19, 26, 34) end
        if which == "BackgroundColor" then return Color3.fromRGB(12, 17, 23) end
        if which == "AccentColor" then return Color3.fromRGB(41, 197, 255) end
        if which == "FontColor" then return Color3.fromRGB(232, 244, 255) end
        if which == "OutlineColor" then return Color3.fromRGB(30, 42, 53) end
        return fallback;
    end;
