do
local old_raycast = utility.Raycast;
getgenv().Rivals = getgenv().Rivals or {
    Silent = { enabled = true };
    Fov = { Enabled = true, Fov = 150, Color = Color3.new(1, 1, 1) };
};

local circle = Drawing.new("Circle");
circle.Thickness = 2;
circle.Filled = false;
trove:Add(function() pcall(function() circle:Remove() end) end);

local function rivalsUpdateFov()
    circle.Visible = ELI.silent_aim.enable and ELI.silent_aim.show_fov;
    circle.Radius = ELI.silent_aim.fov_radius;
    circle.Color = ELI.silent_aim.fov_color;
    circle.Thickness = ELI.silent_aim.fov_thickness;
    local vp = camera.ViewportSize;
    circle.Position = Vector2.new(vp.X / 2, vp.Y / 2);
    circle.Filled = false;
end;

pcall(function()
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(rivalsUpdateFov);
end);
rivalsUpdateFov();
task.spawn(function()
    while task.wait(0.25) do
        pcall(rivalsUpdateFov);
    end;
end);

local function getRivalsPlayers()
    local entities = {};
    for _, child in workspace:GetChildren() do
        if child:FindFirstChildOfClass("Humanoid") then
            table.insert(entities, child);
        elseif child.Name == "HurtEffect" then
            for _, hurtPlayer in child:GetChildren() do
                if hurtPlayer.ClassName ~= "Highlight" then
                    table.insert(entities, hurtPlayer);
                end;
            end;
        end;
    end;
    return entities;
end;

-- KICIA SILENT PORT (replaces elisium getRivalsClosest): mode bridge +
-- team trigger + closest-part evaluation. Silent mode only fires inside
-- FOV; trigger path reuses same target (TryTriggerbotShot equivalent).
local function kiciaSilentMode()
    return 'Silent';
end;
local function kiciaIsSilentSelected()
    return ELI.silent_aim.enable == true and kiciaSilentMode() == 'Silent';
end;
local function kiciaSilentTargetPart(char)
    if not char then return nil end;
    -- KICIA closest-part: nearest part to crosshair, not fixed Head.
    if ELI.silent_aim.closest_part then
        local mp = Vector2.new(mouse.X, mouse.Y);
        local best, bestD = nil, math.huge;
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") then
                local sp, on = camera:WorldToViewportPoint(p.Position);
                if on then
                    local d = (mp - Vector2.new(sp.X, sp.Y)).Magnitude;
                    if d < bestD then best, bestD = p, d end;
                end;
            end;
        end;
        if best then return best end;
    end;
    return char:FindFirstChild(ELI.targeting.part) or char:FindFirstChild("Head");
end;
local function kiciaSilentBlocked(char, part)
    -- KICIA team trigger: skip teammates + deflecting katana.
    local plr = players:GetPlayerFromCharacter(char);
    if plr then
        if plr:GetAttribute('TeamID') == local_player:GetAttribute('TeamID') then return true end;
        if is_deflecting(plr) then return true end;
        if ELI.targeting.riot_shield and has_riot(plr) then return true end;
    end;
    if ELI.targeting.visible_only and not check_wall(part) then return true end;
    return false;
end;

local function getRivalsClosest()
    if not kiciaIsSilentSelected() then return nil end;
    local closest, closestDist = nil, math.huge;
    local char = players.LocalPlayer.Character;
    if not char then return end;
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2);

    for _, ent in getRivalsPlayers() do
        if ent == char then continue end;
        local hum = ent:FindFirstChildOfClass("Humanoid");
        if not hum or hum.Health <= 0 then continue end;
        local part = kiciaSilentTargetPart(ent);
        if not part then continue end;
        if kiciaSilentBlocked(ent, part) then continue end;
        local pos, onScreen = camera:WorldToViewportPoint(part.Position);
        if not onScreen then continue end;

        local dist = (center - Vector2.new(pos.X, pos.Y)).Magnitude;

        if ELI.silent_aim.show_fov and dist > ELI.silent_aim.fov_radius then
            continue;
        end;

        if dist < closestDist then
            closest, closestDist = ent, dist;
        end;
    end;
    return closest;
end;

utility.Raycast = LPH_NO_VIRTUALIZE(function(...)
    local args = {...};
    if #args > 0 and args[4] == 999 and ELI.silent_aim.enable and getgenv().elisium_in_duel() then
        -- KICIA SILENT PORT: BeginAimbotSilentShot equivalent. prime aim on
        -- evaluated part (closest-part aware), hit-chance roll, then fire.
        if math.random(1, 100) <= (ELI.silent_aim.hit_chance or 100) then
            local closest = getRivalsClosest();
            local part = closest and kiciaSilentTargetPart(closest);
            if part then
                -- KICIA StartShooting prime: detour cam at real shot moment.
                local cc = camera.CFrame;
                pcall(function()
                    camera.CFrame = CFrame.new(cc.Position, part.Position);
                end);
                elisium_state.silentTarget = part.Position;
                elisium_state.silentTargetT = tick();
                args[3] = part.Position;
                task.delay(0.03, function()
                    pcall(function()
                        if camera.CFrame.Position == cc.Position then return end;
                        camera.CFrame = cc;
                    end);
                end);
            end;
        end;
    end;
    return old_raycast(table.unpack(args));
end);
end;

trove:Add(function()
    utility.Raycast = old_raycast;
end);

