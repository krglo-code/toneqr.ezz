do
ELI.game_font = ELI.game_font or 'Default';
ELI.game_font_color_on = ELI.game_font_color_on or false;
ELI.game_font_color = ELI.game_font_color or Color3.fromRGB(255,255,255);
ELI.RIVALS_FONTS = { 'Default','GothamSSm','GothamBlack','GothamBold','GothamMedium','Code','Arcade','Fantasy','Cartoon','SciFi','LuckiestGuy','Bangers','Creepster','Jura','Oswald','Roboto','RobotoBlack','RobotoCondensed','RobotoMono','Montserrat','MontserratBlack','Nunito','NunitoBlack','IndieFlower','PatrickHand','SpecialElite','Kalam','Michroma','Poppins','PoppinsBlack','Inter','InterBlack','SourceSansPro','SourceSansBold','Merriweather','PlayfairDisplay','SpaceMono','Ubuntu','Lato','LatoBlack','OpenSans','Raleway','BebasNeue','Anton','Pacifico','DancingScript','GreatVibes','PressStart2P','Bodoni','Garamond','Fondamento' };
ELI.RIVALS_FONT_FALLBACK = { Gotham='GothamSSm', GothamBold='GothamSSm', GothamMedium='GothamSSm', GothamBlack='GothamSSm' };
getgenv()._eliFontWatch = function()
    if getgenv()._EliFontConn then return end;
    pcall(function()
        local pg = local_player.PlayerGui;
        if not pg then return end;
        getgenv()._EliFontConn = pg.DescendantAdded:Connect(function(d)
            pcall(function()
                if not (d:IsA('TextLabel') or d:IsA('TextButton') or d:IsA('TextBox')) then return end;
                local F = getgenv()._EliFont;
                if F and F.face and d.FontFace.Family ~= F.face.Family then d.FontFace = F.face end;
                if F and F.col and d.TextColor3 ~= F.col then d.TextColor3 = F.col end;
            end);
        end);
    end);
end;
getgenv()._eliApplyFont = function()
    local wantFont = not (ELI.game_font == nil or ELI.game_font == '' or ELI.game_font == 'Default');
    local wantColor = ELI.game_font_color_on and true or false;
    if not wantFont and not wantColor then return end;
    getgenv()._eliFontWatch();
    local F = getgenv()._EliFont;
    if type(F) ~= 'table' then F = {} getgenv()._EliFont = F end;
    -- FIXED: prefer downloaded elisium .font (ProggyTiny etc) first, then Font.fromName
    local fam = wantFont and (ELI.RIVALS_FONT_FALLBACK[ELI.game_font] or ELI.game_font) or nil;
    if F.fam ~= fam then
        F.fam = fam F.face = nil F.idx = 0 F.list = nil F.rescan = 0;
        if fam then
            -- FIXED order: elisium downloaded fonts first (they exist), Font.fromName second
            local cf0 = getgenv().fonts and getgenv().fonts[fam];
            if cf0 then F.face = cf0 end;
            if not F.face then pcall(function() F.face = Font.fromName(fam, Enum.FontWeight.Regular, Enum.FontStyle.Normal) end); end;
            if not F.face then
                local cf = getgenv().fonts and getgenv().fonts[fam];
                if cf then F.face = cf end;
            end;
        end;
    end;
    if wantFont and not F.face then
        local ef = nil;
        pcall(function() ef = Enum.Font[ELI.game_font] end);
        F.enum = ef;
        if not ef then
            local cf = getgenv().fonts and getgenv().fonts[ELI.game_font];
            if cf then F.face = cf end;
            if not F.face then return end;
        end;
    end;
    F.col = wantColor and ELI.game_font_color or nil;
    if (F.rescan or 0) + 10 < tick() or type(F.list) ~= 'table' then
        F.rescan = tick() F.list = {} F.idx = 0;
        pcall(function()
            local pg = local_player.PlayerGui;
            if pg then
                for _, d in ipairs(pg:GetDescendants()) do
                    if #F.list >= 1500 then break end;
                    local okT = false;
                    pcall(function() okT = d:IsA('TextLabel') or d:IsA('TextButton') or d:IsA('TextBox') end);
                    if okT then F.list[#F.list+1] = d end;
                end;
            end;
        end);
    end;
    local idx = F.idx or 0;
    local budget = 0;
    while idx < #F.list and budget < 150 do
        idx = idx + 1 budget = budget + 1;
        local d = F.list[idx];
        pcall(function()
            if d and d.Parent then
                if wantFont then
                    if F.face then
                        if d.FontFace.Family ~= F.face.Family then d.FontFace = F.face end;
                    elseif F.enum and d.Font ~= F.enum then d.Font = F.enum end;
                end;
                if F.col and d.TextColor3 ~= F.col then d.TextColor3 = F.col end;
            end;
        end);
    end;
    F.idx = (idx >= #F.list) and 0 or idx;
end;
getgenv().elisium_apply_font = getgenv()._eliApplyFont;
trove:Add(run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
    if getgenv().elisium_lite then return end;
    if (getgenv()._EliFontTick or 0) + 1 > tick() then return end;
    getgenv()._EliFontTick = tick();
    pcall(getgenv()._eliApplyFont);
end)));
do
    local font_box = Tabs.misc_tab:AddRightGroupbox('game fonts');
    local merged = {};
    do local seen = {} for _, n in ipairs(ELI.RIVALS_FONTS) do if not seen[n] then seen[n] = true merged[#merged+1] = n end end for _, n in ipairs(font_indexes) do if not seen[n] then seen[n] = true merged[#merged+1] = n end end end;
    font_box:AddDropdown('game_font_pick', { Text='font (rivals + elisium)', Values=merged, Default='Default', Callback=function(v) ELI.game_font = v pcall(getgenv()._eliApplyFont) end });
    font_box:AddToggle('game_font_color_on', { Text='custom text color', Default=false, Callback=function(v) ELI.game_font_color_on = v pcall(getgenv()._eliApplyFont) end });
    font_box:AddLabel('text color'):AddColorPicker('game_font_color', { Default=Color3.fromRGB(255,255,255), Callback=function(c) ELI.game_font_color = c ELI.game_font_color_on = true pcall(getgenv()._eliApplyFont) end });
    font_box:AddButton('apply font now', function() pcall(getgenv()._eliApplyFont) end);
end;
end;

    esp_throwable_tab:AddDropdown('thrower_esp_font', {
        Text = 'font',
        Values = font_indexes,
        Default = 'ProggyTiny',
        Visible = false,
        Callback = function(v)
            ELI.thrower_esp.font = v;

            for _, obj in next, thrower do
                obj.name:Destroy();
                obj.dist:Destroy();
                obj.icon:Destroy();
            end;

            table.clear(thrower);
        end;
    });
end;
local esp_preview_box = Tabs.esptab:AddRightGroupbox('ESP Preview');
-- KICIA LIVE PREVIEW PORT (same 'ESP Preview' name): part-built dummy +
-- live mirrors of every ESP flag (box/fill/glow/health/name/distance/
-- weapon/deflect/rank/streak/highlight). replaces static avatar preview.
-- WRAPPED in a function: this file is one giant chunk, a bare `do` block
-- here pushes locals past Luau's 200-register limit. function = own file.
local function _kiciaBuildPreview()
	if getgenv()._EliPvConns then for _, c in ipairs(getgenv()._EliPvConns) do pcall(function() c:Disconnect() end) end end
	getgenv()._EliPvConns = {};
	local function pvConn(sig, fn)
		local c = sig:Connect(fn);
		table.insert(getgenv()._EliPvConns, c);
		return c;
	end;
	local function pvNew(class, props)
		local i = Instance.new(class);
		if type(props) == 'table' then
			for k, v in pairs(props) do pcall(function() i[k] = v end) end
		end;
		return i;
	end;
	local host = esp_preview_box:GetContent();
	local Height = 280;
	-- KICIA: EspRenderSettings equivalent, driven by live ELI.esp below.
	local function kiciaPreviewColor()
		if ELI.esp.visible.enable then return ELI.esp.visible.color end;
		if ELI.esp.filled.hit_flash then return ELI.esp.filled.hit_color end;
		return ELI.esp.box.color;
	end;
	local function kiciaPreviewSettings()
		local e = ELI.esp;
		return {
			Enabled = e.enable == true;
			ShowBox = e.box.enable == true;
			ShowHighlight = e.highlight.enable == true;
			FillAlpha = 1 - (e.filled.transparency or 0.75);
			OutlineAlpha = 1 - (e.highlight.outline_transparency or 0);
			ShowName = e.text.name.enable == true;
			ShowWeapon = e.text.tool.enable == true;
			ShowDistance = e.text.studs.enable == true;
			ShowDeflecting = e.visible.enable == true;
			ShowRank = e.text.name.enable == true;
			ShowWinStreak = e.text.studs.enable == true;
			VisibleColor = kiciaPreviewColor();
		};
	end;
	local Container = pvNew('Frame', { Name = 'PreviewContainer', Parent = host, Size = UDim2.new(1, -10, 0, Height), BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true });
	local Area = pvNew('Frame', { Name = 'Area', Parent = Container, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true });
	local Viewport = pvNew('ViewportFrame', { Name = 'Viewport', Parent = Area, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Ambient = Color3.fromRGB(180, 180, 180), LightColor = Color3.fromRGB(255, 255, 255), LightDirection = Vector3.new(-1, -1, -1) });
	-- KICIA: BuildEspPreviewModel equivalent. part-built dummy, no avatar fetch.
	local function kiciaPart(model, name, size, pos, color)
		local p = pvNew('Part', { Name = name, Size = size, CFrame = CFrame.new(pos), Color = color, Material = Enum.Material.SmoothPlastic, Anchored = true, CanCollide = false, Parent = model });
		return p;
	end;
	local Dummy = pvNew('Model', { Name = 'KiciaHookEspPreview', Parent = Viewport });
	local _bodyC = Color3.fromRGB(92, 98, 112);
	local _limbC = Color3.fromRGB(72, 78, 90);
	local _torso = kiciaPart(Dummy, 'Torso', Vector3.new(2, 2.2, 1), Vector3.new(0, 0.65, 0), _bodyC);
	kiciaPart(Dummy, 'Head', Vector3.new(1.45, 1.45, 1.45), Vector3.new(0, 2.55, 0), Color3.fromRGB(152, 158, 168));
	kiciaPart(Dummy, 'LeftArm', Vector3.new(0.75, 2.1, 0.8), Vector3.new(-1.4, 0.7, 0), _limbC);
	kiciaPart(Dummy, 'RightArm', Vector3.new(0.75, 2.1, 0.8), Vector3.new(1.4, 0.7, 0), _limbC);
	kiciaPart(Dummy, 'LeftLeg', Vector3.new(0.85, 2.2, 0.9), Vector3.new(-0.52, -1.55, 0), _limbC);
	kiciaPart(Dummy, 'RightLeg', Vector3.new(0.85, 2.2, 0.9), Vector3.new(0.52, -1.55, 0), _limbC);
	Dummy.PrimaryPart = _torso;
	local VCam = pvNew('Camera', { Parent = Viewport, FieldOfView = 60 });
	Viewport.CurrentCamera = VCam;
	VCam.CFrame = CFrame.new(Vector3.new(0, 1, 8), Vector3.new(0, 0.6, 0));
	-- KICIA: overlay (box + highlight + rails + labels) mirrors live flags.
	local Overlay = pvNew('Frame', { Name = 'Esp', Parent = Area, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.fromOffset(90, 150), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2 });
	local HL = pvNew('Highlight', { Parent = Dummy, Adornee = Dummy, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop });
	local Box = pvNew('UIStroke', { Parent = Overlay, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 1 });
	local Fill = pvNew('UIGradient', { Parent = Overlay });
	local NameL = pvNew('TextLabel', { Parent = Overlay, Position = UDim2.new(0, 0, 0, -16), Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Text = local_player.Name, TextSize = 12, ZIndex = 2 });
	local HpBg = pvNew('Frame', { Parent = Overlay, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0, -6, 0, 0), Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 20), BorderSizePixel = 0, ZIndex = 2 });
	local HpFill = pvNew('Frame', { Parent = HpBg, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0.75, 0), BackgroundColor3 = Color3.fromRGB(0, 255, 0), BorderSizePixel = 0, ZIndex = 3 });
	local WepL = pvNew('TextLabel', { Parent = Overlay, Position = UDim2.new(0, 0, 1, 2), Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Text = 'Assault Rifle', TextSize = 11, ZIndex = 2 });
	local DistL = pvNew('TextLabel', { Parent = Overlay, Position = UDim2.new(0, 0, 1, 15), Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Text = '42m', TextSize = 11, ZIndex = 2 });
	local DeflL = pvNew('TextLabel', { Parent = Overlay, Position = UDim2.new(1, 4, 0, 0), Size = UDim2.new(0, 60, 0, 12), BackgroundTransparency = 1, Text = 'deflect', TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 });
	local RankL = pvNew('TextLabel', { Parent = Overlay, Position = UDim2.new(1, 4, 0, 14), Size = UDim2.new(0, 60, 0, 12), BackgroundTransparency = 1, Text = ELI.rank_spoof and ELI.rank_spoof.rank or 'Gold', TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 });
	local StreakL = pvNew('TextLabel', { Parent = Overlay, Position = UDim2.new(1, 4, 0, 28), Size = UDim2.new(0, 60, 0, 12), BackgroundTransparency = 1, Text = 'streak', TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 });
	do
		local pf = getgenv().fonts and (getgenv().fonts['ProggyTiny'] or getgenv().fonts['Smallest Pixel']);
		if pf then
			for _, L in ipairs({ NameL, WepL, DistL, DeflL, RankL, StreakL }) do
				pcall(function() L.FontFace = pf end);
			end;
		end;
	end;
	-- KICIA: UpdateEspPreview equivalent. runs every frame, mirrors live.
	local _kiciaT = 0;
	pvConn(run_service.RenderStepped, function(dt)
		_kiciaT += dt;
		if not Overlay.Parent then return end;
		if not Area.Visible then return end;
		local s = kiciaPreviewSettings();
		local color = s.VisibleColor;
		Overlay.Visible = s.Enabled;
		HL.Enabled = s.Enabled and s.ShowHighlight;
		HL.FillColor = color;
		HL.OutlineColor = color:Lerp(Color3.fromRGB(20, 22, 30), 0.24);
		HL.FillTransparency = s.FillAlpha;
		HL.OutlineTransparency = s.OutlineAlpha;
		Box.Enabled = s.ShowBox;
		Box.Color = color;
		Box.Thickness = ELI.esp.box.thickness or 1;
		Fill.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, ELI.esp.filled.color_start), ColorSequenceKeypoint.new(1, ELI.esp.filled.color_end) });
		Fill.Rotation = ELI.esp.filled.rotation or 90;
		Overlay.BackgroundTransparency = ELI.esp.filled.enable and ELI.esp.filled.transparency or 1;
		NameL.Visible = s.ShowName;
		NameL.Text = local_player.Name;
		NameL.TextColor3 = ELI.esp.text.name.color;
		NameL.TextSize = ELI.esp.text.size;
		-- KICIA: health rail breathes so fill/gradient read live.
		local hp = 0.5 + 0.5 * math.sin(_kiciaT * 1.5);
		HpFill.Size = UDim2.new(1, 0, hp, 0);
		HpFill.BackgroundColor3 = ELI.esp.health.color_low:Lerp(ELI.esp.health.color_mid, hp):Lerp(ELI.esp.health.color_high, hp * hp);
		HpBg.Visible = ELI.esp.health.enable;
		WepL.Visible = s.ShowWeapon;
		WepL.Text = 'Assault Rifle';
		WepL.TextColor3 = ELI.esp.text.tool.color;
		DistL.Visible = s.ShowDistance;
		DistL.Text = '42m';
		DistL.TextColor3 = ELI.esp.text.studs.color;
		DeflL.Visible = s.ShowDeflecting;
		RankL.Visible = s.ShowRank;
		RankL.Text = (ELI.rank_spoof and ELI.rank_spoof.rank) or 'Gold';
		StreakL.Visible = s.ShowWinStreak;
		-- slow orbit so box/fill read from all sides.
		local a = _kiciaT * 0.4;
		VCam.CFrame = CFrame.new(Vector3.new(math.sin(a) * 8, 1.5, math.cos(a) * 8), Vector3.new(0, 0.6, 0));
	end);
	getgenv().elisium_esp_preview = { Settings = kiciaPreviewSettings, Kicia = true };
end;
_kiciaBuildPreview();

local misc_tab = Tabs.misc_tab; do
    local auto_tabbox = Tabs.misc_tab:AddRightTabbox(); do
        local auto_vote_map = auto_tabbox:AddTab('auto vote map'); do
            auto_vote_map:AddToggle('auto_vote_map_enable', {
                Text = 'enable',
                Default = false,
                Callback = function(v)
                    ELI.auto_vote_map.enable = v;
                end;
            });

            auto_vote_map:AddDropdown('auto_vote_map', {
                Values = {"Arena", "Big Graveyard", "Docks", "Splash", "Bridge", "Crossroads", "Big Crossroads", "Big Backrooms", "Battleground", "Big Arena", "Construction", "Playground", "Onyx", "Graveyard", "Big Splash", "Big Onyx", "Backrooms", "Station", "Dimension",},
                Default = "",
                Multi = false,
                Text = 'map',
                Callback = function(v)
                    ELI.auto_vote_map.map = v;
                end;
            });
        end;
    end;

    local troll_tab = Tabs.misc_tab:AddLeftTabbox(); do
        local device_spoof_tab = Tabs.character_tab:AddLeftTabbox():AddTab('device spoof'); do
            device_spoof_tab:AddToggle('device_spoof_enable', {
                Text = 'enable',
                Default = false,
                Callback = function(v)
                    ELI.device_spoof.enable = v;
                end;
            });

            device_spoof_tab:AddDropdown('device_spoof_type', {
                Values = {'mobile', 'pc', 'controller', 'vr'},
                Default = 'pc',
                Multi = false,
                Text = 'type',
                Callback = function(v)
                    local map = { mobile = 'Touch', pc = 'MouseKeyboard', controller = 'Gamepad', vr = 'VR' };
                    ELI.device_spoof.type = map[v] or v;
                end;
            });
        end;

        local sound_spammer_tab = troll_tab:AddTab('sound spammer'); do
            sound_spammer_tab:AddToggle('sound_spammer_enable', {
                Text = 'enable',
                Default = false,
                Callback = function(v)
                    ELI.sound_spammer.enable = v;
                end;
            });

            sound_spammer_tab:AddDropdown('sound_spammer_type', {
                Values = {'DoubleJump', 'Slide'},
                Default = 1,
                Multi = false,
                Text = 'sound type',
                Callback = function(v)
                    ELI.sound_spammer.type = v;
                end;
            });
        end;
    end;

    local spooftabthing = Tabs.character_tab:AddRightTabbox(); do
    -- NAME TAB (rivals engine): the old elisium name_spoof engine is retired
    -- (never enabled below). Display/user/level/streak/color all drive the
    -- rivals spoofer (RIV_Apply/RIV_Clear). Client-side only, like before.
    ELI.name_spoof.enable = false;
    ELI.rivspoof = ELI.rivspoof or {};
    local function rivApply()
        pcall(function() getgenv().RIV_Apply() end);
    end;
    local function rivSyncFromBoxes()
        pcall(function()
            local d = Options.name_spoof_display and Options.name_spoof_display.Value or "";
            local u = Options.name_spoof_username and Options.name_spoof_username.Value or "";
            local l = Options.name_spoof_level and Options.name_spoof_level.Value or "";
            local s = Options.name_spoof_streak and Options.name_spoof_streak.Value or "";
            ELI.rivspoof.display = tostring(d or "");
            ELI.rivspoof.user = tostring(u or "");
            local ln = tonumber(l);
            if ln then ELI.rivspoof.level = math.clamp(math.floor(ln), 0, 9999)
            else ELI.rivspoof.level = 0 end;
            local sn = tonumber(s);
            if sn then ELI.rivspoof.streak = math.clamp(math.floor(sn), 0, 999999)
            else ELI.rivspoof.streak = 0 end;
        end);
    end;
    local name_spoof = spooftabthing:AddTab('name');
    name_spoof:AddLabel('client-side only. server sees real info.', true);
    name_spoof:AddToggle('name_spoof_enable', {
        Text = 'spoof';
        Default = false;
        Callback = function(v)
            ELI.name_spoof.enable = false;
            if v then
                rivSyncFromBoxes();
                rivApply();
            else
                pcall(function() getgenv().RIV_Clear() end);
            end;
        end;
    });
    name_spoof:AddToggle('name_spoof_color_on', {
        Text = 'name color';
        Default = false,
        Callback = function(v)
            if v then
                pcall(function()
                    local c = Options.name_spoof_color and Options.name_spoof_color.Value;
                    if typeof(c) == "Color3" then
                        ELI.rivspoof.colorR = math.floor(c.R * 255);
                        ELI.rivspoof.colorG = math.floor(c.G * 255);
                        ELI.rivspoof.colorB = math.floor(c.B * 255);
                    end;
                end);
            else
                ELI.rivspoof.colorR, ELI.rivspoof.colorG, ELI.rivspoof.colorB = 255, 255, 255;
            end;
            rivApply();
        end;
    }):AddColorPicker('name_spoof_color', {
        Title = 'display color',
        Default = Color3.fromRGB(255, 255, 255),
        Callback = function(v)
            ELI.rivspoof.colorR = math.floor(v.R * 255);
            ELI.rivspoof.colorG = math.floor(v.G * 255);
            ELI.rivspoof.colorB = math.floor(v.B * 255);
            rivApply();
        end;
    });
    name_spoof:AddToggle('name_spoof_rainbow', {
        Text = 'rainbow username';
        Default = false,
        Callback = function(v)
            ELI.rivspoof.rainbow = (v == true);
            ELI.rivspoof.rainbowEnabled = (v == true);
            rivApply();
        end;
    });
    name_spoof:AddInput('name_spoof_display', {
        Default = '';
        Text = 'display name';
        Placeholder = 'fake display name';
        Callback = function(v)
            ELI.rivspoof.display = v or "";
            rivApply();
        end;
    });
    name_spoof:AddInput('name_spoof_username', {
        Default = '';
        Text = 'username (@handle)';
        Placeholder = 'fake @username';
        Callback = function(v)
            ELI.rivspoof.user = v or "";
            rivApply();
        end;
    });
    name_spoof:AddInput('name_spoof_level', {
        Default = '';
        Text = 'level';
        Placeholder = 'e.g. 100';
        Callback = function(v)
            local n = tonumber(v);
            if n then
                ELI.rivspoof.level = math.clamp(math.floor(n), 0, 9999);
                rivApply();
            end;
        end;
    });
    name_spoof:AddInput('name_spoof_streak', {
        Default = '';
        Text = 'win streak';
        Placeholder = 'e.g. 9999';
        Callback = function(v)
            local n = tonumber(v);
            if n then
                ELI.rivspoof.streak = math.clamp(math.floor(n), 0, 999999);
                rivApply();
            end;
        end;
    });
    name_spoof:AddButton('apply spoof', function() rivSyncFromBoxes(); rivApply() end);
    name_spoof:AddButton('clear spoof', function()
        pcall(function() getgenv().RIV_Clear() end);
        pcall(function()
            if Toggles.name_spoof_rainbow and Toggles.name_spoof_rainbow.Value then
                Toggles.name_spoof_rainbow:SetValue(false);
            end;
        end);
    end);
    end;

    local utility_tab = Tabs.misc_tab:AddLeftTabbox(); do
        local auto_loadout_tab = utility_tab:AddTab('auto loadout'); do
            auto_loadout_tab:AddToggle('auto_loadout_enable', {
                Text = 'enable',
                Default = false,
                Callback = function(v)
                    ELI.auto_loadout.enable = v;
                end;
            });

            local ascending_classes = {'Primary', 'Secondary', 'Melee', 'Utility'};
            for i = 1, #ascending_classes do
                local class = ascending_classes[i];
                local items = sorted_item_list[class] or {};
                local slot = class_dir[class:lower()];
                auto_loadout_tab:AddDropdown('auto_loadout_class_' .. class:lower(), {
                    Values = items,
                    Default = ELI.auto_loadout.loadout[slot],
                    Multi = false,
                    Text = class:lower(),
                    Callback = function(v)
                        ELI.auto_loadout.loadout[slot] = v;
                    end;
                });
            end;
            -- REFRESH: rebuild unlocked-only lists once inventory loads (fixes empty/ALL at boot)
            task.delay(6, function()
                pcall(function()
                    local u2 = {};
                    local inv2 = data_ctrl and data_ctrl.Get and data_ctrl:Get("WeaponInventory");
                    if type(inv2) == "table" then for k, v in pairs(inv2) do if v == true and type(k) == "string" then u2[k] = true; elseif type(v) == "string" then u2[v] = true; end; end; end;
                    if next(u2) == nil then return; end;
                    for _, cls in ipairs({'Primary','Secondary','Melee','Utility'}) do
                        local lst = {};
                        for _, it in next, item_lib.Items do
                            if it.Class == cls and it.Name ~= 'MISSING_WEAPON' and u2[it.Name] then table.insert(lst, it.Name); end;
                        end;
                        table.sort(lst);
                        local opt = Options['auto_loadout_class_' .. cls:lower()];
                        if opt then opt:SetValues(lst); end;
                    end;
                end);
            end);
        end;

        local auto_queue_tab = utility_tab:AddTab('auto queue'); do
            auto_queue_tab:AddToggle('auto_queue_enable', {
                Text = 'enable',
                Default = false,
                Callback = function(v)
                    ELI.auto_queue.enable = v;
                    if not v then
                        clickedontheremote = false;
                        was_i_in_a_match = false;
                    end;
                end;
            });

            auto_queue_tab:AddDropdown('auto_queue_mode', {
                Values = {"1v1", "2v2", "3v3", "4v4", "5v5", "2v2_beginner",},
                Default = "",
                Multi = false,
                Text = 'queue mode',
                Callback = function(v)
                    ELI.auto_queue.queue_mode = v;
                end;
            });
        end;
    end;

    local arcade_server_tab = Tabs.misc_tab:AddRightGroupbox('arcade server'); do
        arcade_server_tab:AddToggle('grab_drops_enable', {
            Text = 'grab drops',
            Default = false,
            Callback = function(v)
                ELI.arcade_server.grab_drops = v;
            end;
        });

        arcade_server_tab:AddToggle('auto_respawn_enable', {
            Text = 'auto respawn',
            Default = false,
            Callback = function(v)
                ELI.arcade_server.auto_respawn = v;
            end;
        });
    end;

end
(function()
    local desync_tab = Tabs.character_tab:AddLeftGroupbox('desync'); do
        local keybind_desync_enable = false;

        ELI.desync = ELI.desync or ELI.freecam or { enable = false, speed = 50 };
        ELI.freecam = ELI.desync;
        local FC = ELI.desync;
        local ContextActionService = game:GetService("ContextActionService");
        local StarterGui = game:GetService("StarterGui");
        local pi, abs, clamp, exp, rad, sign, sqrt, tan = math.pi, math.abs, math.clamp, math.exp, math.rad, math.sign, math.sqrt, math.tan;
        local NAV_GAIN = Vector3.new(1, 1, 1) * 64;
        local PAN_GAIN = Vector2.new(0.75, 1) * 8;
        local FOV_GAIN = 300;
        local PITCH_LIMIT = rad(90);
        -- desync cam: no springs, direct + tiny smoothing so it never shakes.
        local SMOOTH = 12;
        FC.sens = FC.sens or 1;
        local function wrapYaw(a)
            return (a + pi) % (2 * pi) - pi;
        end;
        local cameraPos, cameraRot, cameraFov = Vector3.new(), Vector2.new(), 0;
        local smPos, smRot = Vector3.new(), Vector2.new();
        local fc_keyboard, fc_navSpeed = { W = 0, A = 0, S = 0, D = 0, E = 0, Q = 0, Up = 0, Down = 0 }, 1;
        -- normal binds: WASD move, E up / Q down, Shift = fast, wheel = zoom.
        local fc_mouseDelta = Vector2.new();
        local fc_wheel = 0;
        local function fc_vel(dt)
            fc_navSpeed = clamp(fc_navSpeed + dt * (fc_keyboard.Up - fc_keyboard.Down) * 0.75, 0.01, 4);
            -- FIXED-BUGGED-LOOK: forward was -Z (S/W swapped feel), E/Q were
            -- inverted vs label, Shift polled every frame (UIS hitch = stuck fast).
            -- FIXED: W = -Z forward, E = +Y up per label, cached shift state.
            -- NOTE: applied via CFrame * offset (camera-space), so +Z input
            -- must be NEGATED at apply (forward = -Z). kept positive here.
            local kb = Vector3.new(fc_keyboard.D - fc_keyboard.A, fc_keyboard.E - fc_keyboard.Q, fc_keyboard.S - fc_keyboard.W);
            local shift = fc_keyboard.Shift == 1;
            local base = (FC.speed or 50) / 64;
            return kb * fc_navSpeed * base * (shift and 3 or 1);
        end;
        local function fc_pan(dt)
            -- FIXED-BUGGED-LOOK: delta was negated (mouse right = look left),
            -- then multiplied by dt TWICE (pan*dt in caller + here) = framerate
            -- dependent crawl. FIXED: raw delta here, single dt scale at apply.
            local m = fc_mouseDelta * (math.pi / 64);
            fc_mouseDelta = Vector2.new();
            return m;
        end;
        local function fc_fov(dt)
            local v = fc_wheel * 1.0;
            fc_wheel = 0;
            return v;
        end;
        local function fc_zero(t)
            for k, v in pairs(t) do t[k] = v * 0 end;
        end;
        local function fc_startCapture()
            -- FIXED-BUGGED-LOOK: old binds SUNK input at High priority = game
            -- never saw WASD release (stuck keys), Shift never bound (no fast),
            -- Up/Down nav keys unbound on most keyboards. FIXED: no-sink pass,
            -- Shift bound + cached, guard nil KeyCode (mouse inputs hit this).
            ContextActionService:BindActionAtPriority("DesyncKeyboard", function(_, state, input)
                if input.KeyCode and input.KeyCode.Name then
                    fc_keyboard[input.KeyCode.Name] = state == Enum.UserInputState.Begin and 1 or 0;
                end;
                return Enum.ContextActionResult.Pass;
            end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift);
            -- FIXED: track shift in table (no per-frame IsKeyDown hitch).
            ContextActionService:BindActionAtPriority("DesyncShift", function(_, state, _)
                fc_keyboard.Shift = state == Enum.UserInputState.Begin and 1 or 0;
                return Enum.ContextActionResult.Pass;
            end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift);
            ContextActionService:BindActionAtPriority("DesyncMousePan", function(_, _, input)
                -- FIXED-BUGGED-LOOK: delta was (-x,-y) = inverted both axes.
                -- FIXED: raw delta, yaw applied +x right, pitch -y up.
                fc_mouseDelta = Vector2.new(input.Delta.x, input.Delta.y);
                return Enum.ContextActionResult.Pass;
            end, false, Enum.ContextActionPriority.High.Value, Enum.UserInputType.MouseMovement);
            ContextActionService:BindActionAtPriority("DesyncMouseWheel", function(_, _, input)
                fc_wheel = -input.Position.z;
                return Enum.ContextActionResult.Pass;
            end, false, Enum.ContextActionPriority.High.Value, Enum.UserInputType.MouseWheel);
        end;
        local function fc_stopCapture()
            fc_navSpeed = 1;
            fc_zero(fc_keyboard);
            fc_mouseDelta = Vector2.new();
            fc_wheel = 0;
            for _, a in ipairs({ "DesyncKeyboard", "DesyncShift", "DesyncMousePan", "DesyncMouseWheel", "FreecamKeyboard", "FreecamMousePan", "FreecamMouseWheel", "FreecamGamepadButton", "FreecamGamepadTrigger", "FreecamGamepadThumbstick" }) do
                pcall(function() ContextActionService:UnbindAction(a) end);
            end;
        end;
        local fc_saved = nil;
        -- FIXED-KEYBIND-GATE: keybind alone must never drive the cam. master
        -- toggle owns state, keybind only fires when master is already ON.
        -- (old callback ran desync_apply(v) on key state alone = cam moved
        -- with toggle OFF.) FIXED: gate on keybind_desync_enable.
        local desync_keyOn = false;
        local freecam_apply;
        local function desync_apply(on)
            FC.enable = (on == true);
            if on then
                local cf = camera.CFrame;
                local rx, ry = cf:ToEulerAnglesYXZ();
                cameraRot = Vector2.new(rx, wrapYaw(ry));
                cameraPos = cf.p;
                smPos = cf.p;
                smRot = Vector2.new(rx, ry);
                cameraFov = 70;
                pcall(function() cameraFov = camera.FieldOfView end);
                fc_mouseDelta = Vector2.new();
                fc_wheel = 0;
                pcall(function()
                    local ch = local_player.Character;
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid");
                    local root = ch and ch:FindFirstChild("HumanoidRootPart");
                    if hum and not fc_saved then
                        fc_saved = { ws = hum.WalkSpeed, jp = hum.JumpPower, ar = hum.AutoRotate };
                        hum.WalkSpeed = 0;
                        hum.JumpPower = 0;
                        hum.AutoRotate = false;
                        hum.PlatformStand = true;
                    end;
                    -- FIXED-BODY-MOVES: PlatformStand alone still lets velocity /
                    -- game forces drag the body while cam flies = you walk off.
                    -- FIXED: anchor root + zero velocity on enable, hold per-frame.
                    if root then
                        fc_saved.root = root;
                        fc_saved.rootCF = root.CFrame;
                        root.Anchored = true;
                        pcall(function()
                            root.AssemblyLinearVelocity = Vector3.zero;
                            root.AssemblyAngularVelocity = Vector3.zero;
                        end);
                    end;
                end);
                pcall(function() camera.CameraType = Enum.CameraType.Scriptable end);
                if not FC._bound then
                    FC._bound = true;
                    run_service:BindToRenderStep("Desync", Enum.RenderPriority.Camera.Value, function(dt)
                        if not FC.enable then return end;
                        -- FIXED-BUGGED-LOOK: camera fought game every frame (Custom
                        -- cam + HumanoidRootPart spring-back), Euler YXZ vs FromOrientation
                        -- mismatch = roll drift, smoothing lerped position but snapped
                        -- rotation = judder. FIXED: Scriptable lock verified per-frame,
                        -- single YXZ order everywhere, wrap-safe slerp both axes.
                        pcall(function()
                            if camera.CameraType ~= Enum.CameraType.Scriptable then
                                camera.CameraType = Enum.CameraType.Scriptable;
                            end;
                        end);
                        -- FIXED-BODY-MOVES: re-pin body every frame. game pushes
                        -- (knockback, slide, dash) unanchor or shove; hold wins.
                        pcall(function()
                            local r = fc_saved and fc_saved.root;
                            if r and r.Parent then
                                if not r.Anchored then r.Anchored = true end;
                                r.AssemblyLinearVelocity = Vector3.zero;
                                r.AssemblyAngularVelocity = Vector3.zero;
                            end;
                        end);
                        dt = math.clamp(dt, 0.0001, 0.05);
                        local vel = fc_vel(dt);
                        local pan = fc_pan(dt);
                        local fov = fc_fov(dt);
                        local zoomFactor = sqrt(tan(rad(70 / 2)) / tan(rad(cameraFov / 2)));
                        cameraFov = clamp(cameraFov + fov * FOV_GAIN * (dt / zoomFactor), 1, 120);
                        -- FIXED: mouse right (+x) = yaw right (negative Y rotation),
                        -- mouse down (+y) = pitch down. matches every FPS ever.
                        -- sens + single dt scale (was double-scaled = crawl).
                        local sens = FC.sens or 1;
                        local yawDelta = -pan.x * 0.75 * sens * (dt * 60 / zoomFactor) * 0.016;
                        local pitchDelta = -pan.y * 1 * sens * (dt * 60 / zoomFactor) * 0.016;
                        cameraRot = Vector2.new(clamp(cameraRot.x + pitchDelta, -PITCH_LIMIT, PITCH_LIMIT), wrapYaw(cameraRot.y + yawDelta));
                        -- FIXED: camera-space forward = -Z, so negate Z (W+ = forward).
                        local move = Vector3.new(vel.X, vel.Y, -vel.Z) * NAV_GAIN * dt;
                        local targetCF = CFrame.new(cameraPos) * CFrame.fromOrientation(cameraRot.x, cameraRot.y, 0) * CFrame.new(move);
                        cameraPos = targetCF.p;
                        -- steady cam: wrap-safe lerp, no spring overshoot.
                        local k = math.clamp(dt * SMOOTH, 0, 1);
                        smPos = smPos:Lerp(cameraPos, k);
                        smRot = Vector2.new(
                            smRot.x + (cameraRot.x - smRot.x) * k,
                            smRot.y + wrapYaw(cameraRot.y - smRot.y) * k
                        );
                        local ccf = CFrame.new(smPos) * CFrame.fromOrientation(smRot.x, smRot.y, 0);
                        camera.CFrame = ccf;
                        camera.Focus = ccf;
                        camera.FieldOfView = cameraFov;
                    end);
                    Library:OnUnload(function()
                        pcall(function() run_service:UnbindFromRenderStep("Desync") end);
                        pcall(function() run_service:UnbindFromRenderStep("Freecam") end);
                    end);
                end;
                fc_startCapture();
            else
                fc_stopCapture();
                pcall(function() run_service:UnbindFromRenderStep("Desync") end);
                pcall(function() run_service:UnbindFromRenderStep("Freecam") end);
                FC._bound = false;
                pcall(function()
                    camera.CameraType = Enum.CameraType.Custom;
                    local ch = local_player.Character;
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid");
                    if hum then camera.CameraSubject = hum end;
                end);
                pcall(function()
                    local ch = local_player.Character;
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid");
                    if hum then
                        hum.PlatformStand = false;
                        if fc_saved then
                            hum.WalkSpeed = fc_saved.ws;
                            hum.JumpPower = fc_saved.jp;
                            hum.AutoRotate = fc_saved.ar;
                        end;
                    end;
                    -- FIXED-BODY-MOVES: release pin, drop back exactly where
                    -- you enabled (no drift, no fling).
                    if fc_saved and fc_saved.root and fc_saved.root.Parent then
                        fc_saved.root.Anchored = false;
                        fc_saved.root.AssemblyLinearVelocity = Vector3.zero;
                        fc_saved.root.AssemblyAngularVelocity = Vector3.zero;
                        if fc_saved.rootCF then fc_saved.rootCF = nil end;
                    end;
                    fc_saved = nil;
                end);
            end;
        end;
        -- backwards compat: old freecam_apply name still works.
        freecam_apply = desync_apply;

        desync_tab:AddToggle('desync_enable', {
            Text = 'enable',
            Default = false,
            Callback = function(v)
                keybind_desync_enable = (v == true);
                if v then
                    desync_keyOn = false;
                    desync_apply(true);
                else
                    desync_keyOn = false;
                    desync_apply(false);
                end;
            end;
        }):AddKeyPicker('desync_keybind', {
            Default = 'None',
            Text = 'desync',
            NoUI = false,
            Callback = function(v)
                -- FIXED-KEYBIND-GATE: key only toggles WHILE master is ON.
                -- master OFF + key press = ignored (was: cam moved anyway).
                if not keybind_desync_enable then
                    if desync_keyOn then desync_keyOn = false end;
                    if FC.enable then desync_apply(false) end;
                    return;
                end;
                desync_keyOn = (v == true);
                desync_apply(desync_keyOn);
            end;
        });

        desync_tab:AddSlider('desync_speed', {
            Text = 'speed',
            Default = 50,
            Min = 10,
            Max = 200,
            Rounding = 0,
            Callback = function(v)
                FC.speed = v;
            end;
        });

        desync_tab:AddSlider('desync_sens', {
            Text = 'look sensitivity',
            Default = 1,
            Min = 0.1,
            Max = 3,
            Rounding = 2,
            Callback = function(v)
                FC.sens = v;
            end;
        });

        desync_tab:AddSlider('desync_smooth', {
            Text = 'smoothing (higher = tighter)',
            Default = 12,
            Min = 4,
            Max = 30,
            Rounding = 0,
            Callback = function(v)
                SMOOTH = v;
            end;
        });

        desync_tab:AddLabel('WASD move, E up / Q down, Shift fast, wheel zooms. bind a key above.', true);
    end;
end)();

do
local v555 = Tabs.misc_tab:AddRightGroupbox('cosmetics (moved)');
local unlockAllInitialized = false;
getgenv().elisium_cosmetic_state = getgenv().elisium_cosmetic_state or {
    gui = nil,
    frame = nil,
    inner = nil,
    panel = nil,
    selectedWeapon = nil,
    selectedType = "Skin",
    anyModel = false,
    dismissedThisSession = true,
};

v555:AddToggle("AnySkinMode", {
    Text = "any skin",
    Default = getgenv().elisium_cosmetic_state.anyModel or false,
    Callback = function(val)
        getgenv().elisium_cosmetic_state.anyModel = val and true or false;
        local st = getgenv().elisium_cosmetic_state;
        if st and st.refreshCosmetics then
            st.refreshCosmetics();
        end;
    end
});

local function syncCosmeticChangerVisibility()
    local st = getgenv().elisium_cosmetic_state;
    if not st or not st.frame or not st.frame.Parent then return end;
    if not unlockAllInitialized then return end;
    local menuOpen = false;
    pcall(function()
        menuOpen = Library.MenuOpen;
    end);
    if not menuOpen then
        st.frame.Visible = false;
        return
    end;
    st.frame.Visible = not st.dismissedThisSession;
end;
getgenv().syncCosmeticChangerVisibility = syncCosmeticChangerVisibility;

local function openCosmeticChanger(showUi)
    if showUi == nil then showUi = true end;
    if unlockAllInitialized then
        if showUi then
            local st = getgenv().elisium_cosmetic_state;
            if st then
                st.dismissedThisSession = false;
            end;
            syncCosmeticChangerVisibility();
        end;
        return
    end;
    unlockAllInitialized = true;
    local replicated_storage = game:GetService("ReplicatedStorage");
    local local_player = game:GetService("Players").LocalPlayer;
    local enum_library = require(replicated_storage.Modules.EnumLibrary);
    local cosmetic_lib = require(replicated_storage.Modules.CosmeticLibrary);
    local data_ctrl = require(local_player.PlayerScripts.Controllers.PlayerDataController);
    local rep_class = require(replicated_storage.Modules.ReplicatedClass);
    local item_library = require(replicated_storage.Modules.ItemLibrary);
    local equip_remote = replicated_storage.Remotes.Data.EquipCosmetic;
    local fav_remote = replicated_storage.Remotes.Data.FavoriteCosmetic;
    local equipped = {};
    local favorites = {};
    local current_weapon = nil;
    local viewing_profile = nil;
    local enabled = true;
    local unlockAllActive = false;
    local cosmeticNorm = function(s)
        if type(s) ~= "string" then return ""; end;
        return s:lower():gsub("[%s%-%_]+", "");
    end;
    local resolveEquippedWeaponName = function(weaponName, weapon_data)
        if not weaponName then return nil; end;
        if equipped[weaponName] then
            return weaponName;
        end;
        if weapon_data then
            for _, key in eli_ipairs({weapon_data.Name, weapon_data.Weapon, weapon_data.WeaponName}) do
                if key and equipped[key] then
                    return key;
                end;
            end;
        end;
        local norm = cosmeticNorm(weaponName);
        if norm ~= "" then
            for key in eli_pairs(equipped) do
                if cosmeticNorm(key) == norm then
                    return key;
                end;
            end;
            -- PLACEABLE-FIX: placed world models rename themselves
            -- ("SubspaceTripmineHitbox", "JumpPad_Deployed"...). Substring
            -- either way still counts as yours (min 5 chars vs junk).
            for key in eli_pairs(equipped) do
                local kn = cosmeticNorm(key);
                if #kn >= 5 and #norm >= 5
                    and (string.find(norm, kn, 1, true) or string.find(kn, norm, 1, true)) then
                    return key;
                end;
            end;
        end;
        return nil;
    end;
    local clone_cosmetic = function(cosmetic_name, cosmetic_type, opts)
        if not cosmetic_name or cosmetic_name == "" or cosmetic_name == "None" then return nil end;
        local resolved = cosmetic_name;
        pcall(function()
            if cosmetic_lib.RENAMED_COSMETICS and cosmetic_lib.RENAMED_COSMETICS[cosmetic_name] then
                resolved = cosmetic_lib.RENAMED_COSMETICS[cosmetic_name];
            end;
        end);
        local base = cosmetic_lib.Cosmetics[resolved] or cosmetic_lib.Cosmetics[cosmetic_name];
        if not base then
            -- case-insensitive fallback for skins that only match by lower name
            local want = string.lower(tostring(resolved));
            for k, v in pairs(cosmetic_lib.Cosmetics or {}) do
                if type(k) == "string" and string.lower(k) == want and type(v) == "table" then
                    base = v; resolved = k; break;
                end;
            end;
        end;
        if not base then return nil end;
        local new_data = table.clone(base);
        new_data.Name = resolved;
        new_data.Type = new_data.Type or cosmetic_type;
        new_data.Seed = new_data.Seed or math.random(1, 1000000);
        local ok, enum_val = pcall(enum_library.ToEnum, enum_library, resolved);
        if ok and enum_val then
            new_data.Enum = enum_val;
            new_data.ObjectID = new_data.ObjectID or enum_val;
        end;
        if opts and opts.inverted ~= nil then
            new_data.Inverted = opts.inverted;
        end;
        return new_data;
    end;
    local SKINS_FOLDER = "elisium_skins";
    local SKINS_FILE = SKINS_FOLDER .. "/skins.json";
    local http_service = game:GetService("HttpService");
    local has_fs = isfolder and makefolder and writefile and readfile and isfile;
    local function ensureSkinsFolder()
        if not has_fs then return false end;
        local ok = pcall(function()
            if not isfolder(SKINS_FOLDER) then makefolder(SKINS_FOLDER) end;
        end);
        return ok;
    end;
    local save_pending = false;
    local function saveSkins()
        -- CONFIG-ONLY SKINS: no separate skins.json writes. skins persist
        -- only inside the weapon-tab config (SaveManager Save/Load above).
        -- equip still applies live (viewmodel inject + replicate), just never
        -- touches disk here.
        return;
    end;
    local function loadSkins()
        if not has_fs then return end;
        if not isfile(SKINS_FILE) then return end;
        local ok, content = pcall(readfile, SKINS_FILE);
        if not ok or not content or content == "" then return end;
        local ok2, data = pcall(function() return http_service:JSONDecode(content) end);
        if not ok2 or type(data) ~= "table" then return end;
        if type(data.equipped) == "table" then
            for weapon, types in eli_pairs(data.equipped) do
                if type(types) == "table" then
                    equipped[weapon] = equipped[weapon] or {};
                    for ctype, ref in eli_pairs(types) do
                        if type(ref) == "table" and ref.name then
                            local cdata = clone_cosmetic(ref.name, ctype, { inverted = ref.inverted });
                            if cdata then
                                equipped[weapon][ctype] = cdata;
                            end;
                        end;
                    end;
                    if not next(equipped[weapon]) then
                        equipped[weapon] = nil;
                    end;
                end;
            end;
        end;
        if type(data.favorites) == "table" then
            for weapon, favs in eli_pairs(data.favorites) do
                if type(favs) == "table" then
                    favorites[weapon] = favorites[weapon] or {};
                    for cname, isFav in eli_pairs(favs) do
                        favorites[weapon][cname] = isFav and true or nil;
                    end;
                end;
            end;
        end;
    end;
    local old = data_ctrl.Get; data_ctrl.Get = function(self, data_key)
        local original = old(self, data_key);
        if not enabled then return original end;
        if data_key == "CosmeticInventory" then
            if not unlockAllActive then return original; end;
            -- KICIA UNLOCK PORT (native shape): Skin/Emote -> true,
            -- Wrap/Charm/Finisher -> map of every item name. old flat-true
            -- broke per-weapon wrap/charm resolution. GUI + backend kept.
            if not getgenv()._KiciaNativeInv then
                local inv2 = {};
                local allItems = {};
                pcall(function()
                    for iname in pairs(item_lib.Items) do
                        if type(iname) == "string" and iname ~= "" and iname ~= "MISSING_WEAPON" then
                            allItems[iname] = true;
                        end;
                    end;
                end);
                for cname, cdata in pairs(cosmetic_lib.Cosmetics or {}) do
                    local ctype = type(cdata) == "table" and cdata.Type or nil;
                    if type(cname) == "string" and not cname:find("MISSING_") then
                        if ctype == "Skin" or ctype == "Emote" then
                            inv2[cname] = true;
                        elseif ctype == "Wrap" or ctype == "Charm" or ctype == "Finisher" then
                            inv2[cname] = allItems;
                        end;
                    end;
                end;
                getgenv()._KiciaNativeInv = inv2;
            end;
            local inv = original and table.clone(original) or {};
            for k, v in pairs(getgenv()._KiciaNativeInv) do
                if inv[k] == nil then inv[k] = v end;
            end;
            return inv;
        end;
        if data_key == "FavoritedCosmetics" then
            local fav = original and table.clone(original) or {};
            for weapon_name, weapon_favs in eli_pairs(favorites) do
                fav[weapon_name] = fav[weapon_name] or {};
                for cosmetic_name, is_fav in eli_pairs(weapon_favs) do
                    fav[weapon_name][cosmetic_name] = is_fav;
                end;
            end;
            return fav;
        end;
        return original;
    end;
    getgenv()._EliWepCache2 = getgenv()._EliWepCache2 or {};
    getgenv().elisium_bust_wepcache = function()
        getgenv()._EliWepCache2 = {};
    end;
    local old = data_ctrl.GetWeaponData; data_ctrl.GetWeaponData = function(self, weapon_name)
        -- hardened: ANY failure falls through to the game's own data. A throw here
        -- is what froze the range/duels pickers (every card queries this).
        -- LOCAL-ONLY: when someone else's profile is open, serve vanilla data so
        -- your fakes never paint onto their cards. Your own view keeps the fakes.
        -- LAGFIX: pickers query this per card per frame; table.clone + resolve
        -- per call was a hot allocator. 0.3s cache, busted on every equip.
        if type(weapon_name) == "string" then
            local ce = getgenv()._EliWepCache2[weapon_name];
            if ce and tick() - ce.t < 0.3 then return ce.v end;
        end;
        local ok, out = pcall(function()
            local weapon_data = old(self, weapon_name);
            if type(weapon_data) ~= "table" then return weapon_data end;
            local final = table.clone(weapon_data);
            final.Name = weapon_name;
            if enabled then
                local viewingOther = viewing_profile ~= nil and viewing_profile ~= local_player;
                pcall(function()
                    if getgenv().IsViewingOther and getgenv().IsViewingOther() then
                        viewingOther = true;
                    end;
                end);
                if viewingOther then return final end;
                local equipped_name = resolveEquippedWeaponName(weapon_name, weapon_data);
                if equipped_name and equipped[equipped_name] then
                    for cosmetic_type, cosmetic_data in eli_pairs(equipped[equipped_name]) do
                        final[cosmetic_type] = cosmetic_data;
                    end;
                end;
            end;
            return final;
        end);
        if ok then
            if type(weapon_name) == "string" and type(out) == "table" then
                getgenv()._EliWepCache2[weapon_name] = { v = out, t = tick() };
            end;
            return out
        end;
        if (getgenv()._EliWepHookWarn or 0) + 10 < tick() then
            getgenv()._EliWepHookWarn = tick();
            warn("[elisium] GetWeaponData passthrough for " .. tostring(weapon_name));
        end;
        local ok2, fb = pcall(function() return old(self, weapon_name) end);
        if ok2 then return fb end;
        return nil;
    end;
    local client_item_module = require(local_player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem);
    if client_item_module and client_item_module._CreateViewModel then
        local old = client_item_module._CreateViewModel; client_item_module._CreateViewModel = function(self, vm_ref)
            local weapon_name = self.Name;
            local weapon_owner = self.ClientFighter and self.ClientFighter.Player;
            current_weapon = (weapon_owner == local_player) and weapon_name or nil;
            -- UTIL-FIX: resolve via ItemName too (Jump Pad / War Horn / Satchel / Warpstone use it)
            local equipped_name = resolveEquippedWeaponName(weapon_name);
            if not equipped_name and self.Info then
                pcall(function()
                    local alt = self.Info.ItemName or self.Info.Weapon or self.Info.WeaponName;
                    if alt then equipped_name = resolveEquippedWeaponName(alt); end;
                end);
            end;
            local okVm, result = pcall(function()
                if enabled and weapon_owner == local_player and equipped_name and equipped[equipped_name] and equipped[equipped_name].Skin and vm_ref then
                    local data_key = self:ToEnum("Data");
                    local skin_key = self:ToEnum("Skin");
                    local name_key = self:ToEnum("Name");
                    if vm_ref[data_key] then
                        vm_ref[data_key][skin_key] = equipped[equipped_name].Skin;
                        vm_ref[data_key][name_key] = equipped[equipped_name].Skin.Name;
                    elseif vm_ref.Data then
                        vm_ref.Data.Skin = equipped[equipped_name].Skin;
                        vm_ref.Data.Name = equipped[equipped_name].Skin.Name;
                    end;
                end;
                return old(self, vm_ref);
            end);
            current_weapon = nil;
            if okVm then return result end;
            return old(self, vm_ref);
        end;
    end;
    local vm_module_path = local_player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel");
    if vm_module_path then
        local client_vm = require(vm_module_path);
        if client_vm.GetWrap then
            local old = client_vm.GetWrap; client_vm.GetWrap = function(self)
                local weapon_name = self.ClientItem and self.ClientItem.Name;
                local weapon_owner = self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player;
                local equipped_name = resolveEquippedWeaponName(weapon_name);
                if enabled and weapon_name and weapon_owner == local_player and equipped_name and equipped[equipped_name] and equipped[equipped_name].Wrap then
                    return equipped[equipped_name].Wrap;
                end;
                return old(self);
            end;
        end;
        local old = client_vm.new; client_vm.new = function(rep_data, client_item)
            local weapon_owner = client_item.ClientFighter and client_item.ClientFighter.Player;
            local weapon_name = current_weapon or client_item.Name;
            local equipped_name = resolveEquippedWeaponName(weapon_name);
            if enabled and weapon_owner == local_player and equipped_name and equipped[equipped_name] then
                local data_key = rep_class:ToEnum("Data");
                rep_data[data_key] = rep_data[data_key] or {};
                local eq = equipped[equipped_name];
                if eq.Skin then rep_data[data_key][rep_class:ToEnum("Skin")] = eq.Skin end;
                if eq.Wrap then rep_data[data_key][rep_class:ToEnum("Wrap")] = eq.Wrap end;
                if eq.Charm then rep_data[data_key][rep_class:ToEnum("Charm")] = eq.Charm end;
                pcall(function() if eq.Finisher then rep_data[data_key][rep_class:ToEnum("Finisher")] = eq.Finisher end end);
            end;
            local vm_obj = old(rep_data, client_item);
            if enabled and weapon_owner == local_player and equipped_name and equipped[equipped_name] and equipped[equipped_name].Wrap and vm_obj._UpdateWrap then
                vm_obj:_UpdateWrap();
                task.delay(0.1, function()
                    if not vm_obj._destroyed then vm_obj:_UpdateWrap() end;
                end);
            end;
            -- UTIL-FIX: force Skin on placed utilities (real MCP placeables read Skin late, Wrap stuck alone)
            if enabled and weapon_owner == local_player and equipped_name and equipped[equipped_name] and equipped[equipped_name].Skin then
                pcall(function()
                    local sk = equipped[equipped_name].Skin;
                    if vm_obj.SetSkin then vm_obj:SetSkin(sk); end;
                    if vm_obj._UpdateSkin then vm_obj:_UpdateSkin(); end;
                    if vm_obj.Model and sk.MeshId then -- mesh swap fallback for placeables
                        for _, d in ipairs(vm_obj.Model:GetDescendants()) do
                            if d:IsA("SpecialMesh") then d.MeshId = sk.MeshId; end;
                            if d:IsA("TextureID") then end;
                        end;
                    end;
                end);
                task.delay(0.15, function()
                    pcall(function()
                        if not vm_obj._destroyed and vm_obj._UpdateSkin then vm_obj:_UpdateSkin(); end;
                    end);
                end);
            end;
            return vm_obj;
        end;
    end;
    -- PLACEABLE-FIX: placed utilities (Jump Pad pads, Subspace Tripmine boxes,
    -- Satchels) are built server-side from REAL loadout data, so the viewmodel
    -- inject above never touches them (that is why only Warp showed: the warp
    -- disc is client-built from the stamped viewmodel, pads/mines are not).
    -- This stamper re-applies YOUR equipped Skin meshes onto placed world
    -- models, client-side only. Owner-attributed enemy models are skipped.
    local placeStamped = setmetatable({}, { __mode = "k" });
    local placeSchemaWarned = {};
    local placeKeys = { "jumppad", "tripmine", "subspace", "satchel", "warp", "deploy", "trap", "turret", "sensor", "mine", "pad" };
    -- generic placeable words: class fallback only fires on these, never on random models
    local placeGenericWords = { "pad", "mine", "trip", "satchel", "warp", "deploy", "placed", "trap", "turret", "sensor", "mine", "tnt", "bomb" };
    local function placeModelKey(model)
        local nm = "";
        pcall(function() nm = tostring(model.Name or "") end);
        local norm = cosmeticNorm(nm);
        for _, k in eli_ipairs(placeKeys) do
            if string.find(norm, k, 1, true) then return k end;
        end;
        return nil;
    end;
    local function placeFindWeapon(pkey, model)
        for key in eli_pairs(equipped) do
            if string.find(cosmeticNorm(key), pkey, 1, true) then return key end;
        end;
        if pkey == "jumppad" and equipped["Jump Pad"] then return "Jump Pad" end;
        if pkey == "tripmine" or pkey == "subspace" then
            if equipped["Subspace Tripmine"] then return "Subspace Tripmine" end;
        end;
        if pkey == "satchel" and equipped["Satchel"] then return "Satchel" end;
        -- no typing: any equipped Melee/Utility skin auto-matches a placed
        -- model whose name looks placeable (pad/mine/trap/...). keeps others.
        local norm2 = "";
        pcall(function() norm2 = cosmeticNorm(tostring(model and model.Name or "")) end);
        local looksPlaced = false;
        for _, w in eli_ipairs(placeGenericWords) do
            if string.find(norm2, w, 1, true) then looksPlaced = true break end;
        end;
        if looksPlaced then
            for key in eli_pairs(equipped) do
                local cls = nil;
                pcall(function()
                    for _, it in pairs(item_lib.Items) do
                        if it.Name == key then cls = it.Class break end;
                    end;
                end);
                if cls == "Melee" or cls == "Utility" then
                    local eq = equipped[key];
                    if eq and (eq.Skin or eq.Wrap) then return key end;
                end;
            end;
        end;
        return nil;
    end;
    local function placeForeign(model)
        local me1, me2 = "", "";
        pcall(function()
            me1 = string.lower(local_player.Name);
            me2 = string.lower(local_player.DisplayName or "");
        end);
        local foreign = false;
        pcall(function()
            local cur, guard = model, 0;
            while cur and guard < 4 and not foreign do
                guard = guard + 1;
                local attrs = cur:GetAttributes();
                for _, ak in eli_ipairs({ "Owner", "Placer", "Creator", "OwnerUserId", "Player", "UserId" }) do
                    local av = attrs[ak];
                    if av ~= nil then
                        local s = string.lower(tostring(av));
                        if s ~= "" and s ~= me1 and s ~= me2 and s ~= "0" then foreign = true break end;
                    end;
                end;
                if not foreign then
                    for _, ch in eli_ipairs(cur:GetChildren()) do
                        local cn = string.lower(ch.Name);
                        if string.find(cn, "owner", 1, true) or string.find(cn, "placer", 1, true)
                            or string.find(cn, "creator", 1, true) then
                            local vv = ch:IsA("ObjectValue") and ch.Value or ch:IsA("StringValue") and ch.Value or nil;
                            if vv then
                                local s = type(vv) == "string" and string.lower(vv)
                                    or (typeof(vv) == "Instance" and vv:IsA("Player") and string.lower(vv.Name) or "");
                                if s ~= "" and s ~= me1 and s ~= me2 then foreign = true break end;
                            end;
                        end;
                    end;
                end;
                cur = cur.Parent;
            end;
        end);
        return foreign;
    end;
    local function placeStamp(model)
        if not enabled or not model or not model.Parent then return end;
        if placeStamped[model] then return end;
        placeStamped[model] = true;
        local pkey = placeModelKey(model);
        if not pkey then return end;
        local wkey = placeFindWeapon(pkey, model);
        if not wkey then return end;
        local sk = equipped[wkey] and equipped[wkey].Skin;
        local wp = equipped[wkey] and equipped[wkey].Wrap;
        if not (sk or wp) then return end;
        if placeForeign(model) then return end;
        if not placeSchemaWarned[wkey] then
            placeSchemaWarned[wkey] = true;
            local fields = {};
            pcall(function()
                for k, v in pairs(sk) do
                    if #fields > 24 then break end;
                    fields[#fields + 1] = tostring(k) .. "=" .. typeof(v);
                end;
            end);
            warn("[elisium] placeable skin schema " .. tostring(wkey) .. ": " .. table.concat(fields, ", "));
        end;
        local meshId = sk and (sk.MeshId or sk.MeshID or sk.Mesh or sk.MeshAsset);
        local texId = sk and (sk.TextureId or sk.TextureID or sk.Texture or sk.TextureAsset);
        -- wrap coat: equipped wrap texture rides along when the skin has none
        if (not texId or texId == "") and wp then
            texId = wp.TextureId or wp.TextureID or wp.Texture or wp.TextureAsset;
        end;
        -- KICIA COSMETIC SCRIPT PORT (placeable Wrap coat): theirs applies
        -- utility/placeable wraps as their OWN coat, not skin-fallback. resolve
        -- wrap art from WrapTextures assets (kicia's source), then coat every
        -- mesh/decals on the placed model. skin mesh pass above stays.
        local wrapTex = wp and (wp.TextureId or wp.TextureID or wp.Texture or wp.TextureAsset);
        if (not wrapTex or wrapTex == "") and wp and wp.Name then
            pcall(function()
                local ps2 = local_player.PlayerScripts;
                local assets2 = ps2 and ps2:FindFirstChild("Assets");
                local wt = assets2 and assets2:FindFirstChild("WrapTextures");
                local folder = wt and (wt:FindFirstChild(wp.Name) or wt:FindFirstChild(string.lower(wp.Name)));
                if folder then
                    for _, d in ipairs(folder:GetDescendants()) do
                        if d:IsA("Texture") and d.Texture ~= "" then wrapTex = d.Texture break end;
                    end;
                end;
            end);
        end;
        if wrapTex and wrapTex ~= "" then
            pcall(function()
                for _, d in eli_ipairs(model:GetDescendants()) do
                    if d:IsA("SpecialMesh") then
                        d.TextureId = wrapTex;
                    elseif d:IsA("MeshPart") then
                        d.TextureID = wrapTex;
                    elseif d:IsA("Decal") or d:IsA("Texture") then
                        d.Texture = wrapTex;
                    end;
                end;
            end);
        end;
        pcall(function()
            for _, d in eli_ipairs(model:GetDescendants()) do
                if d:IsA("SpecialMesh") then
                    if meshId and meshId ~= "" then d.MeshId = meshId end;
                    if texId and texId ~= "" then d.TextureId = texId end;
                elseif d:IsA("MeshPart") then
                    if meshId and meshId ~= "" then d.MeshId = meshId end;
                    if texId and texId ~= "" then d.TextureID = texId end;
                elseif (d:IsA("Decal") or d:IsA("Texture")) and texId and texId ~= "" then
                    d.Texture = texId;
                end;
            end;
        end);
        -- kicia pattern: clone the skin model onto the Hitbox, weld it down.
        -- visual only, original hitbox untouched. skips if already cloned.
        pcall(function()
            if not sk or not sk.Name then return end;
            if model:FindFirstChild("elisium_skin_clone", true) then return end;
            local anchor = model:FindFirstChild("Hitbox") or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart");
            if not anchor then return end;
            local ps = local_player.PlayerScripts;
            local assets = ps and ps:FindFirstChild("Assets");
            local skinModel = nil;
            if assets then
                local th = assets:FindFirstChild("Throwables");
                if th then
                    skinModel = th:FindFirstChild(sk.Name);
                    if not skinModel then
                        local want = string.lower(sk.Name);
                        for _, ch in ipairs(th:GetChildren()) do
                            if ch:IsA("Model") and string.lower(ch.Name) == want then skinModel = ch break end;
                        end;
                    end;
                end;
                if not skinModel then
                    local vm = assets:FindFirstChild("ViewModels");
                    if vm then
                        for _, case in ipairs(vm:GetChildren()) do
                            if case.Name ~= "Weapons" and not skinModel then
                                local direct = case:FindFirstChild(sk.Name);
                                if direct and direct:IsA("Model") then skinModel = direct end;
                            end;
                        end;
                    end;
                end;
                -- FIXED-PLACEABLE: placeable skins (JumpPad pads, Tripmine boxes,
                -- Satchel, War Horn) live in per-weapon Asset folders, NOT
                -- Throwables/ViewModels. deep-scan ALL of Assets for the skin
                -- model name (bounded 800, exact then case-insensitive).
                if not skinModel then
                    local want = string.lower(sk.Name);
                    local scanned = 0;
                    pcall(function()
                        for _, d in ipairs(assets:GetDescendants()) do
                            scanned += 1;
                            if scanned > 800 then break end;
                            if skinModel then break end;
                            if d:IsA("Model") and d.Name == sk.Name then
                                skinModel = d;
                            end;
                        end;
                        if not skinModel then
                            scanned = 0;
                            for _, d in ipairs(assets:GetDescendants()) do
                                scanned += 1;
                                if scanned > 800 then break end;
                                if skinModel then break end;
                                if d:IsA("Model") and string.lower(d.Name) == want then
                                    skinModel = d;
                                end;
                            end;
                        end;
                    end);
                end;
            end;
            if not skinModel then return end;
            local clone = skinModel:Clone();
            clone.Name = "elisium_skin_clone";
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("LocalScript") or d:IsA("Script") then
                    pcall(function() d:Destroy() end);
                end;
            end;
            clone:PivotTo(anchor.CFrame);
            clone.Parent = model;
            for _, p in ipairs(clone:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.Anchored = false;
                    p.CanCollide = false;
                    p.CanQuery = false;
                    local w = Instance.new("WeldConstraint");
                    w.Part0 = anchor;
                    w.Part1 = p;
                    w.Parent = p;
                end;
            end;
            -- FIXED-PLACEABLE: hide the DEFAULT model meshes so the skin clone
            -- shows instead of z-fighting under it. transparency only, never
            -- destroy (hitbox + touch stay live).
            pcall(function()
                for _, d in ipairs(model:GetChildren()) do
                    if d ~= clone and d:IsA("BasePart") and d ~= anchor then
                        d.Transparency = 1;
                    end;
                end;
                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("Texture") then
                        local par = d.Parent;
                        local insideClone = false;
                        pcall(function()
                            insideClone = par and (par == clone or par:IsDescendantOf(clone));
                        end);
                        if not insideClone then d.Transparency = 1 end;
                    end;
                end;
            end);
        end);
        -- placed models rebuild visuals late (server rebuilds 1-2s after
        -- place): stamp, then restamp x3 at 0.5/1.5/3s. each pass re-hides
        -- defaults + re-welds clone so late rebuilds can't shake it off.
        for _, dly in ipairs({ 0.5, 1.5, 3 }) do
            task.delay(dly, function()
                if not model.Parent then return end;
                placeStamped[model] = nil;
                placeStamp(model);
            end);
        end;
    end;
    local function placeTopModel(inst)
        local cur = inst;
        pcall(function()
            while cur and cur.Parent and cur.Parent ~= workspace do
                cur = cur.Parent;
            end;
        end);
        if cur and cur:IsA("Model") then return cur end;
        if inst and inst:IsA("Model") and inst.Parent == workspace then return inst end;
        return nil;
    end;
    getgenv().elisium_restamp_placeables = function()
        table.clear(placeStamped);
        pcall(function()
            for _, d in eli_ipairs(workspace:GetChildren()) do
                if d:IsA("Model") then placeStamp(d) end;
            end;
        end);
    end;
    -- placeable name logger: run elisium_debug_placeables(30) in real MCP,
    -- place your pad/mine, paste the console lines back for corrections.
    getgenv().elisium_debug_placeables = function(secs)
        secs = tonumber(secs) or 30;
        getgenv()._EliPlaceDbgUntil = tick() + secs;
        warn("[elisium] placeable watch ON for " .. tostring(secs) .. "s: place pad/mine/satchel now");
        if getgenv()._EliPlaceDbgConn then return end;
        getgenv()._EliPlaceDbgConn = workspace.DescendantAdded:Connect(function(d)
            if (getgenv()._EliPlaceDbgUntil or 0) < tick() then return end;
            pcall(function()
                local m = placeTopModel(d) or (d:IsA("BasePart") and d.Parent);
                if not m then return end;
                local nm = tostring(m.Name or "");
                local nl = string.lower(nm);
                if string.find(nl, "jump", 1, true) or string.find(nl, "pad", 1, true)
                    or string.find(nl, "mine", 1, true) or string.find(nl, "subspace", 1, true)
                    or string.find(nl, "satchel", 1, true) or string.find(nl, "trip", 1, true) then
                    local parts, meshes = 0, {};
                    for _, c in eli_ipairs(m:GetDescendants()) do
                        if c:IsA("BasePart") then parts = parts + 1 end;
                        if c:IsA("SpecialMesh") or c:IsA("MeshPart") then
                            local mid = c:IsA("MeshPart") and c.MeshId or c.MeshId;
                            meshes[#meshes + 1] = c.ClassName .. ":" .. tostring(mid or "?"):sub(1, 40);
                            if #meshes >= 4 then break end;
                        end;
                    end;
                    local attrs = {};
                    for ak, av in pairs(m:GetAttributes()) do
                        if #attrs > 6 then break end;
                        attrs[#attrs + 1] = tostring(ak) .. "=" .. tostring(av):sub(1, 24);
                    end;
                    warn("[elisium] PLACED class=" .. m.ClassName .. " name=" .. nm
                        .. " parent=" .. tostring(m.Parent and m.Parent.Name or "?")
                        .. " parts=" .. tostring(parts)
                        .. " meshes={" .. table.concat(meshes, " | ") .. "}"
                        .. " attrs={" .. table.concat(attrs, ", ") .. "}");
                end;
            end);
        end);
    end;
    task.spawn(function()
        task.wait(3);
        pcall(function() getgenv().elisium_restamp_placeables() end);
        if not getgenv()._EliPlaceConn then
            getgenv()._EliPlaceConn = workspace.DescendantAdded:Connect(function(d)
                pcall(function()
                    local m = placeTopModel(d);
                    if m then task.delay(0.4, function() placeStamp(m) end) end;
                end);
            end);
            trove:Add(getgenv()._EliPlaceConn);
        end;
        -- kicia pattern: tag-driven sweep. no typing, catches tagged
        -- placeables the name matcher misses (SubspaceTripmine et al).
        pcall(function()
            local CS = game:GetService("CollectionService");
            for _, tag in eli_ipairs({ "SubspaceTripmine", "Tripmine", "JumpPad", "Satchel", "PlacedUtility" }) do
                pcall(function()
                    trove:Add(CS:GetInstanceAddedSignal(tag):Connect(function(inst)
                        pcall(function()
                            local m = placeTopModel(inst);
                            if m then
                                task.delay(0.4, function() placeStamp(m) end);
                            elseif inst:IsA("BasePart") and inst.Parent then
                                local m2 = placeTopModel(inst.Parent);
                                task.delay(0.4, function() placeStamp(m2 or inst.Parent) end);
                            end;
                        end);
                    end));
                    for _, v in eli_ipairs(CS:GetTagged(tag)) do
                        local m = placeTopModel(v);
                        if m then task.spawn(placeStamp, m) end;
                    end;
                end);
            end;
        end);
    end);
    local function resolveEquippedSkinImage(selfObj, weapon_data, high_res)
        if not weapon_data or not enabled then return nil end;
        local weapon_name = weapon_data.Name;
        local equipped_name = resolveEquippedWeaponName(weapon_name, weapon_data);
        if not (weapon_name and equipped_name and equipped[equipped_name] and equipped[equipped_name].Skin) then
            return nil;
        end;
        local skinName = equipped[equipped_name].Skin.Name;
        if not skinName then return nil end;
        -- only ever force OUR skins on OUR OWN profile; other players keep theirs
        local selfView = (viewing_profile == nil) or (viewing_profile == local_player);
        local should_show = (weapon_data.Skin and weapon_data.Skin == equipped[equipped_name].Skin);
        if selfView then
            should_show = should_show
                or (weapon_data.Weapon and weapon_data.Weapon == equipped_name)
                or (weapon_data.WeaponName and weapon_data.WeaponName == equipped_name)
                or (cosmeticNorm(weapon_data.Name) == cosmeticNorm(equipped_name));
        end;
        if not should_show then return nil end;
        local viewModels = selfObj and selfObj.ViewModels;
        local skin_info = viewModels and viewModels[skinName];
        if not skin_info then return nil end;
        return skin_info[high_res and "ImageHighResolution" or "Image"] or skin_info.Image;
    end;
    local old = item_library.GetViewModelImageFromWeaponData; item_library.GetViewModelImageFromWeaponData = function(self, weapon_data, high_res)
        local forced = resolveEquippedSkinImage(self, weapon_data, high_res);
        if forced then return forced end;
        return old(self, weapon_data, high_res);
    end;
    if item_library.GetImageFromWeaponData then
        local oldImg = item_library.GetImageFromWeaponData;
        item_library.GetImageFromWeaponData = function(self, weapon_data, high_res)
            local forced = resolveEquippedSkinImage(self, weapon_data, high_res);
            if forced then return forced end;
            return oldImg(self, weapon_data, high_res);
        end;
    end;
    if item_library.GetWeaponImageFromWeaponData then
        local oldWeaponImg = item_library.GetWeaponImageFromWeaponData;
        item_library.GetWeaponImageFromWeaponData = function(self, weapon_data, high_res)
            local forced = resolveEquippedSkinImage(self, weapon_data, high_res);
            if forced then return forced end;
            return oldWeaponImg(self, weapon_data, high_res);
        end;
    end;
    local view_profile = require(local_player.PlayerScripts.Modules.Pages.ViewProfile);
    if view_profile and view_profile.Fetch then
        local old = view_profile.Fetch; view_profile.Fetch = function(self, target_player)
            viewing_profile = target_player;
            return old(self, target_player);
        end;
        -- stale guard reset: once the profile UI is gone we are back on our own
        -- view, so clear the var (otherwise your own profile would lose fakes).
        task.spawn(function()
            while task.wait(1) do
                if viewing_profile ~= nil and viewing_profile ~= local_player then
                    local stillOpen = false;
                    pcall(function()
                        local pg = local_player:FindFirstChildOfClass("PlayerGui");
                        local mg = pg and pg:FindFirstChild("MainGui");
                        if mg then
                            for _, d in eli_ipairs(mg:GetDescendants()) do
                                if d.Name == "ViewProfile" and d:IsA("GuiObject") then
                                    stillOpen = true;
                                    break;
                                end;
                            end;
                        end;
                    end);
                    if not stillOpen then viewing_profile = nil end;
                end;
            end;
        end);
    end;
    loadSkins();
    data_ctrl.CurrentData:Replicate("CosmeticInventory");
