getgenv().elisium_toggle_menu = function(state)
    local want = state;
    if type(want) ~= "boolean" then
        want = true;
        pcall(function()
            local core = game:GetService("CoreGui");
            for _, s in ipairs(core:GetChildren()) do
                if s.Name == "Window" then
                    local c = s:FindFirstChild("Canvas", true);
                    if c then want = not (c.Visible == true) break end;
                end;
            end;
        end);
    end;
    pcall(function() Library:ToggleMenu(want) end);
    pcall(function()
        local core = game:GetService("CoreGui");
        for _, s in ipairs(core:GetChildren()) do
            if s.Name == "Window" then
                for _, d in ipairs(s:GetDescendants()) do
                    if d.Name == "Canvas" then pcall(function() d.Visible = want end) end;
                end;
            end;
        end;
    end);
    return want;
end;
