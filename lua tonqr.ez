do
    local kill_base = nil;
    local kill_feed = nil;
    local function killSoundPlay()
        local cfg = ELI.kill_sound;
        if not cfg.enable then return end;
        local id = cfg.selected and hitsound_dir[cfg.selected];
        if not id or id == "" then return end;
        if type(id) == "string" and not id:find("rbxassetid://", 1, true) and id:match("^%d+$") then
            id = "rbxassetid://" .. id;
        end;
        pcall(function()
            local s = Instance.new("Sound");
            s.Name = "elisium_kill";
            s.SoundId = id;
            s.Volume = math.clamp(tonumber(cfg.volume) or 3, 0, 5);
            s.PlaybackSpeed = math.clamp(tonumber(cfg.pitch) or 1, 0.5, 1.5);
            s.Parent = game:GetService("SoundService");
            s:Play();
            task.delay(3, function() pcall(function() s:Destroy() end) end);
        end);
    end;
    local function killFeedCount()
        if not kill_feed or not kill_feed.Parent then
            kill_feed = nil;
            pcall(function()
                local mg = local_player.PlayerGui:FindFirstChild("MainGui");
                kill_feed = mg and mg:FindFirstChild("EliminationFeed", true);
            end);
        end;
        if not kill_feed then return nil end;
        local names = {
            local_player.Name,
            local_player.DisplayName,
        };
        pcall(function()
            local r = ELI and ELI.rivspoof;
            if r then
                if r.SettingsDisplay and r.SettingsDisplay ~= "" then table.insert(names, r.SettingsDisplay) end;
                if r.SettingsUser and r.SettingsUser ~= "" then
                    table.insert(names, r.SettingsUser);
                    table.insert(names, "@" .. r.SettingsUser);
                end;
            end;
            if getgenv()._HubV3LastFakeD and getgenv()._HubV3LastFakeD ~= "" then
                table.insert(names, getgenv()._HubV3LastFakeD);
            end;
            if getgenv()._HubV3LastFakeU and getgenv()._HubV3LastFakeU ~= "" then
                table.insert(names, getgenv()._HubV3LastFakeU);
                table.insert(names, "@" .. getgenv()._HubV3LastFakeU);
            end;
        end);
        local n = 0;
        local desc = kill_feed:GetDescendants();
        for i = 1, math.min(#desc, 400) do
            local c = desc[i];
            if c:IsA("TextLabel") then
                local t = tostring(c.Text or "");
                local parentName = c.Parent and c.Parent.Name or "";
                if parentName == "Eliminator" or parentName == "Killer" or parentName == "Name" or parentName == "Player" then
                    for _, me in ipairs(names) do
                        if me ~= "" and (t == me or t == ("@" .. me) or string.find(t, me, 1, true)) then
                            n = n + 1;
                            break;
                        end;
                    end;
                end;
            end;
        end;
        return n;
    end;
    trove:Add(run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
        -- LAGFIX: killFeedCount walks 400 descendants; was every frame.
        if not ELI.kill_sound.enable then kill_base = nil; return end;
        getgenv()._EliKillAcc = (getgenv()._EliKillAcc or 0) + 1;
        if getgenv()._EliKillAcc < 30 then return end;
        getgenv()._EliKillAcc = 0;
        local n = killFeedCount();
        if n == nil then kill_base = nil; return end;
        if kill_base == nil then kill_base = n; return end;
        if n > kill_base then kill_base = n; killSoundPlay();
        elseif n < kill_base then kill_base = n end;
    end)));
end;

-- NO-DEATH-OOF: mute the game's death "oof" (classic oof + rivals death stinger)
-- on YOUR client only. Custom kill/hit sounds are excluded and keep working.
do
    getgenv().elisium_no_death_oof = true;
    local oofNamePat = { "died", "death", "oof", "ouch", "drown", "deadplayer", "playerdead", "deathcry" };
    local oofIdPat = { "138186576", "138186575", "144515274", "144515210", "ouch" };
    local oofExcludedIds = {};
    pcall(function()
        for _, id in eli_pairs(hitsound_dir) do
            if type(id) == "string" then
                local digits = id:match("(%d+)");
                if digits then oofExcludedIds[digits] = true end;
            end;
        end;
    end);
    local function oofIsOurs(s)
        local nm = "";
        pcall(function() nm = string.lower(tostring(s.Name or "")) end);
        if nm:find("elisium", 1, true) or nm:find("hitmarker", 1, true) then return true end;
        local sid = "";
        pcall(function() sid = tostring(s.SoundId or "") end);
        for digits in pairs(oofExcludedIds) do
            if sid:find(digits, 1, true) then return true end;
        end;
        return false;
    end;
    local function oofMute(s)
        if not getgenv().elisium_no_death_oof then return end;
        if not s or not s:IsA("Sound") then return end;
        if oofIsOurs(s) then return end;
        local nm = "";
        pcall(function() nm = string.lower(tostring(s.Name or "")) end);
        local sid = "";
        pcall(function() sid = string.lower(tostring(s.SoundId or "")) end);
        local hit = false;
        for _, pat in eli_ipairs(oofNamePat) do
            if nm:find(pat, 1, true) then hit = true break end;
        end;
        if not hit then
            for _, pat in eli_ipairs(oofIdPat) do
                if sid:find(pat, 1, true) then hit = true break end;
            end;
        end;
        if hit then
            pcall(function()
                s.Volume = 0;
                if s.IsPlaying then s:Stop() end;
                if not s:GetAttribute("EliOofMuted") then
                    s:SetAttribute("EliOofMuted", true);
                    s:GetPropertyChangedSignal("Volume"):Connect(function()
                        if getgenv().elisium_no_death_oof and s.Volume ~= 0 then
                            s.Volume = 0;
                        end;
                    end);
                    s.Played:Connect(function()
                        if getgenv().elisium_no_death_oof then pcall(function() s:Stop() end) end;
                    end);
                end;
            end);
        end;
    end;
    getgenv().elisium_mute_oof = oofMute;
    pcall(function()
        trove:Add(game:GetService("SoundService").DescendantAdded:Connect(function(d)
            if d:IsA("Sound") then task.defer(oofMute, d) end;
        end));
        trove:Add(workspace.DescendantAdded:Connect(function(d)
            if d:IsA("Sound") then task.defer(oofMute, d) end;
        end));
        local pg0 = local_player:FindFirstChildOfClass("PlayerGui");
        if pg0 then
            trove:Add(pg0.DescendantAdded:Connect(function(d)
                if d:IsA("Sound") then task.defer(oofMute, d) end;
            end));
        end;
    end);
    task.spawn(function()
        -- LAGFIX: full workspace+PlayerGui sound sweep at 2s piled onto
        -- boot. DescendantAdded hook already catches new ones; full sweep
        -- waits until the game is idle. lite mode skips it entirely.
        if getgenv().elisium_lite then return end;
        task.wait(12);
        pcall(function()
            local roots = { workspace, game:GetService("SoundService"), local_player:FindFirstChildOfClass("PlayerGui") };
            for _, root in eli_ipairs(roots) do
                if root then
                    local list = root:GetDescendants();
                    for i = 1, #list do
                        local d = list[i];
                        if d:IsA("Sound") then oofMute(d) end;
                        if i % 1500 == 0 then task.wait() end;
                    end;
                end;
            end;
        end);
    end);
    -- re-sweep on respawn: fresh character = fresh death sounds
    pcall(function()
        trove:Add(local_player.CharacterAdded:Connect(function(char)
            task.delay(1, function()
                pcall(function()
                    for _, d in eli_ipairs(char:GetDescendants()) do
                        if d:IsA("Sound") then oofMute(d) end;
                    end;
                end);
            end);
        end));
