-- execute doesn't hitch. ESP round-robin + thrower 0.3s handled above.
pcall(function()
    local li = game:GetService("Lighting");
    local b = li:FindFirstChild("ElisiumMenuBlur");
    if b then b:Destroy() end;
end);
task.delay(3, function()
    pcall(function()
        local li = game:GetService("Lighting");
        if li and not li:FindFirstChild("ElisiumMenuBlur") then return end;
        local t = Toggles and Toggles.MenuBlurToggle;
        if not (t and t.Value) then
            local b2 = li:FindFirstChild("ElisiumMenuBlur");
            if b2 then b2:Destroy() end;
        end;
    end);
    -- NOTE: no collectgarbage here: this executor errors on
    -- collectgarbage("collect") and it printed every execute.
end);
