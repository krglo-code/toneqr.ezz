-- MERGED LUNAR RAGEBOT (verbatim lunar.lua 9226-9512, good: desync+deflect)
--  HvH TAB: RAGEBOT
--  Ported from the supplied ragebot: closest-enemy targeting, katana deflect
--  tracking, per-frame desync + direct UseItem fire.  Everything is gated and
--  pcall'd so it simply stays idle in games without the fighter controllers.
--  Lives in the HvH tab with the rest of the combat tooling.
--==============================================================================
do
    local cloneref = cloneref or function(o) return o end
    local RB_RS   = cloneref(game:GetService('ReplicatedStorage'))
    local RB_PLRS = cloneref(game:GetService('Players'))
    local RB_RUN  = cloneref(game:GetService('RunService'))
    local RB_WS   = cloneref(game:GetService('Workspace'))
    local rb_lp   = RB_PLRS.LocalPlayer

    local function _pgBox(side, name)
        local ok, b = pcall(function()
            if side == 'R' then return getgenv().Pages.Rage:AddRightGroupbox(name) end
            return getgenv().Pages.Rage:AddLeftGroupbox(name)
        end);
        if ok and type(b) == 'table' then return b end
        local d = {};
        function d:AddToggle() return d end
        function d:AddSlider() return d end
        function d:AddDropdown() return d end
        function d:AddButton() return d end
        function d:AddInput() return d end
        function d:AddLabel() local l = {}; function l:SetText() end return l end
        return d;
    end
    local RageGb      = _pgBox('L', 'Ragebot')
    local RageFootGb  = _pgBox('L', 'Ragebot Status')
    local RageCheckGb = _pgBox('R', 'Ragebot Behaviour')

    RageGb:AddToggle('RagebotEnabled', { Text = 'Enable Ragebot', Default = false })
    RageGb:AddSlider('RagebotFireDelay', { Text = 'Fire Delay (ms)', Default = 0, Min = 0, Max = 20, Rounding = 0 })
    RageGb:AddDropdown('RagebotWeaponSlot', { Text = 'Weapon Slot', Values = { 'Primary', 'Secondary', 'Melee' }, Default = 3 })
    RageGb:AddToggle('RagebotAutoEquip', { Text = 'Keep Slot Equipped', Default = true })
    RageCheckGb:AddToggle('RagebotDesync', { Text = 'Desync Position', Default = true })
    RageCheckGb:AddToggle('RagebotAntiKatana', { Text = 'Skip Deflecting Targets', Default = true })
    RageCheckGb:AddToggle('RagebotTeamCheck', { Text = 'Team Check', Default = true })
    RageCheckGb:AddToggle('RagebotNotify', { Text = 'Notify On Lock', Default = false })
    RageCheckGb:AddSlider('RagebotMaxDistance', { Text = 'Max Distance', Default = 500, Min = 50, Max = 2000, Rounding = 0 })

    local statusLabel = RageFootGb:AddLabel('ragebot: idle')

    local rbUtil, rbEnum, FighterController, SpectateController
    local ragebotReady = pcall(function()
        local playerScripts = rb_lp:WaitForChild('PlayerScripts', 10)
        local controllers = playerScripts and playerScripts:WaitForChild('Controllers', 10)
        if not controllers then error('no controllers') end
        rbUtil = require(RB_RS.Modules.Utility)
        rbEnum = require(RB_RS.Modules.EnumLibrary)
        FighterController = require(controllers.FighterController)
        SpectateController = require(controllers:WaitForChild('SpectateController', 10))
    end)

    if not (ragebotReady and rbUtil and rbEnum and FighterController) then
        statusLabel:SetText('ragebot: fighter controllers not present in this game (inert)')
    else
        local slots = { Primary = 1, Secondary = 2, Melee = 3 }
        local deflecting = {}
        local lastFire = 0
        local lastLock = nil
        local restoreName = 'lunar_ragebot_restore'

        -- The status label is written from the heartbeat, so only touch the TextLabel
        -- when the text actually changes - a per-frame write forces the GUI to relayout
        -- 60 times a second for no reason.
        local lastStatus
        local function setStatus(text)
            if text == lastStatus then return end
            lastStatus = text
            statusLabel:SetText(text)
        end

        -- The desync used to BindToRenderStep a fresh closure on every heartbeat and
        -- unbind it again from inside the render callback.  Bind it once instead: same
        -- restore, without allocating and re-sorting the render step list 60x a second.
        local savedRoot, savedCF, savedVel, savedRot
        local restoreBound = false
        local function ensureRestoreBound()
            if restoreBound then return end
            restoreBound = true
            RB_RUN:BindToRenderStep(restoreName, 101, function()
                if savedRoot and savedRoot.Parent then
                    savedRoot.CFrame = savedCF
                    savedRoot.Velocity = savedVel
                    savedRoot.RotVelocity = savedRot
                end
            end)
        end
        getgenv().Library:OnUnload(function()
            if restoreBound then
                restoreBound = false
                pcall(function() RB_RUN:UnbindFromRenderStep(restoreName) end)
            end
        end)

        local function val(name)
            local o = Options[name]
            return o and o.Value
        end

        local function on(name)
            local t = Toggles[name]
            return t and t.Value
        end

        local function getSlotNumber()
            return slots[tostring(val('RagebotWeaponSlot') or 'Melee')] or 3
        end

        RB_PLRS.PlayerRemoving:Connect(function(player) deflecting[player] = nil end)

        local function updateDeflection()
            local objects = FighterController.Objects
            if not objects then return end
            for _, fighterObj in objects do
                local player = fighterObj and fighterObj.Player
                if player then
                    local entity = fighterObj.Entity
                    if (not entity) or (not entity:IsAlive()) or fighterObj:Get('IsSpectating') then
                        deflecting[player] = false
                    else
                        local equipped = fighterObj.EquippedItem
                        local viewModel = equipped and equipped.ViewModel
                        local isKatana = viewModel and viewModel.Name == 'Katana'
                        local isDeflecting = false
                        if isKatana and equipped._attack_cooldown then
                            isDeflecting = equipped._attack_cooldown > tick()
                        end
                        deflecting[player] = isDeflecting
                    end
                end
            end
        end

        local function isEnemy(player)
            if player == rb_lp then return false end
            if not on('RagebotTeamCheck') then return true end
            local duel = SpectateController and SpectateController.CurrentDuelSubject
            local localDueler = duel and duel:GetDueler(rb_lp)
            local localTeam = localDueler and localDueler:Get('TeamID')
            if localTeam and duel and duel.Duelers then
                for _, dueler in duel.Duelers do
                    if dueler.Player == player then
                        return dueler:Get('TeamID') ~= localTeam
                    end
                end
            end
            local playerTeam = player:GetAttribute('TeamID')
            local myTeam = rb_lp:GetAttribute('TeamID')
            if playerTeam and myTeam then return playerTeam ~= myTeam end
            return true
        end

        local function getClosestTarget()
            local char = rb_lp.Character
            local myRoot = char and char:FindFirstChild('HumanoidRootPart')
            if not myRoot then return nil end
            local maxDist = tonumber(val('RagebotMaxDistance')) or 500
            local closest, closestRoot, closestHead, closestDist = nil, nil, nil, maxDist
            for _, player in ipairs(RB_PLRS:GetPlayers()) do
                if isEnemy(player) then
                    local pChar = player.Character
                    if pChar then
                        local pRoot = pChar:FindFirstChild('HumanoidRootPart')
                        local pHead = pChar:FindFirstChild('Head')
                        local pHum = pChar:FindFirstChildWhichIsA('Humanoid')
                        if pRoot and pHead and pHum and pHum.Health > 0 then
                            local dist = (myRoot.Position - pRoot.Position).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = player
                                closestRoot = pRoot
                                closestHead = pHead
                            end
                        end
                    end
                end
            end
            return closest, closestRoot, closestHead
        end

        local function hasKnifeViewModel(targetPlayer)
            if not targetPlayer then return false end
            local viewModels = RB_WS:FindFirstChild('ViewModels')
            if not viewModels then return false end
            local targetName = targetPlayer.Name
            for _, model in ipairs(viewModels:GetChildren()) do
                if model:IsA('Model')
                    and string.find(model.Name, targetName, 1, true)
                    and string.find(model.Name, 'Knife', 1, true) then
                    return true
                end
            end
            return false
        end

        task.spawn(function()
            while task.wait(1) do
                if on('RagebotEnabled') and on('RagebotAutoEquip') then
                    local fighter = FighterController.LocalFighter
                    if fighter then pcall(function() fighter:EquipItem(getSlotNumber()) end) end
                end
            end
        end)

        getgenv().RagebotConn = RB_RUN.Heartbeat:Connect(function()
            -- start each frame unpinned; only a frame that actually desyncs re-arms the
            -- restore, so switching the ragebot off cannot leave the character frozen
            savedRoot = nil
            if not on('RagebotEnabled') then return end
            local fighter = FighterController.LocalFighter
            if not fighter then return end

            pcall(updateDeflection)

            local targetPlayer, targetRoot, targetHead = getClosestTarget()
            if not (targetPlayer and targetRoot and targetHead) then
                lastLock = nil
                setStatus('ragebot: no target')
                return
            end
            if on('RagebotAntiKatana') and deflecting[targetPlayer] then
                setStatus('ragebot: ' .. targetPlayer.Name .. ' deflecting')
                return
            end

            local char = rb_lp.Character
            local myRoot = char and char:FindFirstChild('HumanoidRootPart')
            if not myRoot then return end

            local desyncCF
            if on('RagebotDesync') then
                local desyncPos
                if hasKnifeViewModel(targetPlayer) then
                    desyncPos = (targetRoot.CFrame * CFrame.new(0, 6, 0)).Position
                else
                    desyncPos = (targetRoot.CFrame * CFrame.new(0, 1, 2)).Position
                end
                desyncCF = CFrame.lookAt(desyncPos, targetHead.Position)
                if desyncCF.X == desyncCF.X then
                    savedRoot, savedCF, savedVel, savedRot = myRoot, myRoot.CFrame, myRoot.Velocity, myRoot.RotVelocity
                    ensureRestoreBound()
                    myRoot.CFrame = desyncCF
                else
                    desyncCF = nil
                end
            else
                -- stop rewriting the saved CFrame, or the render step would pin the
                -- character in place after the toggle is switched off
                savedRoot = nil
            end

            local item = fighter.EquippedItem
            if not item then
                setStatus('ragebot: no weapon equipped')
                return
            end

            -- a 0ms delay used to mean "fire on every single heartbeat", which floods
            -- the server with UseItem remotes 60 times a second; keep a floor on it
            local fireRate = math.max((tonumber(val('RagebotFireDelay')) or 0) / 1000, 0.05)
            if tick() - lastFire < fireRate then return end
            lastFire = tick()

            local originPos = desyncCF and desyncCF.Position or targetRoot.Position
            local targetPos = targetHead.Position
            local aimCF = CFrame.lookAt(originPos, targetPos)
            local targetCF = targetHead.CFrame
            local randomOffset = Vector3.new(
                (math.random() - 0.5) * 0.1,
                (math.random() - 0.5) * 0.1,
                (math.random() - 0.5) * 0.1
            )
            local aimedPos = targetPos + randomOffset
            local objSpaceHeadOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(aimedPos))
            local cameradata = {}
            cameradata[utf8.char(1)] = {
                [utf8.char(0)] = rbUtil:EncodeCFrame(aimCF),
                [utf8.char(1)] = rbUtil:EncodeCFrame(targetCF),
                [utf8.char(2)] = targetHead,
                [utf8.char(3)] = rbUtil:EncodeCFrame(objSpaceHeadOffset),
            }
            pcall(function()
                RB_RS.Remotes.Replication.Fighter.UseItem:FireServer(
                    item:Get('ObjectID'),
                    rbEnum:ToEnum('StartShooting'),
                    cameradata,
                    nil
                )
            end)
            setStatus('ragebot: firing at ' .. targetPlayer.Name)
            if on('RagebotNotify') and lastLock ~= targetPlayer then
                lastLock = targetPlayer
                getgenv().Library:Notify('Ragebot locked: ' .. targetPlayer.Name, 1.5)
            end
        end)
    end
end


-- == RIVALS SKIN CHANGER TRANSPLANT (merged v4.2, equip-passthrough; elisium-wired, no aimbot) ==
if not getgenv()._RivalsSkinsLoaded then
getgenv()._RivalsSkinsLoaded = true;
task.spawn(function()
    if getgenv().elisium_lite then return end;
    task.wait(2)
-- RIVALS merged v4.2 | equip-passthrough + latched self-only profile guard | visual-only
-- file: rivals-skins-merged.luau
-- RUN THIS ONE ONLY. Delete / don't run rivals-skins-namecall.luau anymore.
-- v4.2 FIX (5-second decay): the profile UI rebuilds its weapon previews a few
-- seconds after opening (async data fill). The old guard re-scanned every 0.5s
-- and any single miss (frame invisible for a tick, tree mid-rebuild, name label
-- not yet filled) flipped it false for exactly one rebuild window -- and built
-- viewmodels keep the painted fakes forever. New guard LATCHES: once tripped it
-- stays tripped until the ViewProfile frame is GONE for 6 straight scans (~3s).
-- A flicker can't unlatch it. Closing the profile resets it.

repeat task.wait() until game:IsLoaded()
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local SAVE = "RIVALS_Skins_NC.json"
print("[merged v4.2] start")
getgenv().SELF_ONLY = true -- false = debug (fakes everywhere, including other profiles)

local function req(m)
	local ok, r = pcall(require, m)
	if ok then return r end
	return nil
end

local Modules = RS:WaitForChild("Modules", 15)
local CosmeticLibrary = req(Modules:WaitForChild("CosmeticLibrary", 10))
local ItemLibrary = req(Modules:WaitForChild("ItemLibrary", 10))
local repClassMod = Modules:WaitForChild("ReplicatedClass", 10)
local ReplicatedClass = req(repClassMod)
if not CosmeticLibrary then warn("[merged v4.2] no CosmeticLibrary") return end

local DataController = nil
local FighterController = nil
do
	local okPS, PS = pcall(function() return LocalPlayer:WaitForChild("PlayerScripts", 10) end)
	if okPS and PS then
		local CT = PS:FindFirstChild("Controllers")
		if CT then
			local m = CT:FindFirstChild("PlayerDataController") or CT:FindFirstChild("DataController")
			if m then DataController = req(m) end
			local fc = CT:FindFirstChild("FighterController")
			if fc then pcall(function() FighterController = require(fc) end) end
		end
	end
end
local finishersFolder = Modules:FindFirstChild("Finishers")
local enumMod = Modules:FindFirstChild("EnumLibrary")
local EnumLibrary = nil
if enumMod then EnumLibrary = req(enumMod) end

local equipped = {}
local favorites = {}
local constructingWeapon = nil
local lastUsedWeapon = nil
local hooksReady = false
local localLower = LocalPlayer.Name:lower()
local SKIP = { RANDOM_COSMETIC = true, NONE = true, Default = true, None = true, NONE_COSMETIC = true }
SKIP[""] = true

-- forward declare: GetWeaponData hook calls this before def below
local IsViewingOtherProfile = function() return false end

do
	local has = false
	pcall(function() has = isfile(SAVE) end)
	if has then
		pcall(function()
			local cfg = Http:JSONDecode(readfile(SAVE))
			if cfg.favorites then favorites = cfg.favorites end
			if cfg.equipped then
				for w, t in pairs(cfg.equipped) do
					equipped[w] = equipped[w] or {}
					for typ, cd in pairs(t) do
						equipped[w][typ] = { Name = cd.name, Seed = cd.seed, Inverted = cd.inverted, Type = typ }
					end
				end
			end
		end)
	end
end

local function saveDb()
	if not writefile then return end
	local copy = {}
	for w, t in pairs(equipped) do
		copy[w] = {}
		for typ, d in pairs(t) do
			if d and d.Name then copy[w][typ] = { name = d.Name, seed = d.Seed, inverted = d.Inverted } end
		end
	end
	task.spawn(function() pcall(function() writefile(SAVE, Http:JSONEncode({ equipped = copy, favorites = favorites })) end) end)
end

local function cloneOne(name, ctype, inverted)
	if not name or SKIP[name] then return nil end
	local lib = CosmeticLibrary.Cosmetics
	if not lib then return nil end
	local resolved = name
	if CosmeticLibrary.RENAMED_COSMETICS and CosmeticLibrary.RENAMED_COSMETICS[name] then resolved = CosmeticLibrary.RENAMED_COSMETICS[name] end
	local base = lib[resolved]
	if not base then return nil end
	local d = {}
	for k, v in pairs(base) do d[k] = v end
	d.Name = resolved
	d.Type = d.Type or ctype
	d.Seed = math.random(1, 1000000)
	if EnumLibrary then
		pcall(function()
			local id = EnumLibrary:ToEnum(resolved)
			if id then d.Enum = id d.ObjectID = id end
		end)
	end
	if inverted then d.Inverted = true end
	return d
end

for w, t in pairs(equipped) do
	for typ, d in pairs(t) do
		local full = cloneOne(d.Name, typ, d.Inverted)
		if full then
			if d.Seed then full.Seed = d.Seed end
			equipped[w][typ] = full
		else
			equipped[w][typ] = nil
		end
	end
end

-- cosmetics-only unlock (visual only): all skins / wraps / finishers / charms.
-- Weapons are NOT granted: ownership, levels and XP stay 100% real.
CosmeticLibrary.OwnsCosmeticNormally = function() return true end
CosmeticLibrary.OwnsCosmeticUniversally = function() return true end
CosmeticLibrary.OwnsCosmeticForSomething = function() return true end
CosmeticLibrary.OwnsCosmeticForWeapon = function() return true end
local oOwns = CosmeticLibrary.OwnsCosmetic
CosmeticLibrary.OwnsCosmetic = function(self, inv, name, weapon)
	if name and tostring(name):find("MISSING_") and oOwns then return oOwns(self, inv, name, weapon) end
	return true
end
if DataController then
	local ogw = DataController.GetWeaponData
	if ogw then
		DataController.GetWeaponData = function(self, w)
			local d = {}
			local o = nil
			pcall(function() o = ogw(self, w) end)
			if o then for k, v in pairs(o) do d[k] = v end end
			-- SELF-ONLY: never paint fakes when inspecting someone else
			if type(w) == "string" and equipped[w] and not IsViewingOtherProfile() then
				for t, cd in pairs(equipped[w]) do d[t] = cd end
			end
			return d
		end
	end
end

-- SELF-ONLY guard v4.2 (LATCHED): ViewProfile under MainGui exists ONLY while a
-- profile is open. Trip on EXISTENCE (Visible ignored -- the frame flickers
-- during async rebuilds). Once latched true, needs the frame GONE for 6
-- straight scans (~3s) before unlatching. Single-scan misses can't leak.
local viewingOtherCache = false
local guardReason = "none"
local goneStreak = 0
IsViewingOtherProfile = function()
	if getgenv().SELF_ONLY == false then return false end
	return viewingOtherCache
end
getgenv().IsViewingOther = IsViewingOtherProfile
getgenv().GuardReason = function() return guardReason end
task.spawn(function()
	local lastVal = false
	while true do
		task.wait(2)
		if not next(equipped) then continue end
		local ok, seen, reason = pcall(function()
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			local mg = pg and pg:FindFirstChild("MainGui")
			if not mg then return false, "no-maingui" end
			-- whole-MainGui sweep: ViewProfile moves parents between patches
			local found = nil
			for _, d in ipairs(mg:GetDescendants()) do
				if d.Name == "ViewProfile" and d:IsA("GuiObject") then found = d break end
			end
			if found then
				-- whose profile? self @name inside => your own profile, show fakes
				local selfName = LocalPlayer.Name:lower()
				local selfDisp = LocalPlayer.DisplayName:lower():gsub("%s+", "")
				local sawSelf, sawOther = false, false
				local n = 0
				for _, d in ipairs(found:GetDescendants()) do
					n = n + 1
					if n > 200 then break end
					if d:IsA("TextLabel") then
						local t = tostring(d.Text or "")
						if #t > 1 and t:sub(1, 1) == "@" then
							local nm = t:sub(2):lower():gsub("%s+", "")
							if nm ~= "" and nm ~= "onlytwentycharacters" then
								if nm == selfName or nm == selfDisp then
									sawSelf = true
								else
									sawOther = true
								end
							end
						end
					end
				end
				if sawOther then return true, "viewprofile-other" end
				if sawSelf then return false, "viewprofile-self" end
				return true, "viewprofile-open"
			end
			-- fallback: Inspect @name = a real other player selected
			local others = {}
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then others[p.Name:lower()] = true end
			end
			local pl = mg:FindFirstChild("PlayerList")
			local cont = pl and pl:FindFirstChild("Container")
			local insp = cont and cont:FindFirstChild("Inspect")
			if insp then
				local n = 0
				for _, d in ipairs(insp:GetDescendants()) do
					n = n + 1
					if n > 120 then break end
					if d:IsA("TextLabel") then
						local t = tostring(d.Text or "")
						if #t > 1 and t:sub(1, 1) == "@" then
							local nm = t:sub(2):lower():gsub("%s+", "")
							if nm ~= "" and nm ~= "onlytwentycharacters" and others[nm] then
								return true, "inspect-other:" .. nm
							end
						end
					end
				end
			end
			return false, "none"
		end)
		if not ok then seen, reason = false, "err" end
		if seen then
			goneStreak = 0
			viewingOtherCache, guardReason = true, reason
		else
			-- latched: only release after the frame is gone 6 scans in a row
			if viewingOtherCache then
				goneStreak = goneStreak + 1
				if goneStreak >= 6 then
					viewingOtherCache, guardReason = false, "released:" .. reason
					goneStreak = 0
				end
			else
				viewingOtherCache, guardReason = false, reason
			end
		end
		if viewingOtherCache ~= lastVal then
			print("[merged v4.2] guard -> " .. tostring(viewingOtherCache) .. " (" .. tostring(guardReason) .. ")")
			lastVal = viewingOtherCache
			-- push inventory now: others' profiles render vanilla while open,
			-- your fakes return the moment it closes. Local-only, always.
			pcall(function() scheduleRep() end)
			-- profile UI rebuilds async seconds after opening: re-push vanilla
			-- twice so a late rebuild can never paint your fakes on them.
			-- release path re-pushes immediately so YOUR view is fakes again.
			task.delay(1, function() pcall(function() scheduleRep() end) end)
			task.delay(3, function() pcall(function() if viewingOtherCache then scheduleRep() end end) end)
		end
	end
end)

local repPending = false
local function isPickWeaponsOpen()
	local open = false
	pcall(function()
		local lf = (typeof(fighter_controller) == "table" and fighter_controller.LocalFighter)
			or (FighterController and FighterController.LocalFighter)
			or (getgenv().fighter_controller and getgenv().fighter_controller.LocalFighter)
		if not lf then
			local ok, FC = pcall(function()
				return require(game:GetService("Players").LocalPlayer.PlayerScripts.Controllers.FighterController)
			end)
			if ok and FC then lf = FC.LocalFighter end
		end
		open = lf and lf:Get("CanPickWeapons") == true
	end)
	return open and true or false
end
local function scheduleRep()
	if not DataController then
		saveDb()
		return
	end
	-- LOADOUT FIX: never touch WeaponInventory while the pick/loadout screen is open.
	-- Replicating mid-pick resets the UI and makes equip "stick" then bounce on T.
	if isPickWeaponsOpen() then
		saveDb()
		if not getgenv()._EliDeferredInvRep then
			getgenv()._EliDeferredInvRep = true
			task.spawn(function()
				while isPickWeaponsOpen() do
					task.wait(0.25)
				end
				task.wait(0.4)
				getgenv()._EliDeferredInvRep = false
				pcall(function()
					if DataController and DataController.CurrentData and not isPickWeaponsOpen() then
						DataController.CurrentData:Replicate("WeaponInventory")
					end
				end)
				saveDb()
			end)
		end
		return
	end
	if repPending then return end
	repPending = true
	task.spawn(function()
		local w = 0
		while not hooksReady and w < 10 do task.wait(0.1) w = w + 0.1 end
		-- wait out any pick screen that opened while we were pending
		while isPickWeaponsOpen() do
			task.wait(0.25)
		end
		task.wait(0.35)
		repPending = false
		if not isPickWeaponsOpen() then
			pcall(function() DataController.CurrentData:Replicate("WeaponInventory") end)
		end
		saveDb()
	end)
end
getgenv().elisium_is_pick_open = isPickWeaponsOpen
getgenv().elisium_schedule_rep = scheduleRep

local equipRem = nil
local favRem = nil
local useRem = nil
do
	local okR, rems = pcall(function() return RS:WaitForChild("Remotes", 10) end)
	if okR and rems then
		local data = rems:FindFirstChild("Data")
		if data then
			equipRem = data:FindFirstChild("EquipCosmetic")
			favRem = data:FindFirstChild("FavoriteCosmetic")
		end
		local rep = rems:FindFirstChild("Replication")
		local ff = rep and rep:FindFirstChild("Fighter")
		if ff then useRem = ff:FindFirstChild("UseItem") end
	end
end
if not equipRem then warn("[merged v4.2] no EquipCosmetic") return end
print("[merged v4.2] hook installing...")

local oldNc = nil
oldNc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
	local m = getnamecallmethod()
	if m ~= "FireServer" then return oldNc(self, ...) end
	if self == equipRem then
		-- LOCAL-ONLY: save fakes on YOUR client only, never touch the server.
		-- (Old passthrough leaked every pick to other players' profiles.)
		local weapon, ctype, cname, opts = ...
		if type(opts) ~= "table" then opts = {} end
		if SKIP[cname] then return nil end
		if not cname or cname == "None" or cname == "" then
			if type(weapon) == "string" then
				equipped[weapon] = equipped[weapon] or {}
				equipped[weapon][ctype] = nil
				if not next(equipped[weapon]) then equipped[weapon] = nil end
			end
		else
			local c = cloneOne(cname, ctype, opts.IsInverted)
			if c and type(weapon) == "string" then
				equipped[weapon] = equipped[weapon] or {}
				equipped[weapon][ctype] = c
			end
		end
		scheduleRep()
		return nil -- swallowed: server keeps your real loadout, others see real
	end
	if favRem and self == favRem then
		local a1, a2, a3 = ...
		favorites[a1] = favorites[a1] or {}
		favorites[a1][a2] = a3 or nil
		saveDb()
		return oldNc(self, ...)
	end
	if useRem and self == useRem and FighterController then
		local oid = ...
		local fc = FighterController
		task.spawn(function()
			pcall(function()
				local f = fc:GetFighter(LocalPlayer)
				if f and f.Items then
					for _, it in pairs(f.Items) do
						if it:Get("ObjectID") == oid then lastUsedWeapon = it.Name break end
					end
				end
			end)
		end)
	end
	return oldNc(self, ...)
end))
print("[merged v4.2] __namecall live")


local function hubEquippedMatch(eq, name)
	if type(eq) ~= "table" or type(name) ~= "string" or name == "" then return nil end
	local e = eq[name]
	if type(e) == "table" then return e end
	-- case-insensitive fallback
	local lower = string.lower(name)
	for k, v in pairs(eq) do
		if type(k) == "string" and string.lower(k) == lower and type(v) == "table" then
			return v
		end
	end
	return nil
end
local function hubFinisherPool()
	local out, seen = {}, {}
	local function push(nm)
		nm = tostring(nm or "")
		if nm ~= "" and not seen[nm] then seen[nm] = true; table.insert(out, nm) end
	end
	pcall(function()
		local mods = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
		local f = mods and mods:FindFirstChild("Finishers")
		if f then for _, c in ipairs(f:GetChildren()) do push(c.Name) end end
	end)
	return out
end

-- viewmodels: inject skin early + wrap double-update, SELF-ONLY gated
task.spawn(function()
	task.wait(3)
	local okPS, PS = pcall(function() return LocalPlayer:WaitForChild("PlayerScripts", 10) end)
	if not okPS or not PS then hooksReady = true return end
	pcall(function()
		local CI = req(PS.Modules.ClientReplicatedClasses.ClientFighter.ClientItem)
		if CI and CI._CreateViewModel then
			local og = CI._CreateViewModel
			CI._CreateViewModel = function(self, ref)
				local wp = self.ClientFighter and self.ClientFighter.Player
				if wp == LocalPlayer then constructingWeapon = self.Name else constructingWeapon = nil end
				-- self duel: full inject. inspect preview (wp==nil) only when NOT viewing other.
				local allow = (wp == LocalPlayer) or (wp == nil and not IsViewingOtherProfile())
				local eqSelf = hubEquippedMatch(equipped, self.Name)
				if allow and eqSelf and eqSelf.Skin and ref then
					pcall(function()
						local dk, sk, nk = nil, nil, nil
						local okE = pcall(function()
							dk = self:ToEnum("Data")
							sk = self:ToEnum("Skin")
							nk = self:ToEnum("Name")
						end)
						if not okE and ReplicatedClass then
							dk = ReplicatedClass:ToEnum("Data")
							sk = ReplicatedClass:ToEnum("Skin")
							nk = ReplicatedClass:ToEnum("Name")
						end
						local skin = eqSelf.Skin
						if dk and sk and ref[dk] then
							ref[dk][sk] = skin
							if nk then ref[dk][nk] = skin.Name end
						elseif ref.Data then
							ref.Data.Skin = skin
							ref.Data.Name = skin.Name
						end
					end)
				end
				local r = og(self, ref)
				constructingWeapon = nil
				return r
			end
		end
	end)
	pcall(function()
		local path = PS.Modules.ClientReplicatedClasses.ClientFighter.ClientItem
		local CVMmod = path:FindFirstChild("ClientViewModel")
		if not CVMmod then return end
		local CVM = req(CVMmod)
		if not CVM then return end
		if CVM.GetWrap then
			local og = CVM.GetWrap
			CVM.GetWrap = function(self)
				local ci = self.ClientItem
				local wn = ci and ci.Name
				local cf = ci and ci.ClientFighter
				local wp = cf and cf.Player
				local eqW = hubEquippedMatch(equipped, wn)
			if wn and eqW and eqW.Wrap then
					if wp == LocalPlayer then return eqW.Wrap end
					if wp == nil and not IsViewingOtherProfile() then return eqW.Wrap end
				end
				return og(self)
			end
		end
		if CVM.GetCharm then
			local ogc = CVM.GetCharm
			CVM.GetCharm = function(self)
				local ci = self.ClientItem
				local wn = ci and ci.Name
				local cf = ci and ci.ClientFighter
				local wp = cf and cf.Player
				local eqC = hubEquippedMatch(equipped, wn)
			if wn and eqC and eqC.Charm then
					if wp == LocalPlayer then return eqC.Charm end
					if wp == nil and not IsViewingOtherProfile() then return eqC.Charm end
				end
				return ogc(self)
			end
		end
		local ogNew = CVM.new
		local enums = nil
		pcall(function()
			local rc = req(repClassMod)
			if rc then enums = { D = rc:ToEnum("Data"), S = rc:ToEnum("Skin"), W = rc:ToEnum("Wrap"), C = rc:ToEnum("Charm") } end
		end)
		CVM.new = function(repData, cItem)
			local cf = cItem.ClientFighter
			local wp = cf and cf.Player
			local wn = constructingWeapon or cItem.Name
			local allow = (wp == LocalPlayer) or (wp == nil and not IsViewingOtherProfile())
			local eqN = hubEquippedMatch(equipped, wn)
		if allow and wn and eqN and enums and repData then
				pcall(function()
					repData[enums.D] = repData[enums.D] or {}
					local e = eqN
					if e.Skin then repData[enums.D][enums.S] = e.Skin end
					if e.Wrap then repData[enums.D][enums.W] = e.Wrap end
					if e.Charm then repData[enums.D][enums.C] = e.Charm end
				end)
			end
			local r = ogNew(repData, cItem)
			if r and allow and wn and eqN and eqN.Wrap and r._UpdateWrap then
				task.spawn(function()
					pcall(function() r:_UpdateWrap() end)
					task.wait(0.1)
					pcall(function() if not r._destroyed then r:_UpdateWrap() end end)
				end)
			end
			return r
		end
	end)
	pcall(function()
		local PS3 = LocalPlayer:FindFirstChildOfClass("PlayerScripts") or PS
		local CE = req(PS3.Modules.ClientReplicatedClasses.ClientEntity)
		if CE and CE._PlayFinisher then
			local og = CE._PlayFinisher
			CE._PlayFinisher = function(self, fname, isFinal, elim, serial)
				local ours = false
				if elim == LocalPlayer then ours = true
				elseif type(elim) == "string" then ours = (elim == LocalPlayer.Name or elim:lower() == localLower) end
				if ours then
					local w = lastUsedWeapon
					if not (w and equipped[w] and equipped[w].Finisher) then
						for wn, t in pairs(equipped) do if t.Finisher then w = wn break end end
					end
					if w and equipped[w] and equipped[w].Finisher then
						local canon = nil
						pcall(function() canon = hubFinisherCanonical(equipped[w].Finisher.Name) end)
						if canon then fname = canon end
					end
					-- hub Force Finisher: your pick plays on every one of your
					-- kills regardless of equipped skins (canonicalized, so a
					-- renamed finisher still resolves instead of fizzling)
					if getgenv().RivalsHubCfg and getgenv().RivalsHubCfg.FinishForce then
						local want = tostring(getgenv().RivalsHubCfg.FinishForceName or "")
						if want ~= "" then
							local canon2 = nil
							pcall(function() canon2 = hubFinisherCanonical(want) end)
							if canon2 then fname = canon2 end
						end
					end
					-- hub ragdoll control, timed off the finisher's own length
					local fdelay = 0.3
					pcall(function()
						local spec = getgenv()._HubFinSpec or {}
						local s = spec[fname]
						if s and tonumber(s.duration) then
							fdelay = math.clamp(tonumber(s.duration) * 0.6, 0.25, 3)
						end
					end)
					task.delay(fdelay, function()
						pcall(function()
							local vm = self.Model or self.Character or self._model
								or self._character or self.Victim or self.Target
							if typeof(vm) ~= "Instance" then
								if typeof(elim) == "Instance" and elim:IsA("Player") then
									vm = elim.Character
								else
									vm = nil
								end
							end
							hubFinishRagdoll(vm, fname)
						end)
					end)
				end
				return og(self, fname, isFinal, elim, serial)
			end
		end
	end)
	pcall(function()
		if ItemLibrary.GetViewModelImageFromWeaponData then
			local og = ItemLibrary.GetViewModelImageFromWeaponData
			ItemLibrary.GetViewModelImageFromWeaponData = function(self, wd, hr)
				if not IsViewingOtherProfile() and wd and wd.Name and equipped[wd.Name] and equipped[wd.Name].Skin then
					local info = self.ViewModels and self.ViewModels[equipped[wd.Name].Skin.Name]
					if info then return info[hr and "ImageHighResolution" or "Image"] or info.Image end
				end
				return og(self, wd, hr)
			end
		end
	end)
	hooksReady = true
	pcall(function() if DataController then DataController.CurrentData:Replicate("WeaponInventory") end end)
	print("[merged v4.2] ready - equip works, profiles latched self-only")
end)

getgenv().MergedStatus = function()
	local n = 0
	for _ in pairs(equipped) do n = n + 1 end
	return { weapons = n, viewingOther = viewingOtherCache, reason = guardReason, self_only = getgenv().SELF_ONLY }
end
end)

-- equip-all: unlock-all now actually EQUIPS. Fires the game's own EquipCosmetic for
-- every rivals-equipped pick AND every elisium pending pick, then replicates.
getgenv().elisium_rivals_equip_all = function()
    local n = 0;
    pcall(function()
        local RS = game:GetService("ReplicatedStorage");
        local data = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Data");
        local rem = data and data:FindFirstChild("EquipCosmetic");
        if not rem then return end;
        -- elisium pending picks (changer grid selections not yet applied)
        local st = getgenv().elisium_cosmetic_state;
        local pend = st and st.pendingCosmetics;
        if type(pend) == "table" then
            for w, types in pairs(pend) do
                if type(types) == "table" then
                    for ctype, cname in pairs(types) do
                        if type(cname) == "string" and cname ~= "" then
                            local ok = pcall(function()
                                local opts = {};
                                if ctype == "Wrap" then
                                    local po = st.pendingWrapOpts and st.pendingWrapOpts[w];
                                    if po and po.inverted ~= nil then opts = { IsInverted = po.inverted == true } end;
                                end;
                                rem:FireServer(w, ctype, cname, opts);
                            end);
                            if ok then n = n + 1 end;
                        end;
                    end;
                end;
            end;
        end;
        -- elisium direct fire path (same remote, canonical shape)
        if getgenv().elisium_fireEquip then
            local st2 = getgenv().elisium_cosmetic_state;
            local pend2 = st2 and st2.pendingCosmetics;
            if type(pend2) == "table" then
                for w, types in pairs(pend2) do
                    if type(types) == "table" then
                        for ctype, cname in pairs(types) do
                            if type(cname) == "string" and cname ~= "" then
                                pcall(function() getgenv().elisium_fireEquip(w, ctype, cname, {}) end);
                            end;
                        end;
                    end;
                end;
            end;
        end;
    end);
    pcall(function()
        local dc = getgenv().elisium_datacontrol;
        if dc and dc.CurrentData then
            dc.CurrentData:Replicate("CosmeticInventory");
            dc.CurrentData:Replicate("WeaponInventory");
            dc.CurrentData:Replicate("FavoritedCosmetics");
        end;
    end);
    return n;
end;
end; -- _RivalsSkinsLoaded guard
-- == /RIVALS SKIN TRANSPLANT ==


-- == RIVALS SPOOFER TRANSPLANT (username + displayname, elisium-wired) ==
if not getgenv()._RivalsSpoofLoaded then
getgenv()._RivalsSpoofLoaded = true;
ELI.rivspoof = ELI.rivspoof or {
    display = '', user = '', level = 0, streak = 0, rank = '',
    spoofDisplay = true, spoofUser = true,
    colorR = 255, colorG = 255, colorB = 255,
    copyId = '', wins = 0, winrate = 0, elo = 0, icon = 'influencer',
};
do
local RCfg = ELI.rivspoof;
-- field alias bridge: UI writes short keys (display/user/level), engine reads Settings*
local function RIV_SyncCfg()
    if type(RCfg) ~= "table" then return end
    -- UI short keys are freshest: an empty string in Settings used to be truthy
    -- and shadowed later typing forever, which is what broke the username box.
    -- Non-empty short key always wins; Settings only survives when short is empty.
    local function strPick(short, saved)
        short = short == nil and "" or tostring(short);
        saved = saved == nil and "" or tostring(saved);
        if short ~= "" then return short end;
        return saved;
    end;
    RCfg.SettingsDisplay = strPick(RCfg.display, RCfg.SettingsDisplay);
    RCfg.SettingsUser = strPick(RCfg.user, RCfg.SettingsUser);
    if RCfg.level ~= nil and tonumber(RCfg.level) ~= nil then
        RCfg.SettingsLevel = tonumber(RCfg.level);
    elseif RCfg.SettingsLevel == nil then
        RCfg.SettingsLevel = 0;
    end;
    if RCfg.streak ~= nil and tonumber(RCfg.streak) ~= nil then
        RCfg.SettingsStreak = tonumber(RCfg.streak);
    elseif RCfg.SettingsStreak == nil then
        RCfg.SettingsStreak = 0;
    end;
    RCfg.SettingsRank = strPick(RCfg.rank, RCfg.SettingsRank);
    RCfg.SpoofWins = tonumber(RCfg.SpoofWins or RCfg.wins) or 0
    RCfg.SpoofWinRate = tonumber(RCfg.SpoofWinRate or RCfg.winrate) or 0
    RCfg.SpoofELO = tonumber(RCfg.SpoofELO or RCfg.elo) or 0
    RCfg.SpoofIcon = tostring(RCfg.SpoofIcon or RCfg.icon or "")
    -- color + rainbow: short keys win the same way so picking a color or rainbow
    -- after a white sync actually takes effect instead of being shadowed.
    if RCfg.colorR ~= nil and tonumber(RCfg.colorR) ~= nil then
        RCfg.SpoofNameColorR = math.clamp(math.floor(tonumber(RCfg.colorR)), 0, 255);
    elseif RCfg.SpoofNameColorR == nil then
        RCfg.SpoofNameColorR = 255;
    end;
    if RCfg.colorG ~= nil and tonumber(RCfg.colorG) ~= nil then
        RCfg.SpoofNameColorG = math.clamp(math.floor(tonumber(RCfg.colorG)), 0, 255);
    elseif RCfg.SpoofNameColorG == nil then
        RCfg.SpoofNameColorG = 255;
    end;
    if RCfg.colorB ~= nil and tonumber(RCfg.colorB) ~= nil then
        RCfg.SpoofNameColorB = math.clamp(math.floor(tonumber(RCfg.colorB)), 0, 255);
    elseif RCfg.SpoofNameColorB == nil then
        RCfg.SpoofNameColorB = 255;
    end;
    if RCfg.rainbow ~= nil then
        RCfg.rainbowEnabled = (RCfg.rainbow == true);
    elseif RCfg.rainbowEnabled == nil then
        RCfg.rainbowEnabled = false;
    end;
    if RCfg.SpoofDisplayName == nil then
        RCfg.SpoofDisplayName = (RCfg.spoofDisplay ~= false)
    end
    if RCfg.SpoofUsername == nil then
        RCfg.SpoofUsername = (RCfg.spoofUser ~= false)
    end
    -- keep short keys mirrored so UI + engine stay aligned
    RCfg.display = RCfg.SettingsDisplay
    RCfg.user = RCfg.SettingsUser
    RCfg.level = RCfg.SettingsLevel
    RCfg.streak = RCfg.SettingsStreak
    RCfg.rank = RCfg.SettingsRank
end
RIV_SyncCfg()
RIV_REAL_NAME    = local_player.Name
RIV_REAL_DISPLAY = local_player.DisplayName ~= "" and local_player.DisplayName or local_player.Name
_RIV_spoofHB     = nil
_RIV_spoofCC     = nil


function RIV_CleanSpoof()
    if _RIV_spoofHB then pcall(function() _RIV_spoofHB:Disconnect() end) _RIV_spoofHB = nil end
    if _RIV_spoofCC then pcall(function() _RIV_spoofCC:Disconnect() end) _RIV_spoofCC = nil end
    if getgenv()._HubV3SpoofAttr then
        pcall(function() getgenv()._HubV3SpoofAttr:Disconnect() end)
        getgenv()._HubV3SpoofAttr = nil
    end
    if getgenv()._HubSpoofDesc then
        pcall(function() getgenv()._HubSpoofDesc:Disconnect() end)
        getgenv()._HubSpoofDesc = nil
    end
    if getgenv()._HubSpoofKey then
        pcall(function() getgenv()._HubSpoofKey:Disconnect() end)
        getgenv()._HubSpoofKey = nil
    end
end


-- persisted in getgenv so a re-execute still recognizes fakes applied by the
-- previous run (otherwise old fake labels become orphans you can never change)
_RIV_lastFakeDisplay = getgenv()._HubV3LastFakeD or ""
_RIV_lastFakeUser    = getgenv()._HubV3LastFakeU or ""


function RIV_FakeUserTag()
    RIV_SyncCfg()
    if RCfg.SpoofUsername == false then return nil end
    local u = tostring(RCfg.SettingsUser or "")
    if u ~= "" then return "@" .. u end
    return nil
end


function RIV_IsOwnName(t)
    if t == RIV_REAL_NAME or t == RIV_REAL_DISPLAY
        or t == ("@" .. RIV_REAL_NAME) or t == ("@" .. RIV_REAL_DISPLAY) then
        return true
    end
    -- also match fakes applied by an earlier pass (user edited the name twice)
    if _RIV_lastFakeDisplay ~= "" and (t == _RIV_lastFakeDisplay or t == ("@" .. _RIV_lastFakeDisplay)) then
        return true
    end
    if _RIV_lastFakeUser ~= "" and (t == "@" .. _RIV_lastFakeUser or t == _RIV_lastFakeUser) then
        return true
    end
    return false
end


-- replacement that preserves @-handle form (display/user fully separate)
function RIV_FakeFor(t)
    if type(t) ~= "string" or t == "" then return t end
    RIV_SyncCfg()
    if t:sub(1, 1) == "@" then
        return RIV_FakeUserTag() or t
    end
    local d = tostring(RCfg.SettingsDisplay or "")
    if RCfg.SpoofDisplayName ~= false and d ~= "" then
        return d
    end
    return t
end


-- Username lock: spoof off = every @-label of yours reads @RIV_REAL_NAME,
-- even ones the game natively renders as @DisplayName. Others untouched.
function RIV_LockUsernameSweep()
    if RCfg.SpoofUsername ~= false then return end
    pcall(function()
        local mg = local_player.PlayerGui:FindFirstChild("MainGui")
        if not mg then return end
        for _, d in ipairs(mg:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local t = d.Text
                if type(t) == "string" and t:sub(1, 1) == "@"
                    and RIV_IsOwnName(t) and t ~= ("@" .. RIV_REAL_NAME) then
                    d.Text = "@" .. RIV_REAL_NAME
                end
            end
        end
    end)
end


function RIV_SpoofColorCustom()
    if RCfg.rainbowEnabled or RCfg.rainbow then return true end;
    return (RCfg.SpoofNameColorR or 255) ~= 255
        or (RCfg.SpoofNameColorG or 255) ~= 255
        or (RCfg.SpoofNameColorB or 255) ~= 255
end


-- Paint pass: recolors labels currently showing YOUR fake forms (exact
-- handle, exact display, display + rank badge). Runs at the end of every
-- spoof pass + instant rewrite, so game repaints never stick.
function RIV_SpoofPaintPass()
    if not RIV_SpoofColorCustom() then return end
    local fd = tostring(RCfg.SettingsDisplay or "")
    local fu = tostring(RCfg.SettingsUser or "")
    if fd == "" and fu == "" then return end
    local col = Color3.fromRGB(RCfg.SpoofNameColorR or 255, RCfg.SpoofNameColorG or 255, RCfg.SpoofNameColorB or 255)
    if RCfg.rainbowEnabled or RCfg.rainbow then
        col = Color3.fromHSV((tick() * 0.25) % 1, 0.8, 1);
    end;
    pcall(function()
        local roots = {}
        local mg = local_player.PlayerGui and local_player.PlayerGui:FindFirstChild("MainGui")
        if mg then table.insert(roots, mg) end
        if local_player.Character then table.insert(roots, local_player.Character) end
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    local t = tostring(d.Text or "")
                    local hit = false
                    if fu ~= "" and t == "@" .. fu then hit = true end
                    if not hit and fd ~= "" then
                        if t == fd then hit = true end
                    end
                    if not hit and fd ~= "" then
                        local okM = false
                        pcall(function()
                            local esc = fd:gsub("(%W)", "%%%1")
                            okM = string.match(t, "^" .. esc .. " ◆ ") ~= nil
                        end)
                        if okM then hit = true end
                    end
                    if hit then
                        pcall(function() d.TextColor3 = col end)
                    end
                end
            end
        end
    end)
end


-- Player icon, actually fixed: the attribute stomp alone never repainted
-- the slot image (the game resolves it once at build). We discover the real
-- icon art at runtime (exact name first, then contains) and repaint YOUR
-- slot's icon ImageLabel every pass.
function RIV_SpoofIconImage(key)
    key = tostring(key or "")
    if key == "" then return nil end
    local cache = getgenv()._HubIconCache
    if type(cache) ~= "table" then cache = {} getgenv()._HubIconCache = cache end
    if cache[key] ~= nil then return cache[key] or nil end
    if (getgenv()._HubIconScanAt or 0) + 5 > tick() then return nil end
    getgenv()._HubIconScanAt = tick()
    local hit = nil
    local kl = string.lower(key)
    pcall(function()
        for pass = 1, 2 do
            if hit then break end
            local scanned = 0
            for _, root in ipairs({ replicated_storage, local_player.PlayerGui }) do
                if hit then break end
                local okD, desc = pcall(function() return root:GetDescendants() end)
                if okD and type(desc) == "table" then
                    for _, d in ipairs(desc) do
                        scanned += 1
                        if scanned > 3000 then break end
                        if hit then break end
                        local okC, cls = pcall(function() return d.ClassName end)
                        if okC and (cls == "ImageLabel" or cls == "ImageButton" or cls == "Decal") then
                            local img = nil
                            pcall(function()
                                img = (cls == "Decal") and d.Texture or d.Image
                            end)
                            if type(img) == "string" and img ~= "" then
                                local nm = ""
                                pcall(function() nm = string.lower(d.Name or "") end)
                                if pass == 1 and nm == kl then hit = img end
                                if pass == 2 and nm ~= "" and string.find(nm, kl, 1, true) then hit = img end
                            end
                        end
                    end
                end
                if scanned > 3000 then break end
            end
        end
    end)
    if hit then cache[key] = hit end
    return hit
end


function RIV_SpoofIconApply()
    if (RCfg.SpoofIcon or "") == "" then return end
    local img = RIV_SpoofIconImage(RCfg.SpoofIcon)
    if not img then return end
    pcall(function()
        local mg = local_player.PlayerGui:FindFirstChild("MainGui")
        if not mg then return end
        for _, slot in ipairs(mg:GetDescendants()) do
            if slot.Name == "PlayerListSlot" and slot:IsA("Frame") then
                local ownSlot = false
                for _, c in ipairs(slot:GetDescendants()) do
                    if c:IsA("TextLabel") and c.Name == "Title" and RIV_IsOwnName(c.Text) then
                        ownSlot = true
                        break
                    end
                end
                if ownSlot then
                    for _, c in ipairs(slot:GetDescendants()) do
                        local isIcon = false
                        pcall(function()
                            isIcon = (c:IsA("ImageLabel") or c:IsA("ImageButton"))
                                and string.find(string.lower(c.Name or ""), "icon", 1, true) ~= nil
                        end)
                        if isIcon then
                            pcall(function()
                                if c.Image ~= img then c.Image = img end
                            end)
                        end
                    end
                end
            end
        end
    end)
end


function RIV_SpoofPlayerSlot()
    local mg = local_player.PlayerGui:FindFirstChild("MainGui")
    if not mg then return end
    for _, slot in ipairs(mg:GetDescendants()) do
        if not (slot.Name == "PlayerListSlot" and slot:IsA("Frame")) then continue end
        -- scop check: is this YOUR slot? (name title matches your real/fake forms)
        local ownSlot = false
        for _, c in ipairs(slot:GetDescendants()) do
            if c:IsA("TextLabel") and c.Name == "Title" and RIV_IsOwnName(c.Text) then
                ownSlot = true
                break
            end
        end
        if not ownSlot then continue end
        for _, c in ipairs(slot:GetDescendants()) do
            if not c:IsA("TextLabel") then continue end
            if c.Name == "Title" then
                pcall(function()
                    if RIV_IsOwnName(c.Text) then
                        c.Text = RIV_FakeFor(c.Text)
                    end
                end)
            elseif c.Name == "Streak" or c.Name == "WinStreak" then
                -- your fake streak, only ever inside your own slot
                pcall(function()
                    if (tonumber(RCfg.SettingsStreak) or 0) > 0 then
                        c.Text = tostring(RCfg.SettingsStreak)
                    end
                end)
            elseif c.Name == "Level" or c.Name == "LevelValue" or c.Name == "LevelText" or c.Name == "Lvl" then
                -- your fake level, only ever inside your own slot
                pcall(function()
                    if (tonumber(RCfg.SettingsLevel) or 0) > 0 then
                        c.Text = tostring(RCfg.SettingsLevel)
                    end
                end)
            elseif c.Name == "Title" and string.find(c:GetFullName(), "Leaderstat", 1, true) then
                -- leaderboard streak cell (RIVALS names it Leaderstat.Title)
                pcall(function()
                    if RCfg.SettingsStreak > 0 then
                        c.Text = tostring(RCfg.SettingsStreak)
                    end
                end)
            end
        end
    end
end


-- Spectate bar: MainFrame.BottomStack.Spectate.Container.Username (@handle)
-- and .Player (display). The old build never touched these, so your real
-- @name sat visible the whole match.
function RIV_SpoofSpectate()
    local mg = local_player.PlayerGui:FindFirstChild("MainGui")
    if not mg then return end
    local sp = mg:FindFirstChild("Spectate", true)
    if not (sp and sp:IsA("GuiObject")) then return end
    for _, c in ipairs(sp:GetDescendants()) do
        if not c:IsA("TextLabel") then continue end
        pcall(function()
            if c.Name == "Username" and RIV_IsOwnName(c.Text) then
                local tag = RIV_FakeUserTag()
                if tag then c.Text = tag end
            elseif c.Name == "Player" then
                -- rank badge rides next to your name (re-applied, never stacks:
                -- the old badge is stripped before matching)
                local base = tostring(c.Text):gsub(" ◆ .*$", "")
                if RIV_IsOwnName(base) then
                    local nt = RIV_FakeFor(base)
                    if RCfg.SettingsRank ~= "" and RCfg.SettingsRank ~= "Off" then
                        nt = nt .. " ◆ " .. RCfg.SettingsRank
                    end
                    c.Text = nt
                end
            elseif RIV_IsOwnName(c.Text) then
                c.Text = RIV_FakeFor(c.Text)
            end
        end)
    end
end


-- Elimination feed (DuelInterface...EliminationFeedSlot...Eliminator TextLabel)
function RIV_SpoofFeed()
    local mg = local_player.PlayerGui:FindFirstChild("MainGui")
    if not mg then return end
    local feed = mg:FindFirstChild("EliminationFeed", true)
    if not feed then return end
    for _, c in ipairs(feed:GetDescendants()) do
        if (c:IsA("TextLabel") or c:IsA("TextButton")) and RIV_IsOwnName(c.Text) then
            pcall(function() c.Text = RIV_FakeFor(c.Text) end)
        end
    end
end


-- Own profile page (ViewProfile frame): rewrites your @handle + display there
-- too, so the page never shows the real username. Only own forms are touched,
-- other players' names are left alone.
-- Fake rank: post-duel results screen shows your ELO shifting
-- (LeftRank = old, RightRank = new). Rewrites both while that screen is up.
-- Scoped to FinalResults only, so nobody else's text is touched.
function RIV_SpoofRank()
    if RCfg.SettingsRank == "" then return end
    local mg = local_player.PlayerGui:FindFirstChild("MainGui")
    if not mg then return end
    local fr = mg:FindFirstChild("FinalResults", true)
    if not fr then return end
    for _, c in ipairs(fr:GetDescendants()) do
        if c:IsA("TextLabel") and (c.Name == "LeftRank" or c.Name == "RightRank") then
            pcall(function() c.Text = RCfg.SettingsRank end)
        end
    end
end


function RIV_SpoofProfile()
    local mg = local_player.PlayerGui:FindFirstChild("MainGui")
    if not mg then return end
    local vp = mg:FindFirstChild("ViewProfile", true)
    if not (vp and vp:IsA("GuiObject")) then return end
    for _, c in ipairs(vp:GetDescendants()) do
        if (c:IsA("TextLabel") or c:IsA("TextButton")) and RIV_IsOwnName(c.Text) then
            pcall(function() c.Text = RIV_FakeFor(c.Text) end)
        end
    end
    -- your fake level on your own profile only; never when viewing someone else
    local viewing = false;
    pcall(function() viewing = getgenv().IsViewingOther and getgenv().IsViewingOther() == true end);
    if not viewing and (tonumber(RCfg.SettingsLevel) or 0) > 0 then
        for _, c in ipairs(vp:GetDescendants()) do
            if c:IsA("TextLabel") then
                local n = "";
                pcall(function() n = tostring(c.Name or "") end);
                if n == "Level" or n == "LevelValue" or n == "LevelText" or n == "Lvl" then
                    pcall(function() c.Text = tostring(RCfg.SettingsLevel) end);
                end;
            end;
        end;
    end;
end


function RIV_SpoofInspect()
    local mg = local_player.PlayerGui:FindFirstChild("MainGui")
    if not mg then return end
    local insp = mg:FindFirstChild("Inspect", true)
    if not insp then return end
    for _, c in ipairs(insp:GetDescendants()) do
        if not c:IsA("TextLabel") then continue end
        if c.Name == "DisplayName" and RCfg.SettingsDisplay ~= ""
            and RCfg.SpoofDisplayName ~= false then
            pcall(function()
                local t = c.Text
                if t:find(RIV_REAL_DISPLAY, 1, true) or t:find(RIV_REAL_NAME, 1, true) then
                    t = t:gsub(RIV_REAL_DISPLAY:gsub("%W", "%%%1"), RCfg.SettingsDisplay)
                    t = t:gsub(RIV_REAL_NAME:gsub("%W", "%%%1"),    RCfg.SettingsDisplay)
                    c.Text = t
                end
            end)
        end
        if c.Name == "Username" and RCfg.SettingsUser ~= ""
            and RCfg.SpoofUsername ~= false then
            pcall(function()
                if c.Text == "@" .. RIV_REAL_NAME or c.Text == "@" .. RIV_REAL_DISPLAY then
                    c.Text = "@" .. RCfg.SettingsUser
                end
            end)
        end
        if (c.Name == "Level" or c.Name == "LevelValue" or c.Name == "LevelText" or c.Name == "Lvl")
            and (tonumber(RCfg.SettingsLevel) or 0) > 0 then
            local viewing = false;
            pcall(function() viewing = getgenv().IsViewingOther and getgenv().IsViewingOther() == true end);
            if not viewing then
                pcall(function() c.Text = tostring(RCfg.SettingsLevel) end);
            end;
        end
    end
end


_RIV_spoofPassCount = 0


-- Instant spoof: rewrites your own labels the same frame they spawn,
-- so opening Profile (ESC) never flashes the real username first.
-- Display and @handle are fully independent ??" each applies on its own.
function RIV_SpoofInstant(inst)
    if not inst then return end
    local isLbl = inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")
    if isLbl then
        local t = inst.Text
        if type(t) == "string" and t ~= "" and RIV_IsOwnName(t) then
            pcall(function() inst.Text = RIV_FakeFor(t) end)
        end
        RIV_SpoofPaintPass()
        return
    end
    if inst:IsA("Frame") or inst:IsA("ScrollingFrame") or inst:IsA("Folder") or inst:IsA("Model") then
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                local t = d.Text
                if type(t) == "string" and t ~= "" and RIV_IsOwnName(t) then
                    pcall(function() d.Text = RIV_FakeFor(d.Text) end)
                end
            end
        end
    end
    RIV_SpoofPaintPass()
end


function RIV_RunSpoofPass()
    RIV_SyncCfg()
    if RCfg.SpoofDisplayName == false then
        -- display spoof off: hands off AND restore real display props
        pcall(function() local_player.DisplayName = RIV_REAL_DISPLAY end)
        pcall(function()
            local ch = local_player.Character
            local h = ch and ch:FindFirstChildOfClass("Humanoid")
            if h then h.DisplayName = RIV_REAL_DISPLAY end
        end)
    elseif RCfg.SettingsDisplay ~= "" then
        pcall(function() local_player.DisplayName = RCfg.SettingsDisplay end)
        local ch = local_player.Character
        if ch then
            local h = ch:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h.DisplayName = RCfg.SettingsDisplay end) end
            for _, d in ipairs(ch:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextBox")) and RIV_IsOwnName(d.Text) then
                    pcall(function() d.Text = RIV_FakeFor(d.Text) end)
                end
            end
        end
    end
    if (tonumber(RCfg.SettingsLevel) or 0) > 0 then
        pcall(function() local_player:SetAttribute("Level", RCfg.SettingsLevel) end)
    end
    if RCfg.SettingsStreak > 0 then
        pcall(function() local_player:SetAttribute("StatisticDuelsWinStreak", RCfg.SettingsStreak) end)
    end
    if (tonumber(RCfg.SpoofWins) or 0) > 0 then
        pcall(function() local_player:SetAttribute("Wins", RCfg.SpoofWins) end)
    end
    if (tonumber(RCfg.SpoofWinRate) or 0) > 0 then
        pcall(function() local_player:SetAttribute("WinRate", RCfg.SpoofWinRate) end)
    end
    if (tonumber(RCfg.SpoofELO) or 0) > 0 then
        pcall(function()
            local_player:SetAttribute("ELO", RCfg.SpoofELO)
            local_player:SetAttribute("DisplayELO", RCfg.SpoofELO)
        end)
    end
    if tostring(RCfg.SpoofIcon or "") ~= "" then
        pcall(function()
            local_player:SetAttribute("PlayerIcon", RCfg.SpoofIcon)
            local_player:SetAttribute("Icon", RCfg.SpoofIcon)
        end)
    end
    RIV_SpoofPlayerSlot()
    RIV_SpoofSpectate()
    RIV_SpoofFeed()
    RIV_SpoofProfile()
    RIV_SpoofRank()
    RIV_SpoofInspect()
    RIV_LockUsernameSweep()
    RIV_SpoofPaintPass()
    RIV_SpoofIconApply()
    _RIV_lastFakeDisplay = RCfg.SettingsDisplay
    _RIV_lastFakeUser    = RCfg.SettingsUser
    getgenv()._HubV3LastFakeD = RCfg.SettingsDisplay
    getgenv()._HubV3LastFakeU = RCfg.SettingsUser
    -- core_gui sweep (chat bubbles etc) throttled: every ~8th pass, not every tick
    _RIV_spoofPassCount += 1
    if RCfg.SettingsDisplay ~= "" and _RIV_spoofPassCount % 8 == 1 then
        pcall(function()
            for _, d in ipairs(core_gui:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextBox")) and RIV_IsOwnName(d.Text) then
                    d.Text = RIV_FakeFor(d.Text)
                end
            end
            RIV_SpoofPaintPass()
        end)
    end
end


function RIV_ApplySpoofing()
    RIV_CleanSpoof()
    RIV_SyncCfg()
    local noOp = RCfg.SettingsDisplay == "" and RCfg.SettingsUser == ""
        and (tonumber(RCfg.SettingsStreak) or 0) == 0 and (tonumber(RCfg.SettingsLevel) or 0) <= 1
        and (RCfg.SettingsRank == nil or RCfg.SettingsRank == "")
        and (RCfg.SpoofWins or 0) <= 0 and (RCfg.SpoofWinRate or 0) <= 0
        and (RCfg.SpoofELO or 0) <= 0
        and (RCfg.SpoofIcon or "") == ""
        and not RIV_SpoofColorCustom()
        and not (RCfg.rainbowEnabled or RCfg.rainbow)
    if noOp then return end
    local function RIV_SpoofBurst() -- ESC/TAB: 3 rapid passes catch async rebuilds, no flash --
        pcall(function() RIV_RunSpoofPass() end)
        task.delay(0.03, function() pcall(function() RIV_RunSpoofPass() end) end)
        task.delay(0.1, function() pcall(function() RIV_RunSpoofPass() end) end)
        pcall(function()
            local mg = local_player.PlayerGui and local_player.PlayerGui:FindFirstChild("MainGui")
            if mg then
                local vp = mg:FindFirstChild("ViewProfile", true)
                if vp then RIV_SpoofInstant(vp) end
                local pl = mg:FindFirstChild("PlayerList", true)
                if pl then RIV_SpoofInstant(pl) end
                RIV_SpoofFeed() RIV_SpoofProfile() RIV_SpoofSpectate()
            end
        end)
    end
    getgenv()._HubSpoofBurst = RIV_SpoofBurst
    local acc = 0
    _RIV_spoofHB = run_service.Heartbeat:Connect(function(dt)
        acc += dt
        -- LAGFIX: 20Hz full-MainGui sweeps = the execute/minute-long hitch
        -- on big servers. instant-hooks + bursts already cover opens;
        -- 3Hz steady-state keeps fakes without the freeze.
        if acc >= 0.3 then acc = 0 RIV_RunSpoofPass() end
    end)
    -- continuous: any Text property change on own labels gets rewritten same frame
    pcall(function()
        if getgenv()._HubSpoofTextConn then return end
        local pg = local_player.PlayerGui
        if not pg then return end
        getgenv()._HubSpoofTextConn = pg.DescendantAdded:Connect(function(inst)
            if not (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then return end
            pcall(function()
                inst:GetPropertyChangedSignal("Text"):Connect(function()
                    if RCfg.SettingsDisplay == "" and RCfg.SettingsUser == "" then return end
                    local t = inst.Text
                    if type(t) == "string" and t ~= "" and RIV_IsOwnName(t) then
                        pcall(function() inst.Text = RIV_FakeFor(t) end)
                    end
                end)
            end)
            RIV_SpoofInstant(inst)
        end)
        -- also hook existing labels once
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                pcall(function()
                    d:GetPropertyChangedSignal("Text"):Connect(function()
                        if RCfg.SettingsDisplay == "" and RCfg.SettingsUser == "" then return end
                        local t = d.Text
                        if type(t) == "string" and t ~= "" and RIV_IsOwnName(t) then
                            pcall(function() d.Text = RIV_FakeFor(t) end)
                        end
                    end)
                end)
            end
        end
    end)
    pcall(function() -- ESC opens profile, TAB opens list: pre-spoof same frame, before render --
        if not getgenv()._HubSpoofKey then
            getgenv()._HubSpoofKey = uis.InputBegan:Connect(function(inp, gpe)
                if inp.KeyCode == Enum.KeyCode.Escape or inp.KeyCode == Enum.KeyCode.Tab then
                    if RCfg.SettingsDisplay ~= "" or RCfg.SettingsUser ~= "" then RIV_SpoofBurst() task.delay(0.05, function() pcall(function() RIV_SpoofBurst() end) end) end
                end
            end)
        end
    end)
    -- instant: any label the game spawns (profile, leaderboard, feed)
    -- gets rewritten before it ever renders a frame with your real name
    pcall(function()
        local pg = local_player.PlayerGui
        if pg and not getgenv()._HubSpoofDesc then
            getgenv()._HubSpoofDesc = pg.DescendantAdded:Connect(function(inst)
                if RCfg.SettingsDisplay == "" and RCfg.SettingsUser == "" then return end
                RIV_SpoofInstant(inst)
            end)
        end
    end)
    _RIV_spoofCC = local_player.CharacterAdded:Connect(function(c)
        task.wait(0.5)
        local h = c:WaitForChild("Humanoid", 5)
        if h and RCfg.SettingsDisplay ~= "" and RCfg.SpoofDisplayName ~= false then
            pcall(function() h.DisplayName = RCfg.SettingsDisplay end)
        end
    end)
    -- attribute guard: the server re-stomps Level/Streak/etc with real values.
    -- this re-asserts ours the same tick it happens. Same-value writes don't
    -- refire, so it terminates instead of looping.
    getgenv()._HubV3SpoofAttr = local_player.AttributeChanged:Connect(function()
        pcall(function()
            if RCfg.SettingsLevel > 0 then local_player:SetAttribute("Level", RCfg.SettingsLevel) end
            if RCfg.SettingsStreak > 0 then local_player:SetAttribute("StatisticDuelsWinStreak", RCfg.SettingsStreak) end
            if (RCfg.SpoofWins or 0) > 0 then local_player:SetAttribute("Wins", RCfg.SpoofWins) end
            if (RCfg.SpoofWinRate or 0) > 0 then local_player:SetAttribute("WinRate", RCfg.SpoofWinRate) end
            if (RCfg.SpoofELO or 0) > 0 then
                local_player:SetAttribute("ELO", RCfg.SpoofELO)
                local_player:SetAttribute("DisplayELO", RCfg.SpoofELO)
            end
            if RCfg.SpoofIcon ~= "" then
                local_player:SetAttribute("PlayerIcon", RCfg.SpoofIcon)
                local_player:SetAttribute("Icon", RCfg.SpoofIcon)
            end
        end)
    end)
    RIV_RunSpoofPass()
end
getgenv().RIV_Apply = RIV_ApplySpoofing;
getgenv().RIV_Clear = function()
    RCfg.display = ''; RCfg.user = ''; RCfg.streak = 0; RCfg.level = 1; RCfg.rank = '';
    RCfg.colorR, RCfg.colorG, RCfg.colorB = 255, 255, 255;
    RCfg.rainbow, RCfg.rainbowEnabled = false, false;
    RCfg.SettingsDisplay, RCfg.SettingsUser, RCfg.SettingsRank = '', '', '';
    RCfg.SettingsLevel, RCfg.SettingsStreak = 0, 0;
    RCfg.SpoofNameColorR, RCfg.SpoofNameColorG, RCfg.SpoofNameColorB = 255, 255, 255;
    RIV_CleanSpoof();
    pcall(function() local_player.DisplayName = RIV_REAL_DISPLAY end);
    local ch = local_player.Character;
    if ch then local h = ch:FindFirstChildOfClass('Humanoid') if h then pcall(function() h.DisplayName = RIV_REAL_DISPLAY end) end; end;
    pcall(function()
        local mg = local_player.PlayerGui:FindFirstChild('MainGui');
        if mg then for _, d in ipairs(mg:GetDescendants()) do
            if (d:IsA('TextLabel') or d:IsA('TextButton')) and RIV_IsOwnName(d.Text) then
                if d.Text:sub(1,1) == '@' then d.Text = '@' .. RIV_REAL_NAME else d.Text = RIV_REAL_NAME end;
            end;
        end; end;
    end);
    _RIV_lastFakeDisplay = ''; _RIV_lastFakeUser = '';
end;
end; -- rivals spoof locals
end; -- _RivalsSpoofLoaded guard
-- == /RIVALS SPOOFER TRANSPLANT ==


-- == RIVALS FINISHER ENGINE TRANSPLANT (control + canonical + ragdoll, elisium-wired) ==
if not getgenv()._RivalsFinLoaded then
getgenv()._RivalsFinLoaded = true;
ELI.rivfin = ELI.rivfin or { FinishForce = false, FinishForceName = '', FinishRagdoll = 'Finisher Default', FinishRagdollTime = 2.5, FinishFling = 40 };
getgenv().RivalsHubCfg = ELI.rivfin; -- transplanted _PlayFinisher hook reads FinishForce/FinishForceName here
local function RIVF_Notify(text, secs, kind) pcall(function() Library:Notify(text, secs or 3) end) end;
local function RIVF_SetDropdown(flag, values)
    local o = getgenv().Options and getgenv().Options[flag];
    if not o then return false end;
    if type(values) ~= 'table' or #values == 0 then values = { '...' } end;
    o.Values = values;
    pcall(function() o:SetValues() end);
    return true;
end;
-- Live catalog: Finishers folder + CosmeticLibrary Type=="Finisher".
function hubFinisherNames()
    local out, seen = {}, {}
    local function push(nm)
        nm = tostring(nm or "")
        if nm ~= "" and nm ~= "MISSING_FINISHER" and not seen[nm] then
            seen[nm] = true
            table.insert(out, nm)
        end
    end
    pcall(function()
        local mods = replicated_storage:FindFirstChild("Modules")
        local f = mods and mods:FindFirstChild("Finishers")
        if f then
            for _, c in ipairs(f:GetChildren()) do push(c.Name) end
        end
    end)
    pcall(function()
        local mods = replicated_storage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        for name, info in pairs(all) do
            if type(info) == "table" and tostring(info.Type or "") == "Finisher" then
                push(name)
            end
        end
    end)
    pcall(function()
        local spec = getgenv()._HubFinSpec
        if type(spec) == "table" then
            for nm in pairs(spec) do
                if string.sub(nm, 1, 1) ~= "@" then push(nm) end
            end
        end
    end)
    -- pool merge: substring-matched + folder entries the checks above miss
    pcall(function()
        for _, nm in ipairs(hubFinisherPool()) do push(nm) end
    end)
    table.sort(out)
    return out
end


-- Deep reader for the game's REAL finisher features (replicated_storage >
-- Modules > Finishers): per-finisher duration, stages, ragdoll + fling
-- hints. Whatever shape each entry has (ModuleScript table, folder of
-- values, attributes), the spec normalizes it. Cached for the session.
function hubFinisherInspect()
    local spec = getgenv()._HubFinSpec
    if type(spec) ~= "table" then spec = {} getgenv()._HubFinSpec = spec end
    local function put(name)
        name = tostring(name or "")
        if name == "" or name == "MISSING_FINISHER" then return nil end
        spec[name] = spec[name] or {}
        return spec[name]
    end
    local function grabNum(t, keys)
        for _, k in ipairs(keys) do
            local v = t[k]
            if type(v) == "number" then return v end
            if type(v) == "string" then
                local n = tonumber(v:match("([%d%.]+)"))
                if n then return n end
            end
        end
        return nil
    end
    local function learn(name, tbl, rawKeys)
        local s = put(name)
        if not s then return end
        if type(tbl) == "table" then
            local d = grabNum(tbl, { "Duration", "duration", "Length", "length", "Time", "time", "TotalTime", "SequenceTime" })
            if d and d > 0 and d < 60 then s.duration = d end
            for _, k in ipairs({ "Ragdoll", "ragdoll", "RagdollEnabled", "UseRagdoll", "Physics", "physics" }) do
                if tbl[k] ~= nil then s.ragdoll = (tbl[k] and true or false) break end
            end
            for _, k in ipairs({ "Fling", "fling", "Launch", "launch", "Knockback", "knockback", "Velocity", "velocity", "Force", "force", "Power", "power" }) do
                local fv = tbl[k]
                if typeof(fv) == "Vector3" then s.fling = fv break end
                if type(fv) == "number" and fv ~= 0 then s.flingPower = fv break end
            end
            for _, k in ipairs({ "Stages", "stages", "Steps", "steps", "Phases", "phases", "Parts", "parts" }) do
                if type(tbl[k]) == "table" then
                    local c = 0
                    for _ in pairs(tbl[k]) do c += 1 end
                    s.stages = c
                    break
                end
            end
        end
        if type(rawKeys) == "table" then
            s.keys = table.concat(rawKeys, ","):sub(1, 220)
        end
    end
    pcall(function()
        local mods = replicated_storage:FindFirstChild("Modules")
        if not mods then return end
        local f = mods:FindFirstChild("Finishers")
        if f then
            for _, c in ipairs(f:GetChildren()) do
                local keys = {}
                local okIsMod, isMod = pcall(function() return c:IsA("ModuleScript") end)
                if okIsMod and isMod then
                    local okM, lib = pcall(require, c)
                    if okM and type(lib) == "table" then
                        for k in pairs(lib) do
                            if #keys < 40 then table.insert(keys, tostring(k)) end
                        end
                        learn(c.Name, lib, keys)
                    else
                        learn(c.Name, nil, keys)
                    end
                else
                    local vals = {}
                    pcall(function()
                        for _, d in ipairs(c:GetDescendants()) do
                            if #keys < 40 then table.insert(keys, d.ClassName .. ":" .. tostring(d.Name)) end
                            if d:IsA("NumberValue") or d:IsA("IntValue") then vals[d.Name] = d.Value
                            elseif d:IsA("StringValue") then vals[d.Name] = d.Value
                            elseif d:IsA("BoolValue") then vals[d.Name] = d.Value end
                        end
                        for a, v in pairs(c:GetAttributes()) do vals[a] = v end
                    end)
                    learn(c.Name, vals, keys)
                end
            end
        end
        -- a Ragdoll driver module rides next to Finishers on some builds
        for _, c in ipairs(mods:GetChildren()) do
            local nm = ""
            pcall(function() nm = string.lower(c.Name or "") end)
            if string.find(nm, "ragdoll", 1, true) then
                local okM, lib = pcall(require, c)
                if okM and type(lib) == "table" then
                    local keys = {}
                    for k in pairs(lib) do if #keys < 40 then table.insert(keys, tostring(k)) end end
                    getgenv()._HubRagdollKeys = table.concat(keys, ","):sub(1, 220)
                end
            end
        end
    end)
    return spec
end


-- Canonical finisher name: exact folder hit first, then case-insensitive,
-- then the inspected spec. Returns nil when the game doesn't know it, so
-- overrides never rename your finisher into something ignored.
function hubFinisherCanonical(name)
    local want = tostring(name or "")
    if want == "" then return nil end
    local hit = nil
    pcall(function()
        local mods = replicated_storage:FindFirstChild("Modules")
        local f = mods and mods:FindFirstChild("Finishers")
        if f then
            local exact = f:FindFirstChild(want)
            if exact then hit = exact.Name
            else
                local wl = string.lower(want)
                for _, c in ipairs(f:GetChildren()) do
                    if string.lower(c.Name) == wl then hit = c.Name break end
                end
            end
        end
    end)
    if not hit then
        pcall(function()
            local spec = getgenv()._HubFinSpec
            if type(spec) == "table" then
                if spec[want] then hit = want
                else
                    local wl = string.lower(want)
                    for nm in pairs(spec) do
                        if string.lower(nm) == wl then hit = nm break end
                    end
                end
            end
        end)
    end
    return hit
end


function hubDiagnoseFinishers()
    hubFinisherInspect()
    local rep = {}
    pcall(function()
        local spec = getgenv()._HubFinSpec or {}
        local n = 0
        for _ in pairs(spec) do n += 1 end
        table.insert(rep, "finishers:" .. n)
        if getgenv()._HubRagdollKeys then
            table.insert(rep, "ragdollmod:" .. tostring(getgenv()._HubRagdollKeys):sub(1, 120))
        end
        local names = {}
        for nm in pairs(spec) do table.insert(names, nm) end
        table.sort(names)
        for _, nm in ipairs(names) do
            if #rep > 24 then table.insert(rep, "...") break end
            local s = spec[nm]
            table.insert(rep, nm .. " dur=" .. tostring(s.duration or "?")
                .. " stages=" .. tostring(s.stages or "?")
                .. " ragdoll=" .. tostring(s.ragdoll))
        end
    end)
    local txt = table.concat(rep, "\n")
    warn("[Hub] finishers:\n" .. txt)
    pcall(function() Library:Notify("Finisher spec in console (F9)", 3) end)
    local lbl = getgenv()._HubFinList
    if lbl then pcall(function() lbl:SetText(txt:sub(1, 600)) end) end
end


function hubRefreshFinishers()
    local names = hubFinisherNames()
    if #names == 0 then names = { "Ragdoll", "OOF", "Collapse" } end
    RIVF_SetDropdown("FinishForceName", names)
    local cur = tostring(ELI.rivfin.FinishForceName or "")
    local stillThere = false
    for _, n in ipairs(names) do
        if n == cur then stillThere = true break end
    end
    local o = getgenv().Options and getgenv().Options.FinishForceName
    if o and not stillThere and names[1] then
        pcall(function() o:SetValue(names[1]) end)
    end
    local lbl = getgenv()._HubFinList
    if lbl then pcall(function() lbl:SetText(table.concat(names, "\n"):sub(1, 600)) end) end
end


-- Victim-body control after YOUR finisher lands. Modes:
-- "Finisher Default" = hands off, the finisher owns the body.
-- Ragdoll / Stiff / Freeze / Fling = hub holds the body that way.
function hubFinishRagdoll(victimModel, finisherName)
    local mode = ELI.rivfin.FinishRagdoll or "Finisher Default"
    if mode == "Finisher Default" or not victimModel then return end
    getgenv()._HubLastFinish = { name = tostring(finisherName or "?"), t = tick() }
    task.spawn(function()
        pcall(function()
            local hum = victimModel:FindFirstChildOfClass("Humanoid")
            local root = victimModel:FindFirstChild("HumanoidRootPart")
            local holdT = math.clamp(ELI.rivfin.FinishRagdollTime or 2.5, 0.5, 10)
            -- start the hold as the game's own sequence winds down (read off
            -- the inspected finisher length), so hub control never fights
            -- the finisher's opening
            pcall(function()
                local spec = getgenv()._HubFinSpec or {}
                local s = spec[tostring(finisherName or "")]
                local d = s and tonumber(s.duration) or 0
                if d and d > 0 then task.wait(math.clamp(d * 0.6, 0.25, 3)) end
            end)
            if mode == "Freeze" then
                for _, d in ipairs(victimModel:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Anchored = true
                    end
                end
                task.wait(holdT)
                for _, d in ipairs(victimModel:GetDescendants()) do
                    if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                        d.Anchored = false
                    end
                end
                if root then root.Anchored = false end
            elseif mode == "Stiff" then
                if hum then hum.PlatformStand = true end
                task.wait(holdT)
                if hum and hum.Health > 0 then hum.PlatformStand = false end
            else -- Ragdoll / Fling: physics state + optional launch
                if hum then
                    hum:ChangeState(Enum.HumanoidStateType.Physics)
                end
                if mode == "Fling" and root then
                    local pwr = ELI.rivfin.FinishFling or 40
                    local away = Vector3.new(0, 1, 0)
                    local myRoot = local_player.Character and local_player.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local d = root.Position - myRoot.Position
                        d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude > 0.5 then away = d.Unit + Vector3.new(0, 0.9, 0) end
                    end
                    pcall(function()
                        local spec = getgenv()._HubFinSpec or {}
                        local s = spec[tostring(finisherName or "")]
                        if s then
                            if typeof(s.fling) == "Vector3" and s.fling.Magnitude > 0.1 then
                                away = s.fling.Magnitude > 1 and s.fling or s.fling.Unit * pwr
                            elseif tonumber(s.flingPower) then
                                pwr = math.clamp(tonumber(s.flingPower), 5, 300)
                            end
                        end
                    end)
                    root.AssemblyLinearVelocity = away.Unit * pwr
                    root.AssemblyAngularVelocity = Vector3.new(pwr * 0.2, 0, pwr * 0.2)
                end
                task.wait(holdT)
                if hum and hum.Health > 0 then
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end)
    end)
    RIVF_Notify("Finisher: " .. tostring(finisherName or "?") .. " (" .. mode .. ")", 2, "kill")
end

-- LAGFIX: requiring every finisher ModuleScript compiled them all at boot
-- = minutes-long freeze. now strictly on-demand via reload/diagnose buttons.
-- the force-name dropdown fills the first time you open it.
pcall(function() hubRefreshFinishers() end);
end; -- _RivalsFinLoaded guard
