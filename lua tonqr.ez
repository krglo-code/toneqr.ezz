            -- FIXED-CD-LEAK: ragebot used to force W.no_cd_all = true on enable
            -- = warhorn/sniper/etc lost cooldown with nothing toggled on.
            -- FIXED: rage aims + fires only, never touches cooldown state.
            local W = ELI.weapons;
            -- FIXED-CD-LEAK: no force, no mirror. weapons toggles keep own state.
            if W then
                -- instant zero on flip-on so first shot is already clean
                -- (only if user already has a cd toggle on, else skip)
                if v then pcall(function()
                    local lf = fighter_controller.LocalFighter;
                    if lf then _eliPatchLF(lf, tick(), W) end;
