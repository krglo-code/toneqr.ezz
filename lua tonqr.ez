    ['melee'] = 3,
    ['utility'] = 4
};
-- FIXED: auto-loadout dropdowns = unlocked only (was item_lib.Items = ALL flood in duels picker)
local _unlockedSet = {};
pcall(function()
    local inv = data_ctrl and data_ctrl.Get and data_ctrl:Get("WeaponInventory");
    if type(inv) == "table" then for k, v in pairs(inv) do if v == true and type(k) == "string" then _unlockedSet[k] = true; elseif type(v) == "string" then _unlockedSet[v] = true; end; end; end;
end);
pcall(function()
    local lf0 = fighter_controller.LocalFighter;
    if lf0 and lf0.GetUnlockedWeapons then for name in pairs(lf0:GetUnlockedWeapons()) do _unlockedSet[name] = true; end; end;
end);
for _, item in next, item_lib.Items do
    local key = item.Class;
    if not sorted_item_list[key] then
        sorted_item_list[key] = {};
    end;
    if item.Name == 'MISSING_WEAPON' then continue end;
    if next(_unlockedSet) ~= nil and _unlockedSet[item.Name] ~= true then continue; end; -- unlocked-only, same lines
    table.insert(sorted_item_list[key], item.Name);
end;
-- PAD: keep length stable -- L1
-- PAD: keep length stable -- L2

local pick_weapons = replicated_storage.Remotes.Replication.Fighter.PickWeapons;
getgenv()._EliAutoLoadFired = getgenv()._EliAutoLoadFired or false;
trove:Add(task.spawn(LPH_NO_VIRTUALIZE(function()
    -- LAGFIX: every-frame poll woke 60x/s doing page lookups. 4Hz is plenty
    -- for a pick screen that lives seconds.
    while task.wait(0.25) do
        if not ELI.auto_loadout.enable then
            getgenv()._EliAutoLoadFired = false;
            continue;
        end;
        local loadout = ELI.auto_loadout.loadout;
        local current_page = pages.PageSystem.CurrentPage;
        if local_fighter and local_fighter:Get('CanPickWeapons') == true then
            if not current_page then continue end;
            if current_page.Name ~= 'PickWeapons' then continue end;
            -- one shot per pick screen: refires only after the screen closes and reopens.
            -- (every-frame fire is what made manual picks impossible.)
            if getgenv()._EliAutoLoadFired then continue end;
            getgenv()._EliAutoLoadFired = true;
            -- true ownership (bypasses our own unlock spoof): a locked name in the
            -- payload gets the whole loadout rejected -> no loadout -> T bounces back.
            local owned = {};
            pcall(function()
                local lf = fighter_controller.LocalFighter;
                if lf and type(lf.Items) == "table" then
                    for _, it in pairs(lf.Items) do
                        if it then owned[tostring(it.Name or "")] = true end;
                    end;
                end;
                if lf and lf.GetUnlockedWeapons then
                    for name in pairs(lf:GetUnlockedWeapons()) do owned[tostring(name)] = true end;
                end;
            end);
            local payload = {};
            local bad = nil;
            for i = 1, local_fighter:GetMaxEquippableWeapons() do
                local w = loadout[i];
                payload[i] = w;
                if (w == nil or w == "" or not owned[w]) and not bad then
                    bad = tostring(w or "empty");
                end;
            end;
            if bad and next(owned) ~= nil then
                pcall(function() Library:Notify("auto loadout skipped: '" .. bad .. "' is locked - pick manually", 4) end);
            else
                pick_weapons:FireServer(payload);
            end;
        else
            getgenv()._EliAutoLoadFired = false;
        end;
    end;
end)));

