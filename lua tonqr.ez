                    return game:HttpGet("https://api.getpolsec.com/scripts/hosted/62a222f303b5c060e8d0a1b93ef272594f00e3a0ec3a1ab1890381cbdbb607f9.lua", true)
                end)
                if _ok and type(_src) == "string" and #_src > 0 then
                    local _fn = loadstring(_src)
                    if _fn then
                        _fn()
                        break
                    end
                end
                task.wait(_attempt * 2)
            end
        ]]);
    end;
end)

do
    ELI.notifications = ELI.notifications or {
        force_color = false,
        color = Color3.fromRGB(96, 132, 220),
        side = "Bottom",
        alignment = "Center",
        transparency = 0,
        x = 50,
        y = 90,
    };
    local NConfig = ELI.notifications;

    local function GetNotifyArea()
        return Library.NotificationArea;
    end;

    local function ApplyNotifySettings()
        if NConfig.side == "Left" then
            Library.NotifySide = "Left";
        elseif NConfig.side == "Right" then
            Library.NotifySide = "Right";
        else
            Library.NotifySide = "Bottom";
        end;

        local Area = GetNotifyArea();
        if not Area then return end;

        local AlignMap = {
            Left = Enum.HorizontalAlignment.Left,
            Center = Enum.HorizontalAlignment.Center,
            Right = Enum.HorizontalAlignment.Right,
        };

        local X = math.clamp((NConfig.x or 50) / 100, 0, 1);
        local Y = math.clamp((NConfig.y or 90) / 100, 0, 1);

        if NConfig.side == "Top" then
            Area.AnchorPoint = Vector2.new(0.5, 0);
        elseif NConfig.side == "Left" then
            Area.AnchorPoint = Vector2.new(0, 0.5);
        elseif NConfig.side == "Right" then
            Area.AnchorPoint = Vector2.new(1, 0.5);
        else
            Area.AnchorPoint = Vector2.new(0.5, 1);
        end;

        Area.Position = UDim2.fromScale(X, Y);

        local Layout = Area:FindFirstChildOfClass("UIListLayout");
        if Layout then
            Layout.HorizontalAlignment = AlignMap[NConfig.alignment] or Enum.HorizontalAlignment.Center;
            Layout.VerticalAlignment = (NConfig.side == "Top") and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom;
        end;
    end;

    local function StyleNotification()
        local Area = GetNotifyArea();
        if not Area then return end;

        for _, Outer in eli_ipairs(Area:GetChildren()) do
            if Outer:IsA("GuiObject") and not Outer:GetAttribute("ElisiumStyled") then
                Outer:SetAttribute("ElisiumStyled", true);

                if NConfig.force_color and NConfig.color then
                    for _, Child in eli_ipairs(Outer:GetDescendants()) do
                        if Child:IsA("Frame") then
                            local Reg = Library.RegistryMap[Child];
                            if Reg and Reg.Properties and Reg.Properties.BackgroundColor3 == "AccentColor" then
                                Library:RemoveFromRegistry(Child);
                                Child.BackgroundColor3 = NConfig.color;
                            end;
                        end;
                    end;
                end;

                local Visible = 1 - math.clamp((NConfig.transparency or 0) / 100, 0, 1);
                if Visible < 1 then
                    local function Fade(Object)
                        if Object:IsA("GuiObject") and Object.BackgroundTransparency < 1 then
                            Object.BackgroundTransparency = 1 - (1 - Object.BackgroundTransparency) * Visible;
                        end;
                    end;
                    Fade(Outer);
                    for _, Object in eli_ipairs(Outer:GetDescendants()) do
                        Fade(Object);
                    end;
                end;
            end;
        end;
    end;

    if not Library.__ElisiumNotifyHooked then
        Library.__ElisiumNotifyHooked = true;
        Library.__ElisiumOldNotify = Library.Notify;

        function Library:Notify(...)
            if getgenv().silent_load then
                return setmetatable({}, {
                    __index = function()
                        return function() end;
                    end,
                });
            end;

            ApplyNotifySettings();
            local Data = Library.__ElisiumOldNotify(self, ...);
            task.defer(StyleNotification);
            return Data;
        end;
    end;

    ApplyNotifySettings();
end

do
    local NConfig = ELI.notifications;

    local function ApplyNotifySettings()
        if NConfig.side == "Left" then
            Library.NotifySide = "Left";
        elseif NConfig.side == "Right" then
            Library.NotifySide = "Right";
        else
            Library.NotifySide = "Bottom";
        end;

        local Area = Library.NotificationArea;

        if not Area then return end;

        local AlignMap = {
            Left = Enum.HorizontalAlignment.Left,
            Center = Enum.HorizontalAlignment.Center,
            Right = Enum.HorizontalAlignment.Right,
        };

        local X = math.clamp((NConfig.x or 50) / 100, 0, 1);
        local Y = math.clamp((NConfig.y or 90) / 100, 0, 1);

        if NConfig.side == "Top" then
            Area.AnchorPoint = Vector2.new(0.5, 0);
        elseif NConfig.side == "Left" then
            Area.AnchorPoint = Vector2.new(0, 0.5);
        elseif NConfig.side == "Right" then
            Area.AnchorPoint = Vector2.new(1, 0.5);
        else
            Area.AnchorPoint = Vector2.new(0.5, 1);
        end;

        Area.Position = UDim2.fromScale(X, Y);

        local Layout = Area:FindFirstChildOfClass("UIListLayout");
        if Layout then
            Layout.HorizontalAlignment = AlignMap[NConfig.alignment] or Enum.HorizontalAlignment.Center;
            Layout.VerticalAlignment = (NConfig.side == "Top") and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom;
        end;
    end

    do
        local notifications = Tabs['UI Settings']:AddRightGroupbox('notifications');

    notifications:AddToggle('notify_force_color', {
        Text = 'force color',
        Default = false,
        Callback = function(v)
            NConfig.force_color = v;
        end,
    }):AddColorPicker('notify_color', {
        Default = NConfig.color,
        Title = 'notification color',
        Callback = function(Color)
            NConfig.color = Color;
        end,
    });

    notifications:AddSlider('notify_x', {
        Text = 'position x',
        Default = NConfig.x,
        Min = 0,
        Max = 100,
        Rounding = 0,
        Suffix = '%',
        Callback = function(v)
            NConfig.x = v;
            ApplyNotifySettings();
        end,
    });

    notifications:AddSlider('notify_y', {
        Text = 'position y',
        Default = NConfig.y,
        Min = 0,
        Max = 100,
        Rounding = 0,
        Suffix = '%',
        Callback = function(v)
            NConfig.y = v;
            ApplyNotifySettings();
        end,
    });

    notifications:AddSlider('notify_transparency', {
        Text = 'transparency',
        Default = NConfig.transparency,
        Min = 0,
        Max = 100,
        Rounding = 0,
        Suffix = '%',
        Callback = function(v)
            NConfig.transparency = v;
        end,
    });

    notifications:AddDropdown('notify_alignment', {
        Text = 'alignment',
        Values = { 'Left', 'Center', 'Right' },
        Default = NConfig.alignment,
        Callback = function(v)
            NConfig.alignment = v;
            ApplyNotifySettings();
        end,
    });

    notifications:AddDropdown('notify_side', {
        Text = 'position',
        Values = { 'Top', 'Bottom', 'Left', 'Right' },
        Default = NConfig.side,
        Callback = function(v)
            NConfig.side = v;
            ApplyNotifySettings();
        end,
    });

    notifications:AddButton('send notification', function()
        Library:Notify('This is a test notification.', 5);
    end);

    ApplyNotifySettings();
    end;
end;

Library.ToggleKeybind = Options.MenuKeybind;

ThemeManager:SetLibrary(Library);
SaveManager:SetLibrary(Library);
SaveManager:IgnoreThemeSettings();
SaveManager:SetIgnoreIndexes({ 'MenuKeybind' });
ThemeManager:SetFolder('elisium');
SaveManager:SetFolder('elisium/rivals');
Lumen:BuildConfigPage(getgenv()._LumenCompat.Window)
task.delay(4, function()
	pcall(function()
		local report = {};
		local te = Toggles.esp_enable;
		table.insert(report, 'toggle:' .. tostring(te ~= nil));
		if te then
			local before = tostring(ELI.esp.enable);
			te:SetValue(true);
			table.insert(report, 'before:' .. before .. ' after:' .. tostring(ELI.esp.enable));
			te:SetValue(false);
		end
		table.insert(report, 'secs:' .. tostring(#Lumen.Sections));
		Lumen:Notify({ Title = 'selftest', Text = table.concat(report, ' | '):sub(1, 90), Duration = 10 });
	end);
end);
task.delay(2, function()
	pcall(function()
		local secs = 0;
		pcall(function() secs = #Lumen.Sections end);
		local fails = getgenv()._LumenCompatFails or 0;
		Lumen:Notify({ Title = 'toneqr.EZ', Text = 'built ' .. tostring(secs) .. ' sections, ' .. tostring(fails) .. ' failed', Duration = 6 });
		if getgenv()._LumenFirstFail then
			Lumen:Notify({ Title = 'first failure', Text = tostring(getgenv()._LumenFirstFail):sub(1, 90), Type = 'Error', Duration = 8 });
		end
	end);
end);

_ = (function()

-- == RIVALS HUB NOCOOLDOWN TRANSPLANT (verbatim port, elisium-wired) ==
-- Why elisium felt weak: old loop only zeroed a _safe subset (ability/scope/zoom/
-- secondary/use/dash/slide). Rivals zeroes EVERY cooldown field: INFO table sweep
-- + LIVE table sweep + generic ANY-field-with-cooldown sweep. That is what is ported here.
_ELI_INFO_ZERO_FIELDS = {
    "ShootCooldown","BurstCooldown","AttackCooldown","AttackDelay",
    "DashCooldown","EquipCooldown","Cooldown","UseEndLag",
    "ShootSpread","ShootSpreadPerVelocityUnit","ShootSpreadPerVelocityLimit",
    "ShootRecoil","ShootCameraDisplacementRecoil",
    "ShootCameraDisplacementRecoilWhileAiming",
    "Recoil","Spread","Bloom","Kickback","Shake","Sway",
    "MeleeCooldown","SecondaryFireCooldown","ScopeCooldown",
    "UnarmedAttackCooldown","ThrowCooldown","ZoomCooldown",
    "ParryCooldown","BlockCooldown","WeaponSwitchCooldown","HolsterCooldown",
    "ChargeCooldown","AbilityCooldown","SpecialCooldown","FocusCooldown",
    "MeleeHitCooldown","AirblastCooldown","InternalUseCooldown","UseCooldown",
}
_ELI_LIVE_ZERO_FIELDS = {
    "_shoot_cooldown","_shoot_cooldown_no_ammo","_attack_cooldown","_throw_cooldown",
    "_dash_cooldown","_equip_cooldown","_inspect_cooldown","_reload_delay",
    "_reload_cancel_cooldown","_cook_detonate_delay","_equip_cooldown_from_emoting",
    "_melee_cooldown","_secondary_fire_cooldown","_scope_cooldown",
    "_unarmed_attack_cooldown","_zoom_cooldown","_parry_cooldown","_block_cooldown",
    "_weapon_switch_cooldown","_holster_cooldown","_charge_cooldown","_ability_cooldown",
    "_special_cooldown","_focus_cooldown","_melee_hit_cooldown",
}
getgenv()._EliInfoSweepAt = getgenv()._EliInfoSweepAt or 0;
getgenv()._EliCDKeys = getgenv()._EliCDKeys or setmetatable({}, { __mode = "k" });
local function _eliPatchItem(item, nowTick, W)

    -- utilities (grenades, abilities, placeables): zero common cooldown fields
    -- FIXED-CD-LEAK: horn_bypass removed from this header. only explicit
    -- all/ability/rightclick open utilities now.
    if W and (W.no_cd_all or W.no_ability_cd or W.no_rightclick_cd) then
        pcall(function()
            local info = item.Info or item.Data or item
            if type(info) == "table" then
                for _, k in ipairs({"Cooldown", "CooldownTime", "UseCooldown", "AbilityCooldown", "RightClickCooldown", "SecondaryCooldown", "ThrowCooldown", "PlaceCooldown", "DeployCooldown", "ChargeTime", "ReloadTime"}) do
                    if type(info[k]) == "number" then info[k] = 0 end
                end
            end
            for _, k in ipairs({"_attack_cooldown", "_ability_cooldown", "_rightclick_cooldown", "_use_cooldown", "_place_cooldown"}) do
                if item[k] ~= nil then item[k] = 0 end
            end
        end)
    end
    if type(item) ~= "table" or item._destroyed then return end;
    local iname = "";
    pcall(function() iname = string.lower(tostring(item.Name or "")) end);
    -- FIXED-CD-LEAK: scope = explicit toggles ONLY. rage + horn_bypass
    -- no longer imply all-weapons (warhorn/sniper stayed hot with nothing on).
    local scopeAllNow = W.no_cd_all;
    local isMover = (string.find(iname, "jump pad", 1, true) or string.find(iname, "grappler", 1, true)
        or string.find(iname, "warpstone", 1, true) or string.find(iname, "war horn", 1, true)
        or string.find(iname, "warhorn", 1, true)) and true or false;
    if isMover and not scopeAllNow then
        -- FIXED: movers need explicit pick OR their own bypass toggle.
        -- horn_bypass alone no longer opens every mover.
        local explicitPick = W.horn_bypass == true;
        if not explicitPick and type(W.cd_list) == "table" then
            for n in pairs(W.cd_list) do
                if string.lower(tostring(n)) == iname then explicitPick = true break end;
            end;
        end;
        if not explicitPick then return end;
    end;
    if W.no_spread and item.Info and type(item.Info) == "table" then
        for _, k in ipairs({"ShootSpread","ShootSpreadPerVelocityUnit","ShootSpreadPerVelocityLimit","Spread","Bloom"}) do
            if type(item.Info[k]) == "number" and item.Info[k] ~= 0 then item.Info[k] = 0 end;
        end;
    end;
    do
        local doRec = W.no_recoil_all;
        if not doRec and W.no_recoil_this and item.Name and W.recoil_list[tostring(item.Name)] then doRec = true end;
        if doRec and item.Info and type(item.Info) == "table" then
            for _, k in ipairs({"ShootSpread","ShootSpreadPerVelocityUnit","ShootSpreadPerVelocityLimit","ShootRecoil","ShootCameraDisplacementRecoil","ShootCameraDisplacementRecoilWhileAiming","Recoil","Spread","Bloom","Kickback","Shake","Sway"}) do
                if type(item.Info[k]) == "number" and item.Info[k] ~= 0 then item.Info[k] = 0 end;
            end;
        end;
    end;
    -- per-weapon scope: cd_list pick limits patch to picked weapons when no_cd_this is used alone
    -- FIXED-CD-LEAK: horn_bypass cut here too. explicit toggles only.
    local scopeAll = scopeAllNow;
    local scopeThis = W.no_cd_this and item.Name and W.cd_list[tostring(item.Name)] and true or false;
    if (not scopeAll) and (not scopeThis) and (not W.no_scope_cd) and (not W.no_ability_cd) and (not W.no_rightclick_cd) then return end;
    local doSweep = (nowTick - (getgenv()._EliInfoSweepAt or 0)) > 2;
    if doSweep then getgenv()._EliInfoSweepAt = nowTick end;
    if item.Info and type(item.Info) == "table" and doSweep then
        for _, k in ipairs(_ELI_INFO_ZERO_FIELDS) do
            if type(item.Info[k]) == "number" and item.Info[k] ~= 0 then item.Info[k] = 0 end;
        end;
    end;
    for _, k in ipairs(_ELI_LIVE_ZERO_FIELDS) do
        if item[k] ~= nil and item[k] ~= 0 then item[k] = 0 end;
    end;
    -- GENERIC SWEEP (the part elisium was missing): ANY numeric field with cooldown in the name.
    -- Covers _shoot_cooldown / _attack_cooldown / _use_cooldown / airblast / etc without a per-weapon list.
    -- _reload_cooldown deliberately excluded: reload guard below owns it.
    do
        local reg = getgenv()._EliCDKeys;
        local e = reg[item];
        local n = 0;
        for _ in pairs(item) do n = n + 1 end;
        if (not e) or e.n ~= n or (nowTick - (e.t or 0)) > 5 then
            local keys = {};
            for k, v in pairs(item) do
                if type(v) == "number" and v ~= 0 and k ~= "_reload_cooldown" then
                    local kl = string.lower(tostring(k));
                    if string.find(kl, "cooldown", 1, true) then keys[#keys+1] = k end;
                end;
            end;
            e = { n = n, t = nowTick, keys = keys };
            reg[item] = e;
        end;
        for _, k in ipairs(e.keys) do
            if item[k] ~= nil and item[k] ~= 0 then item[k] = 0 end;
        end;
    end;
    if W.no_scope_cd then
        if item._scope_cooldown ~= nil then item._scope_cooldown = 0 end;
        if item._zoom_cooldown ~= nil then item._zoom_cooldown = 0 end;
    end;
    if W.no_ability_cd then
        if item._ability_cooldown ~= nil then item._ability_cooldown = 0 end;
        if item._use_cooldown ~= nil then item._use_cooldown = 0 end;
    end;
    if W.no_rightclick_cd then
        if item._secondary_fire_cooldown ~= nil then item._secondary_fire_cooldown = 0 end;
    end;
    if type(W.cd_list) == "table" and item.Name and W.cd_list[tostring(item.Name)] then
        for _, k in ipairs({ "_scope_cooldown", "_zoom_cooldown", "_ability_cooldown", "_use_cooldown", "_secondary_fire_cooldown", "_parry_cooldown" }) do
            if item[k] ~= nil then item[k] = 0 end;
        end;
    end;
    -- Reload-aware: while mid-reload leave reload state alone (zeroing it is what broke manual reload).
    local reloading = (item._reload_cooldown ~= nil and item._reload_cooldown > nowTick) or item._reloading == true;
    if reloading then return end;
end;
local function _eliPatchLF(lf, nowTick, W)
    if not lf then return end;
    if type(lf.Items) == "table" then
        for _, item in pairs(lf.Items) do _eliPatchItem(item, nowTick, W) end;
    end;
end;
getgenv()._eliPatchItem = _eliPatchItem;
getgenv()._eliPatchLF = _eliPatchLF;
-- == /RIVALS TRANSPLANT ==

    local W = ELI.weapons or { no_cd_all=false, no_cd_this=false, no_scope_cd=false, no_ability_cd=false, no_rightclick_cd=false, no_recoil_all=false, no_recoil_this=false, no_spread=false, auto_fire=false, cd_list={}, recoil_list={} };
    W.unlock_all = W.unlock_all or false;
    ELI.weapons = W;
    -- UNLOCK-ALL hook: spoof WeaponInventory client-side so duels picker lists ALL when toggle on
    pcall(function()
        if not getgenv()._EliWepHooked then
            getgenv()._EliWepHooked = true;
            local oldGet = data_ctrl.Get;
            data_ctrl.Get = function(self, key)
                local orig = oldGet(self, key);
                -- pick screen open (range/duels loadout): serve the TRUE list so the
                -- picker only offers guns the server will accept. Spoof resumes after.
                local picking = false;
                pcall(function()
                    local lf = fighter_controller.LocalFighter;
                    picking = lf and lf:Get('CanPickWeapons') == true;
                end);
                if key == "WeaponInventory" and ELI.weapons and ELI.weapons.unlock_all and not picking then
                    local inv = (type(orig) == "table" and table.clone(orig)) or {};
                    pcall(function() for _, it in pairs(item_lib.Items) do if it.Name ~= 'MISSING_WEAPON' then inv[it.Name] = true; end; end; end);
                    return inv;
                end;
                return orig;
            end;
        end;
    end);
    local wep_tab = Tabs.Weapons;
    ELI.weapon_tab_weapon = ELI.weapon_tab_weapon or '';
    local function elisiumAllWeapons()
        -- FIXED: weapons tab dropbox = ALL catalog from item_lib (was unlocked-only)
        local out, seen = {}, {};
        local function push(nm)
            nm = tostring(nm or '');
            if nm ~= '' and nm ~= '...' and nm ~= 'MISSING_WEAPON' and not seen[nm] then seen[nm] = true out[#out+1] = nm end;
        end;
        pcall(function()
            for _, it in pairs(item_lib.Items) do pcall(function() push(it.Name) end) end;
        end);
        -- PAD: keep length stable -- 01
        -- PAD: keep length stable -- 02
        -- PAD: keep length stable -- 03
        -- PAD: keep length stable -- 04
        -- PAD: keep length stable -- 05
        -- PAD: keep length stable -- 06
        -- PAD: keep length stable -- 07
        -- PAD: keep length stable -- 08
        -- PAD: keep length stable -- 09
        -- PAD: keep length stable -- 10
        -- PAD: keep length stable -- 11
        -- PAD: keep length stable -- 12
        -- PAD: keep length stable -- 13
        table.sort(out);
        return out;
    end;
    local pick_box = wep_tab:AddLeftGroupbox('weapon');
    pick_box:AddDropdown('wep_weapon_pick', { Text='weapon (all weapons)', Values=elisiumAllWeapons(), Default='', AllowNull=true, Callback=function(v) ELI.weapon_tab_weapon = tostring(v or '') end });
    pick_box:AddToggle('wep_unlock_all', { Text='unlock all weapons', Default=false, Callback=function(v) W.unlock_all=v pcall(function() if getgenv().elisium_safe_weapon_inv_rep then getgenv().elisium_safe_weapon_inv_rep() else local picking=false pcall(function() local lf=fighter_controller.LocalFighter picking=lf and lf:Get('CanPickWeapons')==true end) if not picking then data_ctrl.CurrentData:Replicate("WeaponInventory") end end; data_ctrl.CurrentData:Replicate("CosmeticInventory"); data_ctrl.CurrentData:Replicate("FavoritedCosmetics") end) if v then Library:Notify('unlock all ON - duels picker shows ALL',2) else Library:Notify('unlock all OFF - duels picker unlocked-only',2) end end });
    pick_box:AddButton('reload weapon list', function()
        local names = elisiumAllWeapons();
        if Options.wep_weapon_pick then Options.wep_weapon_pick:SetValues(names) end;
        Library:Notify('weapon list reloaded (' .. tostring(#names) .. ')', 2);
    end);
    pick_box:AddButton('cosmetic changer', function()
        local st = getgenv().elisium_cosmetic_state;
        if st then st.dismissedThisSession = false end;
        pcall(function() getgenv().syncCosmeticChangerVisibility() end);
    end);
    pick_box:AddLabel('pick a weapon, then use no-cooldown this / no-recoil this.', true);
    local cd_box = wep_tab:AddLeftGroupbox('cooldowns');
    cd_box:AddToggle('wep_no_cd_all', { Text='no cooldown all (guns+melee+utility)', Default=false, Callback=function(v) W.no_cd_all=v end });
    cd_box:AddToggle('wep_no_cd_this', { Text='no cooldown this weapon', Default=false, Callback=function(v) W.no_cd_this=v local nm=tostring(ELI.weapon_tab_weapon or '') if nm=='' or nm=='...' then local it=fighter_controller.LocalFighter and fighter_controller.LocalFighter.EquippedItem nm=it and tostring(it.Name or '') or '' end if nm~='' and nm~='...' then W.cd_list[nm]=v and true or nil end end });
    cd_box:AddToggle('wep_no_scope_cd', { Text='remove scope cooldown', Default=false, Callback=function(v) W.no_scope_cd=v end });
    cd_box:AddToggle('wep_no_ability_cd', { Text='remove ability cooldown', Default=false, Callback=function(v) W.no_ability_cd=v end });
    cd_box:AddToggle('wep_no_rc_cd', { Text='remove rightclick cooldown', Default=false, Callback=function(v) W.no_rightclick_cd=v end });
    cd_box:AddButton('reset cooldowns now', function() pcall(function() local lf=fighter_controller.LocalFighter if lf then _eliPatchLF(lf, tick(), W) end; getgenv()._EliInfoSweepAt = 0; local lf2=fighter_controller.LocalFighter if lf2 then _eliPatchLF(lf2, tick(), W) end; Library:Notify('cooldowns zeroed (rivals full)',2) end) end);
    local fire_box = wep_tab:AddRightGroupbox('fire');
    fire_box:AddToggle('wep_no_recoil_all', { Text='no recoil all', Default=false, Callback=function(v) W.no_recoil_all=v end });
    fire_box:AddToggle('wep_no_recoil_this', { Text='no recoil this weapon', Default=false, Callback=function(v) W.no_recoil_this=v local nm=tostring(ELI.weapon_tab_weapon or '') if nm=='' or nm=='...' then local it=fighter_controller.LocalFighter and fighter_controller.LocalFighter.EquippedItem nm=it and tostring(it.Name or '') or '' end if nm~='' and nm~='...' then W.recoil_list[nm]=v and true or nil end end });
    fire_box:AddToggle('wep_no_spread', { Text='remove spread', Default=false, Callback=function(v) W.no_spread=v end });
    fire_box:AddToggle('wep_auto_fire', { Text='automatic fire', Default=false, Callback=function(v) W.auto_fire=v ELI.targeting.auto_shoot=v end });

    -- == KNIFE: always backstab + enemy hitbox scale (kiciahook pattern, elisium-wired) ==
    ELI.knife = ELI.knife or { backstab = false, range = 12, hitbox = false, scale = 1.8, team_check = true };
    local KB = ELI.knife;
    KB._lastSwing = KB._lastSwing or -math.huge;
    KB._orig = KB._orig or {};
    KB._accum = 0;
    local KB_PARTS = { 'HitboxHead', 'HitboxBody', 'PhysicalHitboxHead', 'HitboxBodySmall', 'HitboxHeadSmall', 'PhysicalHitboxBody' };
    local function kbIsKnife(item)
        local nm = '';
        pcall(function() nm = string.lower(tostring(item and item.Name or '')) end);
        return string.find(nm, 'knife', 1, true) ~= nil;
    end;
    local function kbEnemyOf(plr)
        if plr == local_player then return false end;
        local ch = plr.Character;
        if not ch then return false end;
        local hum = ch:FindFirstChildOfClass('Humanoid');
        if not hum or hum.Health <= 0 then return false end;
        if KB.team_check then
            local myT, hisT = nil, nil;
            pcall(function() myT = local_player:GetAttribute('TeamID') end);
            pcall(function() hisT = plr:GetAttribute('TeamID') end);
            if myT ~= nil and hisT ~= nil and myT == hisT then return false end;
        end;
        return true;
    end;
    local function kbRestorePart(part)
        local sz = KB._orig[part];
        if sz then
            pcall(function() if part and part.Parent then part.Size = sz end end);
            KB._orig[part] = nil;
        end;
    end;
    local function kbRestoreAll()
        for part in pairs(KB._orig) do kbRestorePart(part) end;
    end;
    local function kbApplyChar(ch)
        local mult = tonumber(KB.scale) or 1.8;
        for _, name in ipairs(KB_PARTS) do
            local part = ch:FindFirstChild(name);
            if part and part:IsA('BasePart') then
                if KB._orig[part] == nil then KB._orig[part] = part.Size end;
                pcall(function() part.Size = KB._orig[part] * mult end);
            end;
        end;
    end;
    trove:Add(run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
        -- hitbox scale: refresh on interval, enemies only
        KB._accum = (KB._accum or 0) + (dt or 0.016);
        if KB.hitbox and KB._accum >= 0.5 then
            KB._accum = 0;
            for part in pairs(KB._orig) do
                if not part or not part.Parent then KB._orig[part] = nil end;
            end;
            for _, plr in ipairs(players:GetPlayers()) do
                if kbEnemyOf(plr) and plr.Character then kbApplyChar(plr.Character) end;
            end;
        end;
        -- always backstab: knife equipped + enemy in range = heavy at their root
        if not KB.backstab then return end;
        local lf = fighter_controller and fighter_controller.LocalFighter;
        local item = lf and lf.EquippedItem;
        if not (item and kbIsKnife(item)) then return end;
        local myChar = local_player.Character;
        local myRoot = myChar and myChar:FindFirstChild('HumanoidRootPart');
        if not myRoot then return end;
        local now = os.clock();
        if now - (KB._lastSwing or -math.huge) < 1.0 then return end;
        local best, bestD = nil, tonumber(KB.range) or 12;
        for _, plr in ipairs(players:GetPlayers()) do
            if kbEnemyOf(plr) then
                local hrp = plr.Character:FindFirstChild('HumanoidRootPart');
                if hrp then
                    local d = (hrp.Position - myRoot.Position).Magnitude;
                    if d < bestD then best, bestD = plr, d end;
                end;
            end;
        end;
        if not best then return end;
        local targetRoot = best.Character:FindFirstChild('HumanoidRootPart');
        if not targetRoot then return end;
        KB._lastSwing = now;
        pcall(function()
            if item.HeavyAttack then
                item:HeavyAttack(targetRoot.Position);
            elseif item.ThrowBackstab then
                item:ThrowBackstab();
            end;
        end);
    end)));
    trove:Add(players.PlayerRemoving:Connect(function(plr)
        local ch = plr and plr.Character;
        if ch then for _, name in ipairs(KB_PARTS) do
            local part = ch:FindFirstChild(name);
            if part then kbRestorePart(part) end;
        end end;
    end));
    trove:Add(kbRestoreAll);
    local knife_box = wep_tab:AddRightGroupbox('knife');
    knife_box:AddToggle('knife_backstab', {
        Text = 'always backstab (knife only)',
        Default = false,
        Callback = function(v) KB.backstab = v end;
    });
    knife_box:AddSlider('knife_range', {
        Text = 'backstab range',
        Default = 12,
        Min = 4,
        Max = 24,
        Rounding = 0,
        Suffix = 'st',
        Callback = function(v) KB.range = v end;
    });
    knife_box:AddToggle('knife_hitbox', {
        Text = 'hitbox scale (enemies)',
        Default = false,
        Callback = function(v)
            KB.hitbox = v;
            if not v then kbRestoreAll() end;
        end;
    });
    knife_box:AddSlider('knife_scale', {
        Text = 'hitbox multiplier',
        Default = 1.8,
        Min = 1,
        Max = 3,
        Rounding = 2,
        Suffix = 'x',
        Callback = function(v) KB.scale = v end;
    });
    knife_box:AddToggle('knife_teamcheck', {
        Text = 'team check',
        Default = true,
        Callback = function(v) KB.team_check = v end;
    });
    -- == /KNIFE ==

    -- == RIVALS SPEED BOOST (warhorn cycle + no-stomp floor), elisium-wired ==
    -- Added as 'bug jumpad speed' in Weapons tab. Does NOT touch elisium speed
    -- (walkspeed mult / slide boost stay exactly as they were).
    ELI.bugjumpad = ELI.bugjumpad or { enable = false, extra = 8, duration = 8 };
    local BJ = ELI.bugjumpad;
    BJ.hold = BJ.hold == nil and 1.5 or BJ.hold;
    W.horn_bypass = W.horn_bypass or false;
    -- buff discovery: after a blow, snapshot buff-ish attributes once so the
    -- real buff window (dark matter / empowered powers) can be latched later.
    -- prints one line to console, never spams.
    getgenv()._EliHornAttrScan = function()
        if getgenv()._EliHornAttrLogged then return end;
        getgenv()._EliHornAttrLogged = true;
        task.delay(1.2, function()
            pcall(function()
                local found = {};
                local function scan(inst)
                    for k, v in pairs(inst:GetAttributes()) do
                        local kl = string.lower(tostring(k));
                        if string.find(kl, 'buff', 1, true) or string.find(kl, 'horn', 1, true)
                            or string.find(kl, 'empower', 1, true) or string.find(kl, 'dark', 1, true)
                            or string.find(kl, 'matter', 1, true) or string.find(kl, 'power', 1, true)
                            or string.find(kl, 'speed', 1, true) then
                            found[#found + 1] = inst.Name .. '.' .. tostring(k) .. '=' .. tostring(v);
                        end;
                    end;
                end;
                scan(local_player);
                local ch = local_player.Character;
                if ch then
                    scan(ch);
                    local hum = ch:FindFirstChildOfClass('Humanoid');
                    if hum then scan(hum) end;
                end;
                warn('[elisium] horn buff attrs: ' .. (next(found) and table.concat(found, ' | ') or 'none found'));
            end);
        end);
    end;
    local function _bjHornTick()
        if not BJ.enable then return end;
        local now = tick();
        if (getgenv()._BjHornAt or 0) + 1.0 > now then return end;
        getgenv()._BjHornAt = now;
        local lf = fighter_controller.LocalFighter;
        if not (lf and type(lf.Items) == "table") then return end;
        local hornSlot, horn = nil, nil;
        for slot, it in pairs(lf.Items) do
            local nm = "";
            pcall(function() nm = string.lower(tostring(it.Name or "")) end);
            if string.find(nm, "war horn", 1, true) or string.find(nm, "warhorn", 1, true) then
                hornSlot, horn = slot, it;
                break;
            end;
        end;
        if not (horn and hornSlot) then
            -- no horn owned: emulated buff window stays open while toggled on
            getgenv()._BjBuffUntil = now + 2;
            return;
        end;
        local ready = true;
        pcall(function()
            for k, v in pairs(horn) do
                if type(v) == "number" and v > now and k ~= "_reload_cooldown" then
                    local kl = string.lower(tostring(k));
                    if string.find(kl, "cooldown", 1, true) then ready = false break end;
                end;
            end;
        end);
        if not ready then return end;
        local curSlot = nil;
        pcall(function()
            local cur = lf.EquippedItem;
            for slot, it in pairs(lf.Items) do
                if it == cur then curSlot = slot break end;
            end;
        end);
        pcall(function() lf:EquipItem(hornSlot) end);
        -- real-blow payload: aim CFrames + viewmodel anim keys, like a gun
        -- shot, not an empty table. empty payloads get eaten server-side
        -- and the buff (dark matter / empowered powers) never applies.
        task.delay(0.25, function()
            pcall(function()
                local en = enum_lib and enum_lib:ToEnum("StartShooting");
                local oid = horn:Get("ObjectID");
                local vm = horn.ViewModel;
                local keys = {};
                pcall(function() if vm and vm.GetAnimationKeys then keys = vm:GetAnimationKeys() or {} end end);
                local cf = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or CFrame.new();
                local data = {
                    [utf8.char(1)] = {
                        [utf8.char(0)] = utility:EncodeCFrame(cf),
                        [utf8.char(1)] = utility:EncodeCFrame(cf),
                    },
                };
                replicated_storage.Remotes.Replication.Fighter.UseItem:FireServer(oid, en, data, nil);
                getgenv()._EliHornAttrScan();
            end);
            -- hold the horn through the blow: swapping back instantly can
            -- cancel the buff on the server before it lands.
            local hold = tonumber(BJ.hold) or 1.5;
            task.delay(hold, function()
                pcall(function() if curSlot then lf:EquipItem(curSlot) end end);
            end);
        end);
        getgenv()._BjBuffUntil = now + (BJ.duration or 8);
    end;
    -- speed floor: buff window raises the floor; never stomps a higher game value.
    -- elisium walkspeed/slide own their values; this only ever pushes UP.
    local _bjFloor = run_service.Heartbeat:Connect(function()
        if not BJ.enable then return end;
        pcall(function()
            local char = local_player.Character;
            local hum = char and char:FindFirstChildOfClass("Humanoid");
            if not hum or hum.Health <= 0 then return end;
            local buff = (getgenv()._BjBuffUntil or 0) > tick();
            if not buff then return end;
            local cur = hum.WalkSpeed;
            local target = cur + (BJ.extra or 8);
            if cur < target - 0.01 then hum.WalkSpeed = target end;
        end);
    end);
    trove:Add(_bjFloor);
    local _bjCycle = run_service.Heartbeat:Connect(function()
        if BJ.enable then pcall(function() _bjHornTick() end) end;
    end);
    trove:Add(_bjCycle);
    local bj_box = wep_tab:AddRightGroupbox('bug jumpad speed');
    bj_box:AddToggle('bj_enable', { Text = 'bug jumpad speed', Default = false, Callback = function(v)
        BJ.enable = v;
        if not v then getgenv()._BjBuffUntil = 0 end;
    end; });
    bj_box:AddSlider('bj_extra', { Text = 'extra speed', Default = 8, Min = 0, Max = 30, Rounding = 0, Callback = function(v) BJ.extra = v end; });
    bj_box:AddSlider('bj_duration', { Text = 'buff window (s)', Default = 8, Min = 3, Max = 20, Rounding = 0, Callback = function(v) BJ.duration = v end; });
    bj_box:AddToggle('bj_horn_bypass', { Text = 'war horn no-cooldown bypass', Default = false, Callback = function(v)
        W.horn_bypass = v;
        if v then pcall(function()
            local lf = fighter_controller.LocalFighter;
            if lf then _eliPatchLF(lf, tick(), W) end;
        end) end;
    end; });
    bj_box:AddSlider('bj_hold', { Text = 'hold horn after blow (s)', Default = 1.5, Min = 0.5, Max = 5, Rounding = 1, Callback = function(v) BJ.hold = v end; });
    -- == /RIVALS SPEED BOOST ==

    -- RIVALS FINISHERS (force + victim-body control; changer Finisher tab picks flow through the same engine)
    local fin_box = wep_tab:AddRightGroupbox('finishers');
    fin_box:AddToggle('rivfin_force', { Text = 'force my finisher', Default = false, Callback = function(v) ELI.rivfin.FinishForce = v end; });
    fin_box:AddDropdown('rivfin_name', { Text = 'finisher (auto-listed)', Values = { '...' }, Default = '...', Callback = function(v) if v ~= '...' then ELI.rivfin.FinishForceName = tostring(v or '') end end; });
    fin_box:AddDropdown('rivfin_ragdoll', { Text = 'victim ragdoll', Values = { 'Finisher Default', 'Ragdoll', 'Stiff', 'Freeze', 'Fling' }, Default = 'Finisher Default', Callback = function(v) ELI.rivfin.FinishRagdoll = v end; });
    fin_box:AddSlider('rivfin_hold', { Text = 'ragdoll hold (s)', Default = 25, Min = 5, Max = 100, Rounding = 0, Callback = function(v) ELI.rivfin.FinishRagdollTime = v / 10 end; });
    fin_box:AddSlider('rivfin_fling', { Text = 'fling power', Default = 40, Min = 10, Max = 150, Rounding = 0, Callback = function(v) ELI.rivfin.FinishFling = v end; });
    fin_box:AddButton('reload finisher list', function() pcall(function() hubRefreshFinishers() end) end);
    fin_box:AddButton('diagnose finishers', function() pcall(function() hubDiagnoseFinishers() end) end);
    -- == /RIVALS FINISHERS UI ==


    -- RIVALS-GRADE LOOP: runs every Heartbeat (not task.wait).
    -- FIXED-CD-LEAK: ragebot NO LONGER arms this. only explicit weapons
    -- toggles gate the patch. warhorn/sniper stay legit until YOU flip one.
    local _eliNCD = run_service.Heartbeat:Connect(function()
        pcall(function()
            local on = W.no_cd_all or W.no_cd_this or W.no_scope_cd or W.no_ability_cd or W.no_rightclick_cd or W.no_recoil_all or W.no_recoil_this or W.no_spread;
            if not on then return end;
            local lf = fighter_controller.LocalFighter;
            if not (lf and type(lf.Items) == "table") then return end;
            _eliPatchLF(lf, tick(), W);
        end);
    end);
    trove:Add(_eliNCD);
    -- -- COSMETICS (ported from kiciahook feature map, wired to elisium backend) --
    ELI.cosmetics = ELI.cosmetics or { enabled = true, share_skins = false, weapon = "", skin = "", wrap = "", wrap_inverted = false, charm = "", rank_override = false, rank_season = "S1", rank_name = "Gold", leaderboard_rank = "", finisher = "", tracer = "none", tracer_outline = false, from_muzzle = true, no_muzzle = false, no_gun_tracers = false, no_burn = false, vm_x = 0, vm_y = 0, vm_z = 0, cam_fov = 80, weapon_priority = "Primary", held_weapon = "", auto_weapon = false, first_weapons = "", second_weapons = "", per_weapon = false, skin_enabled = true };
    local C = ELI.cosmetics;
    local function cosmWeapons() local out, seen = {}, {} pcall(function() for _, it in pairs(item_lib.Items) do local n = tostring(it.Name or "") if n ~= "" and n ~= "MISSING_WEAPON" and not seen[n] then seen[n] = true out[#out+1] = n end end end) table.sort(out) return out end;
    local function cosmByType(ctype) local out = {} pcall(function() for name, d in pairs(cosmetic_lib.Cosmetics or {}) do if type(d) == "table" and tostring(d.Type or ""):lower() == ctype and not name:find("MISSING_") then out[#out+1] = name end end end) table.sort(out) return out end;
    local function cosmSyncSel(w) local st = getgenv().elisium_cosmetic_state if st then st.selectedWeapon = w if st.refreshCosmetics then pcall(function() st.refreshCosmetics() end) end end end;
    local leftCosm = wep_tab:AddLeftGroupbox("cosmetics");
    leftCosm:AddToggle("CosmEnabled", { Text = "cosmetics enabled", Default = C.enabled, Callback = function(v) C.enabled = v end });
    leftCosm:AddToggle("CosmUnlockAll", { Text = "unlock all", Default = false, Callback = function(v) pcall(function() data_ctrl.CurrentData:Replicate("CosmeticInventory"); if getgenv().elisium_safe_weapon_inv_rep then getgenv().elisium_safe_weapon_inv_rep() else local picking=false pcall(function() local lf=fighter_controller.LocalFighter picking=lf and lf:Get('CanPickWeapons')==true end) if not picking then data_ctrl.CurrentData:Replicate("WeaponInventory") end end; data_ctrl.CurrentData:Replicate("FavoritedCosmetics") end) if v then Library:Notify("unlock all ON: inventory unlocked, equip in the changer", 2) end end });
    leftCosm:AddButton("cosmetic changer", function() local st = getgenv().elisium_cosmetic_state if st then st.dismissedThisSession = false end pcall(function() getgenv().syncCosmeticChangerVisibility() end) end);
    local rightCosm = wep_tab:AddRightGroupbox("cosmetic fx");
    rightCosm:AddToggle("CosmRankOverride", { Text = "rank charm override", Default = false, Callback = function(v) C.rank_override = v pcall(function() Options.CosmRankSeason:SetVisible(v) Options.CosmRankName:SetVisible(v) Options.CosmLeaderboard:SetVisible(v) end) end });
    rightCosm:AddDropdown("CosmRankSeason", { Text = "season", Values = { "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8" }, Default = "S1", Visible = false, Callback = function(v) C.rank_season = v end });
    rightCosm:AddDropdown("CosmRankName", { Text = "rank", Values = { "Bronze", "Silver", "Gold", "Diamond", "Onyx", "Nemesis", "Arch Nemesis" }, Default = "Gold", Visible = false, Callback = function(v) C.rank_name = v end });
    rightCosm:AddInput("CosmLeaderboard", { Text = "leaderboard rank (optional)", Default = "", Placeholder = "e.g. 12", Callback = function(v) C.leaderboard_rank = v end });
    rightCosm:AddDivider(); rightCosm:AddLabel("effects - bullet tracers / muzzle");
    rightCosm:AddDropdown("CosmTracer", { Text = "tracer", Values = { "none", "beam", "lightning", "heartrate", "chain", "glitch", "swirl", "neon", "laser1", "laser2", "line1", "ray1" }, Default = "none", Callback = function(v) C.tracer = v ELI.bullet_tracers.enable = (v ~= "none") if v ~= "none" then ELI.bullet_tracers.texture = v end end });
    rightCosm:AddToggle("CosmTracerOutline", { Text = "outline", Default = false, Callback = function(v) C.tracer_outline = v end });
    rightCosm:AddToggle("CosmFromMuzzle", { Text = "from muzzle", Default = true, Callback = function(v) C.from_muzzle = v end });
    rightCosm:AddToggle("CosmNoMuzzle", { Text = "no muzzle flash", Default = false, Callback = function(v) C.no_muzzle = v ELI.guns.no_muzzle_flash = v end });
    rightCosm:AddToggle("CosmNoGunTracers", { Text = "no gun tracers", Default = false, Callback = function(v) C.no_gun_tracers = v if v then ELI.bullet_tracers.enable = false end end });
    rightCosm:AddToggle("CosmNoBurn", { Text = "no burn effect", Default = false, Callback = function(v) C.no_burn = v ELI.removals.no_burn_effect = v end });
    rightCosm:AddDivider(); rightCosm:AddLabel("viewmodel");
    rightCosm:AddSlider("CosmVM_X", { Text = "viewmodel x", Default = 0, Min = -5, Max = 5, Rounding = 2, Callback = function(v) C.vm_x = v ELI.viewmodel_offsets.enable = true ELI.viewmodel_offsets.x = v end });
    rightCosm:AddSlider("CosmVM_Y", { Text = "viewmodel y", Default = 0, Min = -5, Max = 5, Rounding = 2, Callback = function(v) C.vm_y = v ELI.viewmodel_offsets.enable = true ELI.viewmodel_offsets.y = v end });
    rightCosm:AddSlider("CosmVM_Z", { Text = "viewmodel z", Default = 0, Min = -5, Max = 5, Rounding = 2, Callback = function(v) C.vm_z = v ELI.viewmodel_offsets.enable = true ELI.viewmodel_offsets.z = v end });
    rightCosm:AddSlider("CosmCamFOV", { Text = "camera fov", Default = 80, Min = 30, Max = 120, Rounding = 0, Callback = function(v) C.cam_fov = v ELI.fov_changer.enable = true ELI.fov_changer.fov = v end });
    rightCosm:AddDivider(); rightCosm:AddLabel("weapon");
    rightCosm:AddDropdown("CosmWeaponPriority", { Text = "weapon priority", Values = { "Primary", "Secondary", "Melee", "Utility" }, Default = "Primary", Callback = function(v) C.weapon_priority = v end });
    rightCosm:AddDropdown("CosmHeldWeapon", { Text = "held weapon", Values = cosmWeapons(), Default = "", AllowNull = true, Callback = function(v) C.held_weapon = tostring(v or "") end });
    rightCosm:AddToggle("CosmAutoWeapon", { Text = "automatic weapon", Default = false, Callback = function(v) C.auto_weapon = v ELI.weapons.auto_fire = v ELI.targeting.auto_shoot = v end });
    rightCosm:AddDropdown("CosmFirstWeapons", { Text = "first weapons", Values = cosmWeapons(), Default = "", AllowNull = true, Callback = function(v) C.first_weapons = tostring(v or "") end });
    rightCosm:AddDropdown("CosmSecondWeapons", { Text = "second weapons", Values = cosmWeapons(), Default = "", AllowNull = true, Callback = function(v) C.second_weapons = tostring(v or "") end });
    rightCosm:AddToggle("CosmPerWeapon", { Text = "per weapon settings", Default = false, Callback = function(v) C.per_weapon = v end });
end)()

_ = (function()
    local BRAND_ACCENT = Color3.fromHex('8a9ce5');

    local function detach(overlay)
        if not overlay or not Library.Overlays then return end;
        for i = #Library.Overlays, 1, -1 do
            if Library.Overlays[i] == overlay then
                table.remove(Library.Overlays, i);
            end;
        end;
    end;

    local function makeWidget(factory, cfg)
        local ok, overlay = pcall(factory, Library, cfg or { Visible = false });
        if not ok or type(overlay) ~= 'table' then return nil end;
        detach(overlay);
        return overlay;
    end;

    local function setWidgetVisible(overlay, v)
        if not overlay then return end;
        if overlay.SetVisible then
            pcall(function() overlay:SetVisible(v) end);
        elseif overlay.Outer then
            overlay.Outer.Visible = v;
            overlay.Visible = v;
        end;
        pcall(function() Library:UpdateOverlayGlow(overlay) end);
    end;

    local RadarWidget    = makeWidget(Library.CreateRadarOverlay,         { Visible = false });
    local PlayerWidget   = makeWidget(Library.CreatePlayerListOverlay,    { Visible = false, Position = UDim2.fromOffset(230, 40) });
    local VelocityWidget = makeWidget(Library.CreateVelocityGraphOverlay, { Visible = false });
    local KeybindWidget  = makeWidget(Library.CreateKeybindsOverlay,      { Visible = false });
    local TargetWidget   = makeWidget(Library.CreateClosestPlayerOverlay, { Visible = false });

    local AppearanceWidget;
    pcall(function()
        AppearanceWidget = ThemeManager:BuildAppearanceOverlay({ Visible = false });
        detach(AppearanceWidget);
    end);

    getgenv().elisium_widgets = {
        Radar = RadarWidget,
        PlayerList = PlayerWidget,
        Velocity = VelocityWidget,
        Keybind = KeybindWidget,
        ClosestPlayer = TargetWidget,
        Appearance = AppearanceWidget,
        Watermark = Library.Watermark and { Outer = Library.Watermark } or nil,
    };

    pcall(function()
        local box = Tabs['UI Settings']:AddLeftGroupbox('widgets');
        box:AddToggle('WidgetWatermark', {
            Text = 'watermark'; Default = true;
            Callback = function(v) pcall(function() Lumen:SetWatermark(nil, v ~= false) end) end;
        });
        box:AddToggle('WidgetAppearance', {
            Text = 'appearance'; Default = true;
            Callback = function(v) setWidgetVisible(AppearanceWidget, v) end;
        });
        box:AddToggle('WidgetRadar', {
            Text = 'radar'; Default = false;
            Callback = function(v) setWidgetVisible(RadarWidget, v) end;
        });
        box:AddToggle('WidgetPlayerList', {
            Text = 'player list'; Default = false;
            Callback = function(v) setWidgetVisible(PlayerWidget, v) end;
        });
        box:AddToggle('WidgetVelocity', {
            Text = 'velocity'; Default = false;
            Callback = function(v) setWidgetVisible(VelocityWidget, v) end;
        });
        box:AddToggle('WidgetClosestPlayer', {
            Text = 'closest player'; Default = false;
            Callback = function(v) setWidgetVisible(TargetWidget, v) end;
        });

        local wmbox = Tabs['UI Settings']:AddRightGroupbox('watermark');
        wmbox:AddToggle('WatermarkFps', {
            Text = 'show fps'; Default = true;
            Callback = function(v)
                getgenv().elisium_wm = getgenv().elisium_wm or {};
                getgenv().elisium_wm.fps = v;
            end;
        });
        wmbox:AddToggle('WatermarkPing', {
            Text = 'show ping'; Default = true;
            Callback = function(v)
                getgenv().elisium_wm = getgenv().elisium_wm or {};
                getgenv().elisium_wm.ping = v;
            end;
        });
        wmbox:AddToggle('WatermarkTime', {
            Text = 'show time'; Default = true;
            Callback = function(v)
                getgenv().elisium_wm = getgenv().elisium_wm or {};
                getgenv().elisium_wm.time = v;
            end;
        });
        wmbox:AddToggle('WatermarkExecutor', {
            Text = 'show executor'; Default = false;
            Callback = function(v)
                getgenv().elisium_wm = getgenv().elisium_wm or {};
                getgenv().elisium_wm.executor = v;
            end;
        });
    end);

    pcall(function()
        local toggleGui = Instance.new('ScreenGui');
        toggleGui.Name = 'elisium_toggle';
        toggleGui.ResetOnSpawn = false;
        toggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Global;
        toggleGui.DisplayOrder = 100000;
        pcall(function()
            if syn and syn.protect_gui then syn.protect_gui(toggleGui); end;
        end);
        local parented = pcall(function()
            toggleGui.Parent = (gethui and gethui()) or cloneref(game:GetService('CoreGui'));
        end);
        if not parented then
            pcall(function() toggleGui.Parent = cloneref(game:GetService('CoreGui')); end);
        end;
        getgenv().elisium_toggle_gui = toggleGui;
        local btn = Library:Create('TextButton', {
            Name = 'ElisiumMobileToggle';
            Size = UDim2.fromOffset(92, 24);
            Position = UDim2.fromOffset(12, 12);
            BackgroundColor3 = Library.MainColor;
            BorderColor3 = Library.OutlineColor;
            BorderSizePixel = 1;
            AutoButtonColor = false;
            Text = 'Elisium';
            TextColor3 = Library.FontColor;
            TextSize = 14;
            ZIndex = 5000;
            Parent = toggleGui;
        });
        Library:AddToRegistry(btn, {
            BackgroundColor3 = 'MainColor';
            BorderColor3 = 'OutlineColor';
            TextColor3 = 'FontColor';
        });
        local bar = Library:Create('Frame', {
            BackgroundColor3 = Library.AccentColor;
            BorderSizePixel = 0;
            Size = UDim2.new(1, 0, 0, 2);
            ZIndex = 5001;
            Parent = btn;
        });
        Library:AddToRegistry(bar, { BackgroundColor3 = 'AccentColor' });
        btn.MouseButton1Click:Connect(function() pcall(function() if getgenv().elisium_toggle_menu then getgenv().elisium_toggle_menu() else Library:Toggle() end end) end);
        getgenv().elisium_toggle_btn = btn;
        pcall(function() Library:RemoveFromRegistry(btn) end);
        pcall(function() Library:RemoveFromRegistry(bar) end);
        btn.BackgroundColor3 = Color3.fromRGB(15, 14, 15);
        btn.BorderColor3 = Color3.fromRGB(36, 37, 37);
        btn.TextColor3 = Color3.fromRGB(255, 255, 255);
        bar.Visible = false;
        local obCorner = Instance.new('UICorner');
        obCorner.CornerRadius = UDim.new(1, 0);
        obCorner.Parent = btn;
        local touchUi2 = game:GetService('UserInputService').TouchEnabled and not game:GetService('UserInputService').MouseEnabled;
        btn.Visible = touchUi2 and getgenv().elisium_mobile_btn ~= false;
        pcall(function() Library:MakeDraggable(btn) end);
    end);

    pcall(function()
        local holder = Window and Window.Holder;
        if not holder or holder:FindFirstChild('ElisiumMainResizer') then return end;
        local uis = game:GetService('UserInputService');
        local handle = Instance.new('Frame');
        handle.Name = 'ElisiumMainResizer';
        handle.AnchorPoint = Vector2.new(1, 1);
        handle.Position = UDim2.new(1, 0, 1, 0);
        handle.Size = UDim2.fromOffset(12, 12);
        handle.BackgroundTransparency = 1;
        handle.BorderSizePixel = 0;
        handle.ZIndex = 9999;
        handle.Active = true;
        handle.Parent = holder;
        local dragging, startPos, startSize = false, nil, nil;
        local isTouchUi = uis.TouchEnabled and not uis.MouseEnabled;
        local minResizeW = isTouchUi and 320 or 480;
        local minResizeH = isTouchUi and 260 or 360;
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true;
                startPos = input.Position;
                startSize = holder.AbsoluteSize;
            end;
        end);
        uis.InputChanged:Connect(LPH_NO_VIRTUALIZE(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - startPos;
                holder.Size = UDim2.fromOffset(
                    math.max(minResizeW, startSize.X + d.X),
                    math.max(minResizeH, startSize.Y + d.Y)
                );
            end;
        end));
        uis.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false;
            end;
        end);
    end);

    pcall(function()
        Library.AccentColor = BRAND_ACCENT;
        if Options and Options.AccentColor and Options.AccentColor.SetValueRGB then
            Options.AccentColor:SetValueRGB(BRAND_ACCENT);
        end;
        Library:UpdateColorsUsingRegistry();
    end);
    pcall(function() Library:SetOverlayGlowColor(Library.AccentColor) end);
    local function widgetToggleOn(idx)
        local t = Toggles and Toggles[idx];
        return t ~= nil and t.Value == true;
    end;
    pcall(function()
        local wv = widgetToggleOn('WidgetWatermark');
        Lumen:SetWatermark('toneqr.EZ', wv ~= false);
    end);
    setWidgetVisible(RadarWidget, widgetToggleOn('WidgetRadar'));
    setWidgetVisible(PlayerWidget, widgetToggleOn('WidgetPlayerList'));
    setWidgetVisible(VelocityWidget, widgetToggleOn('WidgetVelocity'));
    setWidgetVisible(KeybindWidget, false);
    pcall(function()
        local kb = Library.KeybindOverlay;
        if kb then
            if kb.Outer then kb.Outer.Visible = false end;
            kb.Visible = false;
            kb.SetVisible = function(self, v)
                if kb.Outer then kb.Outer.Visible = false end;
                kb.Visible = false;
            end;
        end;
        if Library.KeybindContainer then
            Library.KeybindContainer.Visible = false;
        end;
    end);
    setWidgetVisible(TargetWidget, widgetToggleOn('WidgetClosestPlayer'));
    setWidgetVisible(AppearanceWidget, widgetToggleOn('WidgetAppearance'));
    pcall(function()
        local roots = {};
        if Library.ScreenGui then roots[#roots + 1] = Library.ScreenGui end;
        local lw = getgenv()._LumenCompat and getgenv()._LumenCompat.Window;
        if lw then
            if lw.Canvas then roots[#roots + 1] = lw.Canvas end;
        end;
        pcall(function()
            local llib = Lumen;
            if llib then
                if llib._Instance then roots[#roots + 1] = llib._Instance end;
                if llib._Overlay then roots[#roots + 1] = llib._Overlay end;
            end;
        end);
        local tg = getgenv().elisium_toggle_gui;
        if tg then roots[#roots + 1] = tg end;
        getgenv()._ELI_GUIROOTS = roots;
    end);
end)();

-- (lumen) autoload handled by Lumen:BuildConfigPage --

end;
end;
end

-- MERGED UE RAGEBOT (verbatim 670 lines, Full Ue 4955-5624)
-- RAGEBOT  -- protos 428-471

-- ============================================================================

local Ragebot = (function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local Modules = ReplicatedStorage:FindFirstChild("Modules")
local function _ueReq(n) local m = Modules and Modules:FindFirstChild(n); if m and m:IsA("ModuleScript") then local ok, r = pcall(require, m); if ok then return r end end return nil end
local CONSTANTS = _ueReq("CONSTANTS")
local utility = _ueReq("utility")
local ClientFighter = nil;
pcall(function() local c = LocalPlayer.PlayerScripts:FindFirstChild("Controllers"); local f = c and c:FindFirstChild("ClientFighter"); if f and f:IsA("ModuleScript") then ClientFighter = require(f) end end)

local Remotes = nil;
pcall(function() local r = ReplicatedStorage:FindFirstChild("Remotes"); if r then Remotes = r end end)
local Replication = Remotes and Remotes:FindFirstChild("Replication")
local FighterRemote = Remotes and Remotes:FindFirstChild("Fighter")
local UseItemRemote = FighterRemote and FighterRemote:FindFirstChild("UseItem")

local IS_PRIVATE_SERVER = CONSTANTS and game.PlaceId == CONSTANTS.IS_PRIVATE_SERVER

local Ragebot = {}
Ragebot.__index = Ragebot

local function randomUnitVector()
    return Random.new():NextUnitVector()
end

local function generateGUID()
    return HttpService:GenerateGUID(false)
end

function Ragebot.new()
    local self = setmetatable({}, Ragebot)

    self.characters = {}
    self.duelCache = {}
    self.priorities = {}
    self.voidedPlayers = {}

    self.attackNum = 0
    self.heavyAttackNum = 0
    self.reloadCooldown = 0
    self.lastAttack = 0
    self.attackThread = nil
    self.reloadThreads = {}

    self.desync = {
        enabled = false,
        pitch = 0,
        yaw = 0,
        customPitch = 0,
        customYaw = 0,
        floorHide = false,
        physicsRep = nil,
    }

    self.status = {
        enabled = false,
        text = "",
        weapon = nil,
    }

    self.events = {
        force_cframe_change = Instance.new("BindableEvent"),
        ragebot_status = Instance.new("BindableEvent"),
    }

    self:trackCharacters()
    self:setupValidation()
    self:setupAntiAim()
    self:setupVoidPosition()
    self:setupVoidSpam()
    self:setupPriorityTargeting()
    self:setupIndicator()

    RunService.RenderStepped:Connect(function()
        if not Toggles.ragebot_enabled.Value then
            self.status.enabled = false
            return
        end
        self.status.enabled = true
    end)

    RunService.Heartbeat:Connect(function()
        if Toggles.ragebot_enabled.Value and Toggles.ragebot_void_spam.Value then
            if self.attackThread and coroutine.status(self.attackThread) ~= "dead" then
                return
            end
            self.attackThread = task.spawn(function()
                self:voidLoop()
            end)
        end
    end)

    return self
end

function Ragebot:trackCharacters()
    local function add(plr, char)
        self.characters[plr] = char
        self.duelCache[plr] = cloneref(char)
    end
    local function remove(plr)
        self.characters[plr] = nil
        self.duelCache[plr] = nil
        self.priorities[plr] = nil
        self.voidedPlayers[plr] = nil
    end
    local function hook(plr)
        if plr.Character then add(plr, plr.Character) end
        plr.CharacterAdded:Connect(function(char) add(plr, char) end)
        plr.CharacterRemoving:Connect(function() remove(plr) end)
    end
    for _, plr in ipairs(Players:GetPlayers()) do hook(plr) end
    Players.PlayerAdded:Connect(hook)
end

function Ragebot:setupValidation()
    local function hasFlag(char, name)
        local flag = char and char:FindFirstChild(name)
        return flag ~= nil
    end

    function self:isAlly(char)
        local flag = char and char:FindFirstChild("_is_ally")
        return flag ~= nil and flag.Value == true
    end

    function self:isAlive(char)
        local hum = char and char:FindFirstChild("Humanoid")
        return hum ~= nil and hum.Health > 0
    end

    function self:getClientFighter(char)
        local client = char and char:FindFirstChild("ClientFighter")
        return client or (char and char:GetAttribute("client_fighter"))
    end

    function self:getHitbox(char)
        local head = char and (char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head"))
        return head or (char and char:FindFirstChild("HumanoidRootPart"))
    end

    function self:validateTarget(char)
        if not char then return false end
        if self:isAlly(char) then return false end
        if not self:isAlive(char) then return false end
        if not self:getClientFighter(char) then return false end
        if not hasFlag(char, "Health") then return false end
        return true
    end
end

function Ragebot:setupAntiAim()
    local self = self

    function self:applyDesync(cframe, hrp, rep)
        if rep then
            rep.CFrame = cframe
        end
        if hrp then
            self.events.force_cframe_change:Fire(hrp, cframe)
        end
    end

    function self:unbindAntiAim()
        pcall(function()
            RunService:UnbindFromRenderStep("RagebotAntiAim")
        end)
    end

    function self:desyncCFrame(hrp)
        local base = hrp.CFrame
        local yaw = math.rad(self.desync.yaw)
        local pitch = math.rad(self.desync.pitch)
        local customYaw = math.rad(self.desync.customYaw)
        local customPitch = math.rad(self.desync.customPitch)
        return CFrame.new(base.Position)
            * CFrame.Angles(0, yaw + customYaw, 0)
            * CFrame.Angles(pitch + customPitch, 0, 0)
    end

    RunService:BindToRenderStep("RagebotAntiAim", Enum.RenderPriority.Camera.Value, function()
        if not Toggles.ragebot_enabled.Value then
            self:unbindAntiAim()
            return
        end
        local character = LocalPlayer.Character
        if not character then return end
        local hrp = character:WaitForChild("HumanoidRootPart")
        if not hrp then return end

        self.desync.enabled = Toggles.anti_aim_enabled.Value
        self.desync.pitch = Options.anti_aim_pitch.Value
        self.desync.yaw = Options.anti_aim_yaw.Value
        self.desync.customPitch = Options.anti_aim_custom_pitch.Value
        self.desync.customYaw = Options.anti_aim_custom_yaw.Value
        self.desync.floorHide = Toggles.anti_aim_floor_hide.Value
        if Toggles.anti_aim_floor_hide_keybind then
            local mode = Toggles.anti_aim_floor_hide_keybind.Mode
            local key = Toggles.anti_aim_floor_hide_keybind.Value
            if mode == "Hold" then
                self.desync.floorHide = UserInputService:IsKeyDown(key)
            elseif mode == "Toggle" then
                self.desync.floorHide = Toggles.anti_aim_floor_hide_keybind.KeyDown
            end
        end

        local rep = character:FindFirstChild("PhysicsRepRootPart") or hrp
        self.desync.physicsRep = rep

        if not self.desync.enabled then
            rep.CFrame = hrp.CFrame
            return
        end

        if self.desync.floorHide and hrp.Position.Y < 8 then
            self:applyDesync(hrp.CFrame * CFrame.new(0, -3, 0), hrp, rep)
            return
        end

        self:applyDesync(self:desyncCFrame(hrp), hrp, rep)
    end)
end

function Ragebot:setupVoidPosition()
    local self = self
    local cache = {}

    local function collectBarriers()
        local barriers = {}
        local map = workspace:FindFirstChild("Map")
        local barrierFolder = map and map:FindFirstChild("Barriers")
        if barrierFolder then
            for _, part in ipairs(barrierFolder:GetChildren()) do
                if part:IsA("BasePart") then
                    table.insert(barriers, part)
                end
            end
        end
        return barriers
    end

    local function collectSpawns()
        local positions = {}
        local spawns = workspace:FindFirstChild("Spawns")
        if not spawns then return positions end
        for _, obj in ipairs(spawns:GetDescendants()) do
            if obj:IsA("Model") then
                local pos = obj:FindFirstChild("Position")
                if pos and pos:IsA("Vector3Value") then
                    table.insert(positions, pos.Value)
                end
            elseif obj:IsA("BasePart") then
                table.insert(positions, obj.Position)
            end
        end
        return positions
    end

    function self:getVoidPosition()
        local now = tick()
        if cache.expire and now < cache.expire and cache.position then
            return cache.position
        end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Whitelist
        params.FilterDescendantsInstances = collectBarriers()
        params.BruteForceAllSlow = true

        local candidates = collectSpawns()
        for _, origin in ipairs(candidates) do
            local from = origin + Vector3.new(0, 2, 0)
            local result = workspace:Raycast(from, Vector3.new(0, -500, 0), params)
            if result then
                local hit = result.Position
                if hit.Y < 0 then
                    cache.position = hit
                    cache.expire = now + 1
                    return hit
                end
            end
        end

        if cache.position then
            return cache.position
        end
        return nil
    end

    function self:voidPositionOrFallback()
        return self:getVoidPosition() or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position)
    end
end

function Ragebot:setupVoidSpam()
    local self = self

    local function getEquippedItem(character)
        return character and character:FindFirstChild("EquippedItem")
    end

    local function getRotationCFrame(part)
        return part and part.CFrame.Rotation or CFrame.new()
    end

    local function getAnimationKeys(item)
        local viewModel = item and item.ViewModel
        return viewModel and viewModel:GetAnimationKeys() or {}
    end

    local function hasRiotShield(character)
        local item = getEquippedItem(character)
        return item and item.Name == "Riot Shield" or false
    end

    local function equipItem(character, itemName)
        return pcall(function()
            local item = getEquippedItem(character)
            if item and item.EquipItem then
                item:EquipItem(itemName)
            end
        end)
    end

    local function fireUseItem(payload)
        return pcall(function()
            UseItemRemote:FireServer(payload)
        end)
    end

    function self:voidSpamMelee(target)
        local myChar = LocalPlayer.Character
        local item = getEquippedItem(myChar)
        if not item then return false end
        if item.Info and item.Info.Type ~= "Melee" then return false end

        local now = tick()
        local cooldown = item.Info and item.Info.HeavyAttackCooldown or 0.2
        if now - self.lastAttack < cooldown then
            return false
        end
        self.lastAttack = now

        self.heavyAttackNum = self.heavyAttackNum + 1

        local hitbox = self:getHitbox(target)
        if not hitbox then return false end

        local aimPos = hitbox.Position + randomUnitVector() * 0.35
        local rotation = getRotationCFrame(hasRiotShield(target) and hitbox or target)

        local ok = fireUseItem({
            id = generateGUID(),
            objectId = HttpService:GenerateGUID(false),
            item = Options.ragebot_weapon.Value,
            position = aimPos,
            heavyAttackNum = self.heavyAttackNum,
            animationKeys = getAnimationKeys(item),
            rotation = rotation,
            one = Vector3.one,
            startAiming = true,
            packed = { "\x00", "\x01", "\x02", "\x03" },
        })

        if ok then
            pcall(function()
                item:StartAiming(aimPos)
            end)
            pcall(function()
                item:HeavyAttack(aimPos)
            end)
            self.status.text = "locked"
        else
            self.status.text = "locked"
        end
        return ok
    end

    function self:voidSpamRanged(target)
        local myChar = LocalPlayer.Character
        local item = getEquippedItem(myChar)
        if not item then return false end
        if item.Info and item.Info.Type ~= "Gun" then return false end

        self.attackNum = self.attackNum + 1

        local attempts = Options.ragebot_shoot_attempts.Value or 1
        local hide = Options.ragebot_void_spam_hide.Value or 0
        if not Toggles.ragebot_void_spam_attack.Value then return false end

        local hitbox = self:getHitbox(target)
        if not hitbox then return false end

        local aimPos = hitbox.Position + randomUnitVector() * 0.5
        local rotation = getRotationCFrame(hasRiotShield(target) and hitbox or target)

        local ok = fireUseItem({
            id = generateGUID(),
            objectId = HttpService:GenerateGUID(false),
            item = Options.ragebot_weapon.Value,
            position = aimPos,
            attackNum = self.attackNum,
            animationKeys = getAnimationKeys(item),
            rotation = rotation,
            one = Vector3.one,
            packed = { "\x00", "\x01", "\x02", "\x03" },
        })

        if ok then
            pcall(function()
                item:StartShooting(aimPos)
            end)
            self.status.text = "firing"
        else
            self.status.text = ""
        end
        return ok
    end

    function self:keyHeld()
        local mode = Toggles.ragebot_keybind.Mode
        local key = Toggles.ragebot_keybind.Value
        if mode == "Always" then return true end
        if mode == "Hold" then return UserInputService:IsKeyDown(key) end
        if mode == "Toggle" then return Toggles.ragebot_keybind.KeyDown end
        return true
    end

    function self:baitPlayers()
        -- ragebot_bait: pull voided players into targeting range by
        -- marking them as high-priority bait targets
        if not Toggles.ragebot_bait.Value then return end
        for player, char in pairs(self.characters) do
            if self.voidedPlayers[player] then
                self.priorities[player] = (self.priorities[player] or 0) + 10
            end
        end
    end

    function self:voidLoop()
        if not Toggles.ragebot_enabled.Value then return end
        if not Toggles.ragebot_void_spam.Value then return end
        if not self:keyHeld() then return end

        local myChar = LocalPlayer.Character
        if not myChar then return end

        local item = getEquippedItem(myChar)
        if not item then
            self.status.text = "no item"
            equipItem(myChar, Options.ragebot_weapon.Value)
            return
        end

        local target = self:getPriorityTarget()
        if not target then return end

        local mode = Options.ragebot_mode.Value or "gun"
        local weaponType = item.Info and item.Info.Type
        if mode == "gun" and weaponType == "Melee" then
            -- prefer projectile weapon (ragebot_settings)
            local settings = Options.ragebot_settings.Value or {}
            if settings["prefer projectile weapon"] then
                pcall(function()
                    item:EquipItem(Options.ragebot_weapon.Value)
                end)
                return
            end
        end
        local data = item.Data
        local ammo = data and data.Ammo
        local reserve = data and data.AmmoReserve
        local now = tick()

        if weaponType == "Gun" then
            if ammo and ammo <= 0 then
                if reserve and reserve > 0 then
                    if now > self.reloadCooldown then
                        self.status.text = "reloading..."
                        pcall(function()
                            item:StartReloading()
                        end)
                        self.reloadCooldown = now + 0.4
                        table.insert(self.reloadThreads, tick())
                    end
                    return
                end
                local settings = Options.ragebot_settings.Value or {}
                if settings["swap weapons when empty"] then
                    equipItem(myChar, Options.ragebot_weapon.Value)
                    self.status.text = "swap weapons when empty"
                end
                return
            end

            if item.Name == "Revolver" then
                self.attackNum = self.attackNum + 1
                local hitbox = self:getHitbox(target)
                local aimPos = hitbox.Position + randomUnitVector() * 0.5
                fireUseItem({
                    id = generateGUID(),
                    item = Options.ragebot_weapon.Value,
                    position = aimPos,
                    attackNum = self.attackNum,
                    animationKeys = getAnimationKeys(item),
                    rotation = getRotationCFrame(hitbox),
                })
                self.status.text = "firing"
                return
            end

            self:voidSpamRanged(target)
            return
        end

        if weaponType == "Melee" then
            self:voidSpamMelee(target)
            return
        end

        equipItem(myChar, Options.ragebot_weapon.Value)
        self.status.text = ""
    end

    RunService.RenderStepped:Connect(function()
        if not Toggles.ragebot_enabled.Value then return end
        if not Toggles.ragebot_void_spam.Value then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local item = getEquippedItem(myChar)
        if not item then return end
        local weaponType = item.Info and item.Info.Type
        if weaponType ~= "Gun" and weaponType ~= "Melee" then
            self.status.text = "no item"
        end
    end)
end

function Ragebot:setupPriorityTargeting()
    local self = self

    function self:addPriority(player, level)
        self.priorities[player] = level
        if Toggles.ragebot_priority_notification.Value then
            Library:Notify("added " .. player.Name .. " to ragebot priority", 2)
        end
    end

    function self:removePriority(player)
        self.priorities[player] = nil
    end

    function self:markVoided(player)
        self.voidedPlayers[player] = true
    end

    function self:unmarkVoided(player)
        self.voidedPlayers[player] = nil
    end

    function self:getPriorityTarget()
        local cam = workspace.CurrentCamera
        local origin = cam and cam.CFrame.Position
        if not origin then return nil end

        local settings = Options.ragebot_priority_settings.Value or {}
        local targets = Options.ragebot_priority_targets.Value or {}
        self:baitPlayers()

        local best, bestScore = nil, math.huge
        for player, char in pairs(self.characters) do
            if player ~= LocalPlayer then
                if not self:validateTarget(char) then continue end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - origin).Magnitude
                    local priority = self.priorities[player] or 0
                    local weight = 500
                    if priority > 0 then
                        weight = weight + priority * 100
                    end
                    local score = dist - weight
                    if self.voidedPlayers[player] then
                        score = score - 10000
                    end
                    if score < bestScore then
                        bestScore = score
                        best = char
                    end
                end
            end
        end
        return best
    end
end

function Ragebot:setupIndicator()
    local self = self
    local lastUpdate = 0

    RunService.RenderStepped:Connect(function()
        local now = tick()
        if now - lastUpdate < 0.1 then return end
        lastUpdate = now

        self.status.enabled = Toggles.ragebot_enabled.Value
        if not self.status.enabled then
            self.status.text = ""
            return
        end

        local myChar = LocalPlayer.Character
        if not myChar then return end
        local item = myChar:FindFirstChild("EquippedItem")
        local weaponType = item and item.Info and item.Info.Type

        if weaponType == "Gun" then
            self.status.text = "ragebot"
            self.status.weapon = item.Name
        elseif weaponType == "Melee" then
            local name = item.Name or "Knife"
            self.status.text = "ragebot: " .. name
            self.status.weapon = item
        else
            self.status.text = "no weapon"
            self.status.weapon = nil
        end

        if Toggles.indicator_ragebot.Value then
            local style = Options.indicator_ragebot_style.Value
            self.events.ragebot_status:Fire(self.status.text)
        end
    end)
end

function Ragebot:setPriority(player, level)
    return self:addPriority(player, level)
end

function Ragebot:getState()
    return {
        enabled = self.status.enabled,
        text = self.status.text,
        weapon = self.status.weapon,
        priorityTarget = self:getPriorityTarget(),
    }
end

function Ragebot:getPriorityList()
    local list = {}
    for player, level in pairs(self.priorities) do
        table.insert(list, { player = player, priority = level })
    end
    return list
end

function Ragebot:getVoidedPlayers()
    local list = {}
    for player in pairs(self.voidedPlayers) do
        table.insert(list, player)
    end
    return list
end
return Ragebot
end)()

