        local list = {};
        pcall(function() list = getCosmeticsFor(w, ctype) or {} end);
        if #list == 0 then return end
        local pick = list[math.random(1, #list)];
        uiState.pendingCosmetics[w] = uiState.pendingCosmetics[w] or {};
        uiState.pendingCosmetics[w][ctype] = pick;
        pcall(function() fireEquipCosmetic(w, ctype, pick, {}) end);
        if uiState.refreshCosmetics then uiState.refreshCosmetics() end
        if ctype == "Skin" and uiState.refreshWeapons then uiState.refreshWeapons() end
    end);
    end);
    local function getWeapons()
        -- FIXED: loadout GUI = unlocked only (old harvest flooded ALL catalog)
        local out, seen = {}, {};
        local function addWeapon(name)
            if type(name) ~= "string" then return end;
            name = name:gsub("^%s+", ""):gsub("%s+$", "");
            if name == "" then return end;
            if not seen[name] then
                seen[name] = true;
                table.insert(out, name);
            end;
        end;
        local weaponInv = nil;
        pcall(function() weaponInv = data_ctrl and data_ctrl.Get and data_ctrl:Get("WeaponInventory") end);
        if type(weaponInv) == "table" then
            for k, v in eli_pairs(weaponInv) do
                if v == true and type(k) == "string" then addWeapon(k);
                elseif type(v) == "string" then addWeapon(v); end;
            end;
        end;
        if #out == 0 then -- fallback: LocalFighter unlocked only, never full catalog
            pcall(function()
                local lf = fighter_controller.LocalFighter;
                if lf and lf.GetUnlockedWeapons then
                    for name in pairs(lf:GetUnlockedWeapons()) do addWeapon(name) end;
                end;
            end);
        end;
        if #out == 0 then -- FIXED-BLANK: changer weapons never blank, show catalog so user can pick
            pcall(function() for _, it in pairs(item_lib.Items) do if it.Name ~= 'MISSING_WEAPON' then addWeapon(it.Name) end; end; end);
        end;
        -- NOTE: do NOT harvest item_library / equipped / favorites here (that was the flood)
