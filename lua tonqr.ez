        shaders_tab:AddSlider('shader_sun_rays_spread', {
            Text = 'rays spread',
            Default = 1,
            Min = 0,
            Max = 1,
            Rounding = 2,
            Callback = function(v)
                ELI.world.sun_rays_spread = v;
                shader_sunrays.Spread = v;
            end
