ELI.PredictionService = {}
do
    function ELI.PredictionService:Init()
        self.enabled = false;
        self.multiplier = 1.2;
        self.velocity = Vector3.new(0, 0, 0);
        self.acceleration = Vector3.new(0, 0, 0);
        self.lastposition = nil;
        self.lasttime = 0;
        self.velbuffer = {};
        self.posbuffer = {};
        self.maxvelsamples = 15;
        self.maxpossamples = 5;
    end;

    function ELI.PredictionService:Update(target)
        if not self.enabled or not target or not target.Character then
            self.velocity = Vector3.new(0, 0, 0);
            self.acceleration = Vector3.new(0, 0, 0);
            self.lastposition = nil;
            self.velbuffer = {};
            self.posbuffer = {};
            return
        end;

        local root = target.Character:FindFirstChild("HumanoidRootPart");
        if not root then return end;

        local now = tick();
        local dt = now - self.lasttime;

        if dt > 0 and dt < 0.1 then
            local currentpos = root.Position;

            table.insert(self.posbuffer, 1, {
                position = currentpos,
                time = now
            });

            if #self.posbuffer > self.maxpossamples then
                table.remove(self.posbuffer);
            end;

            if self.lastposition then
                local instantvel = (currentpos - self.lastposition) / dt;

                if self.velocity.Magnitude > 0.1 then
                    local instantaccel = (instantvel - self.velocity) / dt;
                    self.acceleration = self.acceleration:Lerp(instantaccel, 0.5);
                end;

                table.insert(self.velbuffer, 1, {
                    velocity = instantvel,
                    time = now,
                    dt = dt
                });

                if #self.velbuffer > self.maxvelsamples then
                    table.remove(self.velbuffer);
                end;

                if #self.velbuffer > 0 then
                    local weightedsum = Vector3.new(0, 0, 0);
                    local totalweight = 0;

                    for i, entry in next, self.velbuffer do
                        local weight = math.exp(-(i - 1) * 0.3);
                        weightedsum = weightedsum + (entry.velocity * weight);
                        totalweight = totalweight + weight;
                    end;

                    self.velocity = weightedsum / totalweight;
                else
                    self.velocity = instantvel;
                end;
            end;

            self.lastposition = currentpos;
            self.lasttime = now;
        end;
    end;

    function ELI.PredictionService:Predict(targetpart, origin)
        if not self.enabled or not targetpart then
            return targetpart.Position;
        end;

        local basepos = targetpart.Position;
        local distance = (basepos - origin).Magnitude;

        local ping = 0;
        pcall(function()
            ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000;
        end);

        local bulletspeed = 3000;
        local traveltime = distance / bulletspeed;
        local speed = self.velocity.Magnitude;

        local adaptivemult = 1.0;
        if speed > 150 then
            adaptivemult = 1.5 + math.min((speed - 150) / 300, 1.0);
        elseif speed > 80 then
            adaptivemult = 1.3;
        elseif speed > 40 then
            adaptivemult = 1.1;
        elseif speed < 10 then
            adaptivemult = 0.7;
        end;

        local totaltime = (traveltime + ping) * self.multiplier * adaptivemult;
        local predicted = basepos + (self.velocity * totaltime);

        if self.acceleration.Magnitude > 5 and speed > 50 then
            predicted = predicted + self.acceleration * (totaltime * totaltime * 0.5);
        end;

        if #self.posbuffer >= 3 then
            local jittersum = Vector3.new(0, 0, 0);
            for i = 1, math.min(3, #self.posbuffer - 1) do
                jittersum = jittersum + (self.posbuffer[i].position - self.posbuffer[i + 1].position);
            end;
            local avgjitter = jittersum / math.min(3, #self.posbuffer - 1);
            if avgjitter.Magnitude > 2 then
                predicted = predicted + (avgjitter * 0.3);
            end;
        end;

        if math.abs(self.velocity.Y) > 5 then
            predicted = predicted + Vector3.new(0, self.velocity.Y * totaltime * 0.15, 0);
        end;

        return predicted;
    end;

    ELI.PredictionService:Init();
end;

ELI.DesyncService = {}
do
    function ELI.DesyncService:Init()
        self.active = false;
        self.connection = nil;
        self.server = nil;
        self.client = nil;
        self.angle = 0;
        self.speed = 9000;
        self.fighter = fighter_controller.LocalFighter;

        -- restore ONLY in Off mode. wrapped in pcall + live fighter refresh:
        -- a stale Entity handle (respawn) throwing in here = dead camera.
        local ref = camera_controller.Update;
        camera_controller.Update = function(...)
            pcall(function()
                if not self.active then return end;
                local lf = fighter_controller.LocalFighter;
                if lf and (not self.fighter or self.fighter ~= lf) then
                    self.fighter = lf;
                end;
                if self.fighter and self.fighter.Entity and self.fighter.Entity.RootPart
                    and self.fighter.Entity.RootPart.Parent and self.client
                    and (ELI.ragebot.posmode or 'Off') == 'Off' then
                    self.fighter.Entity.RootPart.CFrame = self.client;
                end;
            end);
            return ref(...);
        end;
    end;

    function ELI.DesyncService:Start(target)
        -- DOUBLE-TOGGLE FIX 2: old `if self.active then return` kept the
        -- FIRST target closure forever. target left/died = loop stuck dead
        -- until off/on. now refresh target on every call, connect once.
        if self.active then
            self._target = target;
            return
        end;
        if not getgenv().elisium_in_duel() then return end;
        if not local_player.Character then return end;
        if not self.fighter or not self.fighter.Entity.RootPart then return end;

        -- NO camera pins: every pin so far froze eyes somewhere wrong
        -- (stale home, ground clip). game camera follows your body live to
        -- the plant: arms/viewmodel track, never buried, never frozen.
        -- unbind here + in Stop in case an older session left pins bound.
        pcall(function()
            run_service:UnbindFromRenderStep("EliPosmodeCam");
            run_service:UnbindFromRenderStep("EliPosmodeCamLive");
        end);

        self.active = true;
        self._target = target;
        self.connection = run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
            -- live target: Start() refreshes self._target every frame.
            local tgt = self._target or target;
            target = tgt;
            if not self.active then
                if self.connection then
                    self.connection:Disconnect();
                    self.connection = nil;
                end;
                return
            end;

            if not getgenv().elisium_in_duel() then
                self:Stop();
                return
            end;

            -- live fighter refresh: respawns stale the Init-time handle and
            -- every .Entity access below throws on a dead object.
            pcall(function()
                local lf = fighter_controller.LocalFighter;
                if lf then self.fighter = lf end;
            end);
            if not target or not target.Character or not target.Character:FindFirstChild('HumanoidRootPart') or not self.fighter or not self.fighter.Entity or not self.fighter.Entity.RootPart or not self.fighter.Entity.RootPart.Parent then
                if self.connection then
                    self.connection:Disconnect();
                    self.connection = nil;
                end;
                if self.client and self.fighter and self.fighter.Entity.RootPart then
                    self.fighter.Entity.RootPart.CFrame = self.client;
                end;
                self.active = false;
                self.client = nil;
                self.server = nil;
                return
            end;

            -- YOUR screen stays normal: capture home once in posmode (nothing
            -- moves your character, gravity untouched, camera home). Off
            -- refreshes every tick, body never moves there either.
            if (ELI.ragebot.posmode or 'Off') == 'Off' or not self.client then
                self.client = self.fighter.Entity.RootPart.CFrame;
            end;

            local item = self.fighter.EquippedItem;
            if not item then return end;

            local targetPos = target.Character.HumanoidRootPart.Position;

            if is_deflecting(target) or has_riot(target) then
            self.server = Vector3.new(0, 2^26, 0);
            return
            end;

            if item.Name == "Slingshot" then
                self.server = Vector3.new(0, 2^26, 0);
            else
                self.server = targetPos + Vector3.new(ELI.ragebot.x, ELI.ragebot.y, ELI.ragebot.z);
            end;

            -- position mode: server origin = plant (Sky/Behind/Underground/
            -- Fly/Side/Camera/Mixture/Orbit). rep root carries the plant;
            -- YOUR character is NEVER touched: normal gravity, camera home,
            -- arms tracked, WASD fully yours. damage rides the plant origin.
            if (ELI.ragebot.posmode or 'Off') ~= 'Off' then
                local plantCF = nil;
                pcall(function()
                    local troot = target.Character and target.Character:FindFirstChild('HumanoidRootPart');
                    local thead = target.Character and (target.Character:FindFirstChild('HitboxHead') or target.Character:FindFirstChild('Head') or troot);
                    local myRoot = self.fighter.Entity.RootPart;
                    local fn = getgenv()._eliDesyncPlant;
                    if troot and thead and myRoot and fn then
                        plantCF = fn(target, troot, thead, myRoot);
                    end;
                end);
                if plantCF then
                    -- sanitize: NaN or void plants fling physics + kill cam.
                    local pp = plantCF.Position;
                    local bad = (pp.X ~= pp.X or pp.Y ~= pp.Y or pp.Z ~= pp.Z);
                    local floorY = -460;
                    pcall(function()
                        local f = workspace.FallenPartsDestroyHeight;
                        if type(f) == 'number' and f < -100 then floorY = f + 40 end;
                    end);
                    if (not bad) and (pp.Y < floorY or pp.Y > 5000
                        or math.abs(pp.X) > 9000 or math.abs(pp.Z) > 9000) then
                        bad = true;
                    end;
                    if bad then
                        -- fall back to plain target offset, never void.
                        plantCF = CFrame.lookAt(targetPos + Vector3.new(ELI.ragebot.x, ELI.ragebot.y, ELI.ragebot.z), targetPos);
                        pp = plantCF.Position;
                    end;
                    self.server = pp;
                    pcall(function()
                        local rep = self.fighter.Entity.RootPart;
                        rep.CFrame = plantCF;
                        rep.AssemblyLinearVelocity = Vector3.zero;
                        rep.RotVelocity = Vector3.zero;
                    end);
                end;
                return
            end;

            self.fighter.Entity.RootPart.CFrame = CFrame.new(self.server);
        end));
    end;

    function ELI.DesyncService:Stop()
        if not self.active then return end;
        pcall(function()
            run_service:UnbindFromRenderStep("EliPosmodeCam");
            run_service:UnbindFromRenderStep("EliPosmodeCamLive");
        end);
        self.home = nil;
        -- camera back to you no matter what left it elsewhere: a plant that
        -- killed the char or a Scriptable left over = black/frozen screen.
        pcall(function()
            local cam = workspace.CurrentCamera;
            if cam then
                if cam.CameraType ~= Enum.CameraType.Custom then
                    cam.CameraType = Enum.CameraType.Custom;
                end;
                local ch = local_player.Character;
                local hum = ch and ch:FindFirstChildOfClass("Humanoid");
                if hum and hum.Health > 0 then
                    cam.CameraSubject = hum;
                end;
            end;
        end);
        if self.connection then
            self.connection:Disconnect();
            self.connection = nil;
        end;
        if self.client and self.fighter and self.fighter.Entity.RootPart then
            self.fighter.Entity.RootPart.CFrame = self.client;
        end;
        pcall(function()
            local ch = local_player.Character;
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart");
            if hrp and self.client then
                hrp.CFrame = self.client;
                hrp.AssemblyLinearVelocity = Vector3.zero;
                hrp.RotVelocity = Vector3.zero;
            end;
        end);
        self.active = false;
        self.server = nil;
        self.client = nil;
    end;

    ELI.DesyncService:Init();
end

do
    local POOL_SIZE = 32;
    local pool = {};
    local throwables = {
        ["grenade"] = true, ["molotov"] = true, ["flashbang"] = true,
        ["smoke grenade"] = true, ["satchel"] = true, ["jump pad"] = true,
        ["war horn"] = true, ["flare gun"] = true,
    };

    local function getPart(i)
        local p = pool[i];
        if p and p.Parent then return p end;
        p = Instance.new("Part");
        p.Anchored = true;
        p.CanCollide = false;
        p.CanQuery = false;
        p.CanTouch = false;
        p.Shape = Enum.PartType.Ball;
        p.Size = Vector3.new(0.4, 0.4, 0.4);
        p.Material = Enum.Material.Neon;
        p.Parent = workspace;
        pool[i] = p;
        return p;
    end;

    local function hideFrom(n)
        for i = n, POOL_SIZE do
            local p = pool[i];
            if p then p.Transparency = 1 end;
        end;
    end;

    local function clearPool()
        for i, p in eli_pairs(pool) do
            pcall(function() p:Destroy() end);
            pool[i] = nil;
        end;
    end;

    local function computeArc(startPos, velocity, gravity, dt, steps, params)
        local points = { startPos };
        local pos = startPos;
        local vel = velocity;
        for _ = 1, steps do
            local nextPos = pos + vel * dt + gravity * (0.5 * dt * dt);
            local hit = params and workspace:Raycast(pos, nextPos - pos, params);
            if hit then
                points[#points + 1] = hit.Position;
                return points;
            end;
            points[#points + 1] = nextPos;
            pos = nextPos;
            vel = vel + gravity * dt;
        end;
        return points;
    end;

    trove:Add(run_service.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function()
        local cfg = ELI.trajectory;
        if not cfg.enable then
            hideFrom(1);
            return
        end;

        local fighter = fighter_controller.LocalFighter;
        local item = fighter and fighter.EquippedItem;
        local name = item and item.Name;
        local show = cfg.all_weapons or (name ~= nil and throwables[string.lower(name)] == true);
        if not show then
            hideFrom(1);
            return
        end;

        local origin = camera.CFrame.Position;
        local velocity = camera.CFrame.LookVector * cfg.speed + Vector3.new(0, cfg.arc_up, 0);
        local gravity = Vector3.new(0, -workspace.Gravity, 0);

        local params = RaycastParams.new();
        params.FilterType = Enum.RaycastFilterType.Exclude;
        params.FilterDescendantsInstances = { local_player.Character };

        local points = computeArc(origin, velocity, gravity, 0.07, POOL_SIZE - 1, params);
        for i = 1, #points do
            local p = getPart(i);
            p.Position = points[i];
            p.Color = cfg.color;
            p.Transparency = 0;
        end;
        hideFrom(#points + 1);
    end)));

    trove:Add(clearPool);
end;

ELI.RagebotService = {}
do
    function ELI.RagebotService:Init()
        self.active = false;
        self.debounce = false;
        self.lastShot = os.clock();
        self.connection = nil;
    end;

    function ELI.RagebotService:IsValid(player)
        if not (player
            and player.Character
            and player.Character:FindFirstChild("Humanoid")
            and player.Character.Humanoid.Health > 0
            and player:GetAttribute('EnvironmentID') == local_player:GetAttribute('EnvironmentID')) then
            return false;
        end;

        if ELI.ragebot.ffa_mode then
            return true;
        end;

        return local_player:GetAttribute('TeamID') ~= player:GetAttribute('TeamID');
    end;

    function ELI.RagebotService:GetClosest()
        local closest, best = nil, math.huge;

        for _, player in next, players:GetPlayers() do
            if player ~= local_player and self:IsValid(player) then
                local rootpos = player.Character.HumanoidRootPart.Position;
                local mag = local_player:DistanceFromCharacter(rootpos);

                if mag < best then
                    closest, best = player, mag;
                end;
            end;
        end;

        return closest;
    end;

    ELI.ragebot.posmode = ELI.ragebot.posmode or 'Off';
    ELI.ragebot.orbit_r = ELI.ragebot.orbit_r or 4;
    ELI.ragebot.orbit_h = ELI.ragebot.orbit_h == nil and 0.5 or ELI.ragebot.orbit_h;
    getgenv()._eliKillFloor = function()
        local y = -460;
        pcall(function()
            local f = workspace.FallenPartsDestroyHeight;
            if type(f) == 'number' and f < -100 then y = f + 40 end;
        end);
        return y;
    end;
    getgenv()._eliGhostRestore = function(root, cf, vel, rot)
        task.defer(function()
            if root and root.Parent then root.CFrame, root.Velocity, root.RotVelocity = cf, vel, rot end;
        end);
    end;
    -- INVISIBLE plant: pure compute, never touches your body or camera.
    -- You stay at spawn moving freely; only the shot origin uses this CFrame.
    getgenv()._eliOrbitTick = function(troot, thead, myRoot)
        local R = ELI.ragebot.orbit_r or 4;
        local H = ELI.ragebot.orbit_h == nil and 0.5 or ELI.ragebot.orbit_h;
        local raw = tick() * 7.5;
        local arcC, arcH = math.pi, math.pi * 0.45;
        local la = arcC + math.sin(raw) * arcH;
        local hp = thead.Position;
        local fwd = troot.CFrame.LookVector;
        fwd = Vector3.new(fwd.X, 0, fwd.Z);
        if fwd.Magnitude < 0.05 then fwd = Vector3.new(0, 0, 1) end;
        fwd = fwd.Unit;
        local right = Vector3.new(fwd.Z, 0, -fwd.X);
        local ox = (math.cos(la) * right + math.sin(la) * fwd) * R;
        local want = Vector3.new(hp.X + ox.X, hp.Y + H, hp.Z + ox.Z);
        local floor = getgenv()._eliKillFloor() + 10;
        if want.Y < floor then want = Vector3.new(want.X, floor, want.Z) end;
        return CFrame.lookAt(want, hp);
    end;
    getgenv()._eliDesyncPlantRaw = function(target, troot, thead, myRoot)
        local mode = ELI.ragebot.posmode or 'Off';
        if mode == 'Fly' or mode == 'Orbit' then
            return getgenv()._eliOrbitTick(troot, thead, myRoot);
        elseif mode == 'Sky' then
            local pos = troot.Position + Vector3.new(0, 55, 0);
            local cf = CFrame.lookAt(pos, thead.Position);
            return cf;
        elseif mode == 'Underground' then
            local feet = troot.Position - Vector3.new(0, 4, 0);
            local pos = feet - Vector3.new(0, 3, 0);
            if pos.Y < getgenv()._eliKillFloor() + 4 then return nil end;
            local cf = CFrame.lookAt(pos, feet) * CFrame.Angles(math.pi / 2, 0, 0);
            return cf;
        elseif mode == 'Behind' then
            local back = troot.CFrame.LookVector;
            back = Vector3.new(back.X, 0, back.Z);
            if back.Magnitude < 0.05 then back = Vector3.new(0, 0, 1) end;
            back = back.Unit;
            local pos = troot.Position - back * 4 + Vector3.new(0, 1, 0);
            local cf = CFrame.lookAt(pos, thead.Position);
            return cf;
        elseif mode == 'Side' then
            local right = troot.CFrame.RightVector;
            right = Vector3.new(right.X, 0, right.Z);
            if right.Magnitude < 0.05 then right = Vector3.new(1, 0, 0) end;
            right = right.Unit;
            local sd = (getgenv()._EliDesyncSide or 1);
            getgenv()._EliDesyncSide = -sd;
            local pos = troot.Position + right * (sd * 6) + Vector3.new(0, 1, 0);
            local cf = CFrame.lookAt(pos, thead.Position);
            return cf;
        elseif mode == 'Camera' then
            local cam = workspace.CurrentCamera;
            if cam then return CFrame.lookAt(cam.CFrame.Position, thead.Position) end;
            return nil;
        elseif mode == 'Mixture' then
            local ph = math.floor(tick() / 3) % 3;
            if ph == 2 then return getgenv()._eliOrbitTick(troot, thead, myRoot) end;
            if ph == 0 then
                local pos = troot.Position + Vector3.new(0, 55, 0);
                local cf = CFrame.lookAt(pos, thead.Position);
                return cf;
            else
                local feet = troot.Position - Vector3.new(0, 4, 0);
                local pos = feet - Vector3.new(0, 3, 0);
                if pos.Y < getgenv()._eliKillFloor() + 4 then return nil end;
                local cf = CFrame.lookAt(pos, feet) * CFrame.Angles(math.pi / 2, 0, 0);
                return cf;
            end;
        end;
        return nil;
    end;
    getgenv().elisium_orbit_restore = function()
        local home = getgenv()._EliOrbitHome;
        getgenv()._EliOrbitHome = nil;
        if not home then return end;
        pcall(function()
            local ch = local_player.Character;
            local r = ch and ch:FindFirstChild('HumanoidRootPart');
            if r then r.CFrame = home r.Velocity = Vector3.zero r.RotVelocity = Vector3.zero end;
        end);
    end;
    -- height scale wrapper: 1 = underground (root - 5), 2 = head level, 3-10 = above head
    getgenv()._eliDesyncPlant = function(target, troot, thead, myRoot)
        local cf = nil;
        pcall(function() cf = getgenv()._eliDesyncPlantRaw(target, troot, thead, myRoot) end);
        if not cf then return nil end;
        local hs = tonumber(ELI.ragebot.height_scale) or 2;
        if hs == 2 then return cf end;
        if not (troot and troot.Parent and thead) then return cf end;
        local p = cf.Position;
        local rootY = troot.Position.Y;
        local headY = thead.Position.Y;
        local ty;
        if hs <= 1 then
            ty = rootY - 5;
        else
            local base = rootY - 5;
            local t = math.clamp(hs - 1, 0, 1);
            ty = base + (headY - base) * t;
            if hs > 2 then ty = headY + (hs - 2) * 4 end;
        end;
        local fl = getgenv()._eliKillFloor() + 4;
        if ty < fl then ty = fl end;
        local ok, ncf = pcall(function() return CFrame.lookAt(Vector3.new(p.X, ty, p.Z), thead.Position) end);
        return (ok and ncf) or cf;
    end;
    -- LOS gate: a plant inside a wall/roof used to dump every round
    -- into geometry. test each origin, fire only from a clear one.
    getgenv()._eliShotBlocked = function(from, to, targetChar)
        local ok, blocked = pcall(function()
            local params = RaycastParams.new();
            params.FilterType = Enum.RaycastFilterType.Exclude;
            local ignore = { local_player.Character };
            params.FilterDescendantsInstances = ignore;
            local hit = workspace:Raycast(from, to - from, params);
            if not hit then return false end;
            if targetChar and hit.Instance and hit.Instance:IsDescendantOf(targetChar) then
                return false;
            end;
            return true;
        end);
        if not ok then return false end;
        return blocked;
    end;
    function ELI.RagebotService:FireWeapon(target)
        if not target or not target.Character then return end;

        local fighter = fighter_controller.LocalFighter;
        if not fighter then return end;

        local item = fighter.EquippedItem;
        if not item then return end;
        if is_deflecting(target) or has_riot(target) then
            return
        end;
        local head = target.Character:FindFirstChild('HitboxHead')
            or target.Character:FindFirstChild('HitboxTorso')
            or target.Character:FindFirstChild('HumanoidRootPart');
        if not head then return end;

        local character = local_player.Character;
        if not character or not character:FindFirstChild('HumanoidRootPart') then return end;

        local plantPos = nil;
        do
            local mode = ELI.ragebot.posmode or 'Off';
            if mode ~= 'Off' then
                local troot = target.Character and target.Character:FindFirstChild('HumanoidRootPart');
                local thead = target.Character and (target.Character:FindFirstChild('HitboxHead') or target.Character:FindFirstChild('Head') or troot);
                local myRoot = character and (character:FindFirstChild('PhysicsRepRootPart') or character:FindFirstChild('HumanoidRootPart'));
                if troot and thead and myRoot then
                    local cf = nil;
                    pcall(function() cf = getgenv()._eliDesyncPlant(target, troot, thead, myRoot) end);
                    if cf then
                        local pp = cf.Position;
                        local bad = (pp.X ~= pp.X or pp.Y ~= pp.Y or pp.Z ~= pp.Z)
                            or pp.Y < -420 or pp.Y > 5000
                            or math.abs(pp.X) > 9000 or math.abs(pp.Z) > 9000;
                        if not bad then plantPos = pp end;
                    end;
                end;
            end;
        end;

        local aimPos = head.Position;

        if ELI.ragebot.prediction then
            local troot = target.Character:FindFirstChild('HumanoidRootPart');
            if troot then
                local ping = 0.05;
                pcall(function() ping = local_player:GetNetworkPing() end);
                local lead = math.clamp(ping, 0, 0.4) * (ELI.ragebot.prediction_amount or 1);
                aimPos = aimPos + troot.AssemblyLinearVelocity * lead;
            end;
        end;

        -- server origin wins: body is planted, so rep root IS the plant.
        -- plant + server go first, body last, camera fallback last.
        -- FALLBACK: wall blocks everything = fire from CAMERA anyway.
        local shootPos = nil;
        local camFallback = false;
        do
            local isBlocked = getgenv()._eliShotBlocked;
            local cands = {};
            local posmodeOn = (ELI.ragebot.posmode or 'Off') ~= 'Off';
            if posmodeOn and plantPos then cands[#cands + 1] = plantPos end;
            pcall(function()
                local sv = ELI.DesyncService and ELI.DesyncService.server;
                if typeof(sv) == 'Vector3' then cands[#cands + 1] = sv end;
            end);
            pcall(function()
                local repNow = fighter_controller.LocalFighter
                    and fighter_controller.LocalFighter.Entity
                    and fighter_controller.LocalFighter.Entity.RootPart;
                if repNow and repNow.Parent then
                    cands[#cands + 1] = repNow.Position;
                end;
            end);
            if (not posmodeOn) and plantPos then cands[#cands + 1] = plantPos end;
            local myHRP = character:FindFirstChild('HumanoidRootPart');
            if myHRP then cands[#cands + 1] = myHRP.Position + Vector3.new(0, 1.5, 0) end;
            for i, cand in ipairs(cands) do
                local blocked = true;
                pcall(function() blocked = isBlocked(cand, aimPos, target.Character) end);
                if not blocked then
                    shootPos = cand;
                    -- source label: report which origin fires.
                    local n = #cands;
                    if posmodeOn then
                        ELI.ragebot.status_text = (i == 1 and "ragebot (plant)")
                            or (i == 2 and "ragebot (server)") or "ragebot (body)";
                    else
                        ELI.ragebot.status_text = (i < n and "ragebot (server)") or "ragebot (body)";
                    end;
                    break;
                end;
            end;
            if not shootPos then
                -- walled off: camera origin, still fires with posmode aim.
                pcall(function()
                    local cam = workspace.CurrentCamera;
                    if cam then shootPos = cam.CFrame.Position end;
                end);
                if shootPos then
                    camFallback = true;
                    ELI.ragebot.status_text = "ragebot (camera)";
                else
                    ELI.ragebot.status_text = "ragebot: no origin";
                    return
                end;
            end;
        end;

        -- HIT-ALL: fire N attempts per tick (slider), each with micro
        -- jitter around head center. jitter covers spread pattern so at least
        -- one round connects even if the first grazes. live spread zeroed so
        -- every attempt flies true from the same origin.
        pcall(function()
            local info = item.Info;
            if type(info) == "table" then
                for _, k in ipairs({ "ShootSpread", "Spread", "Bloom",
                    "ShootSpreadPerVelocityUnit", "ShootSpreadPerVelocityLimit" }) do
                    if type(info[k]) == "number" and info[k] ~= 0 then info[k] = 0 end;
                end;
            end;
        end);
        local oid = item:Get('ObjectID');
        local enumShoot = enum_lib:ToEnum('StartShooting');
        local n = math.clamp(math.floor(tonumber(ELI.ragebot.shoot_attempts) or 1), 1, 10);
        -- aim at head CENTER-mass: biggest window, jitter ±0.35 covers edges.
        for i = 1, n do
            local ap = aimPos;
            if n > 1 then
                local a = (i / n) * math.pi * 2;
                ap = aimPos + Vector3.new(math.cos(a) * 0.35, math.sin(a) * 0.35, 0);
            end;
            local data = {
                [utf8.char(1)] = {
                    [utf8.char(0)] = utility:EncodeCFrame(CFrame.new(shootPos, ap)),
                    [utf8.char(1)] = utility:EncodeCFrame(CFrame.new(shootPos, ap)),
                    [utf8.char(2)] = head,
                    [utf8.char(1)] = utility:EncodeCFrame(CFrame.new(shootPos, ap)),
                },
            };
            replicated_storage.Remotes.Replication.Fighter.UseItem:FireServer(oid, enumShoot, data, nil);
        end;
        if ELI.ragebot.void_spam then
            ELI.ragebot.status_text = "ragebot";
        end;
    end;

    function ELI.RagebotService:ProjectileHandler()
        -- KICIA TRIPMINE AUTO PORT (lives in ragebot): tag-tracked entries,
        -- team trigger included. auto = enemy mines only, team = +own/friendly.
        ELI.ragebot.trip_auto = ELI.ragebot.trip_auto or false;
        ELI.ragebot.trip_team = ELI.ragebot.trip_team or false;
        getgenv()._KiciaTrip = getgenv()._KiciaTrip or { entries = setmetatable({}, { __mode = "k" }), conns = setmetatable({}, { __mode = "k" }) };
        local TR = getgenv()._KiciaTrip;
        local function tripUntrack(tm)
            local e = TR.entries[tm];
            if e and e.Hitbox then TR.entries[e.Hitbox] = nil end;
            TR.entries[tm] = nil;
            local c = TR.conns[tm];
            if c then pcall(function() c:Disconnect() end) end;
            TR.conns[tm] = nil;
        end;
        local function tripTrack(tm)
            if not tm or TR.entries[tm] then return end;
            task.spawn(function()
                local hb = tm:WaitForChild('Hitbox', 3);
                if not hb or not hb:IsA('BasePart') or not tm.Parent then return end;
                local e = { Tripmine = tm, Hitbox = hb,
                    EnvironmentId = tm:GetAttribute('EnvironmentID'),
                    PlacedBy = tm:GetAttribute('PlacedByUserId'),
                    TeamId = tm:GetAttribute('TeamID') };
                TR.entries[tm] = e;
                TR.entries[hb] = e;
                TR.conns[tm] = hb.Destroying:Connect(function() tripUntrack(tm) end);
            end);
        end;
        if not TR.bound then
            TR.bound = true;
            pcall(function()
                local CS = game:GetService('CollectionService');
                CS:GetInstanceAddedSignal('SubspaceTripmine'):Connect(tripTrack);
                CS:GetInstanceRemovedSignal('SubspaceTripmine'):Connect(tripUntrack);
                for _, tm in ipairs(CS:GetTagged('SubspaceTripmine')) do tripTrack(tm) end;
            end);
        end;
        -- KICIA Update equivalent: touch own char to enemy mine hitbox.
        if not TR.loop then
            TR.loop = run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
                if not (ELI.ragebot.enable and (ELI.ragebot.trip_auto or ELI.ragebot.trip_team)) then return end;
                if not getgenv().elisium_in_duel() then return end;
                local ch = local_player.Character;
                local touch = ch and (ch:FindFirstChild('HumanoidRootPart') or ch.PrimaryPart);
                if not touch then return end;
                local lf = fighter_controller.LocalFighter;
                local myEnv = (lf and lf:Get('EnvironmentID')) or ch:GetAttribute('EnvironmentID');
                local myTeam = (lf and lf:Get('TeamID')) or local_player:GetAttribute('TeamID');
                for tm, e in pairs(TR.entries) do
                    if tm == e.Tripmine then
                        local hb = e.Hitbox;
                        if not hb or not hb.Parent or not tm.Parent then
                            tripUntrack(tm);
                        else
                            local friendly = e.PlacedBy == local_player.UserId;
                            if not friendly and myTeam ~= nil and e.TeamId ~= nil then
                                friendly = myTeam == e.TeamId;
                            end;
                            -- KICIA team trigger: friendly mines only fire when team ON.
                            if e.EnvironmentId == myEnv and (not friendly or ELI.ragebot.trip_team) then
                                pcall(firetouchinterest, hb, touch, 0);
                                pcall(firetouchinterest, hb, touch, 1);
                                return;
                            end;
                        end;
                    end;
                end;
            end));
            trove:Add(TR.loop);
        end;
        workspace.DescendantAdded:Connect(function(child)
            if not ELI.ragebot.enable then return end;

            if child:IsA('BasePart') or child:IsA('Model') then
                if child.Name == "Slingshot" or child.Name == "CoreProjectile" or child.Name == "OuterProjectile" then
                    task.spawn(function()
                        task.wait(0.03);

                        local proj = child:IsA('BasePart') and child or child:FindFirstChildWhichIsA('BasePart');
                        if not proj then return end;

                        proj.CanTouch = true;

                        for i = 1, 45 do
                            if not ELI.ragebot.enable or not getgenv().elisium_in_duel() then break end;

                            local target = self:GetClosest();
                            if target and target.Character then
                                local hitpart = target.Character:FindFirstChild('HitboxHead') or target.Character:FindFirstChild('HumanoidRootPart');

                                if hitpart and hitpart:IsA("BasePart")
                                    and hitpart.Parent
                                    and proj.Parent
                                    and hitpart:IsDescendantOf(workspace)
                                    and proj:IsDescendantOf(workspace)
                                then
                                    pcall(firetouchinterest, hitpart, proj, 0);
                                    pcall(firetouchinterest, hitpart, proj, 1);
                                end;
                            end;
                            task.wait();
                        end;
                    end);
                end;
            end;
        end);
    end;

    function ELI.RagebotService:Start()
        if self.connection then return end;

        self.connection = run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
            if not ELI.ragebot.enable then
                self:Stop();
                return
            end;

            if not getgenv().elisium_in_duel() then
                -- DOUBLE-TOGGLE FIX: old code self:Stop() here = enabling in
                -- lobby instantly disconnected the loop, joining a duel later
                -- left it dead until off/on. now idle: keep connection, park
                -- desync, clear lock. loop wakes on its own in-duel.
                getgenv()._eliRageLock = nil;
                ELI.DesyncService:Stop();
                return
            end;

            local target = self:GetClosest();
            if not target then ELI.DesyncService:Stop() return end;

            local fighter = fighter_controller.LocalFighter;
            if not fighter then ELI.DesyncService:Stop() return end;

            local item = fighter.EquippedItem;
            if not item then ELI.DesyncService:Stop() return end;

            local target_fighter = fighter_controller:GetFighter(target);
            if not target_fighter then ELI.DesyncService:Stop() return end;

            local viewmodel = item.ViewModel;
            if not viewmodel then ELI.DesyncService:Stop() return end;
            local target_entity = target_fighter.Entity;
            if not target_entity or target_entity:Get('IsInvincible') then ELI.DesyncService:Stop() return end;

            -- pov circle gate: head must sit inside the circle to fire.
            -- FIXED-POSMODE-RANGE: position mode fires at ANY distance, still
            -- or moving. plant/teleport puts the shot next to them anyway, so
            -- the screen-space circle is meaningless there. posmode ~= Off
            -- bypasses the gate entirely; Off keeps the old circle behavior.
            do
                local posmode = ELI.ragebot.posmode or 'Off';
                if posmode ~= 'Off' then
                    getgenv()._eliRageLock = { x = nil, y = nil, inside = true };
                else
                local lockX, lockY, inside = nil, nil, false;
                local char = target.Character;
                local hp = char and (char:FindFirstChild('HitboxHead') or char:FindFirstChild('Head'));
                if hp then
                    local sp, on = camera:WorldToViewportPoint(hp.Position);
                    if on then
                        local ccx, ccy = camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2;
                        pcall(function()
                            if RF and RF.pos then ccx, ccy = RF.pos.X, RF.pos.Y end;
                        end);
                        if (Vector2.new(sp.X, sp.Y) - Vector2.new(ccx, ccy)).Magnitude <= (ELI.ragebot.fov_radius or 180) then
                            inside = true; lockX, lockY = sp.X, sp.Y;
                        end;
                    end;
                end;
                getgenv()._eliRageLock = { x = lockX, y = lockY, inside = inside };
                if ELI.ragebot.fov_only ~= false and not inside then
                    ELI.DesyncService:Stop();
                    ELI.ragebot.status_text = "ragebot: waiting in circle";
                    return;
                end;
                end;
            end;

            if (ELI.ragebot.mode or 'Auto') == 'Manual' then
                local held = false;
                pcall(function()
                    held = uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton1);
                end);
                if not held then return end;
            end;

            if item:Get('Ammo') and item:Get('Ammo') > 0 and not viewmodel:IsAnimationPlaying('Reload') then
                if self.debounce == false then
                    self.debounce = os.clock() + 0.5;
                    return
                end;

                if typeof(self.debounce) == 'number' and os.clock() < self.debounce then
                    return
                end;

                if typeof(self.debounce) == 'number' then
                    self.debounce = true;
                end;

                ELI.DesyncService:Start(target);

                if not target.Character then return end;

                if ELI.DesyncService.server then
                    -- fast shots: 20/sec. flood cap stays (was 60/s = 0 fps).
                    if os.clock() - (self.lastShot or 0) < 0.05 then return end;
                    self.lastShot = os.clock();
                    self:FireWeapon(target);
                end;
            else
                if not viewmodel:IsAnimationPlaying('Reload') then
                    setthreadidentity(2);
                    item:Input('StartReloading');
                    setthreadidentity(7);
                end;
            end;
        end));
    end;

    function ELI.RagebotService:Stop()
        pcall(function() getgenv().elisium_orbit_restore() end);
        if self.connection then
            self.connection:Disconnect();
            self.connection = nil;
        end;
        self.debounce = false;
        ELI.DesyncService:Stop();
    end;

    ELI.RagebotService:Init();
    ELI.RagebotService:ProjectileHandler();
end;

local ragebot_tab = Tabs.Main:AddRightGroupbox('ragebot') do

    ragebot_tab:AddLabel('warning: ragebot is detected - use at your own risk', true);

