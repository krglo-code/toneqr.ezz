    -- == VOID MOVEMENT (ported from Phillnoob, duels-only gate) ==
    ELI.voidmove = ELI.voidmove or { enable = false, pattern = "Random Far", distance = 500, interval = 0.035, jitter = 14, spin = false, spin_speed = 720, spin_jitter_x = 30, spin_jitter_y = 8, spin_spread = 300 };
    local VM = ELI.voidmove;
    local vm_vX = math.random(-1e8, 1e8); local vm_vZ = math.random(-1e8, 1e8); local vm_vYBase = 1e10 + math.random(-5e9, 5e9); local vm_vYOff = 0; local vm_vYDir = 1; local vm_vDX = math.random() * 2 - 1; local vm_vDZ = math.random() * 2 - 1; local vm_vT = 0; local vm_lastTp = 0; local vm_home = nil; local vm_riotT0 = 0; local vm_riotSeed = math.random(1000, 9999);
    local function vmInDuel() local ok, v = pcall(function() return local_fighter and local_fighter:Get("IsInDuel") == true end) return ok and v == true end;
    local function vmResetPattern() vm_vX = math.random(-1e8, 1e8); vm_vZ = math.random(-1e8, 1e8); vm_vYOff = 0; vm_vYDir = 1; vm_vDX = math.random() * 2 - 1; vm_vDZ = math.random() * 2 - 1; vm_vT = 0; vm_vYBase = 1e10 + math.random(-5e9, 5e9) end;
    local function vmFarPos(dt) vm_vT = vm_vT + dt; local mode = VM.pattern; local dist = VM.distance; if mode == "Still Point" then return Vector3.new(vm_vX, vm_vYBase + vm_vYOff, vm_vZ) end; if mode == "Slow Drift" then local t = vm_vT; vm_vX = vm_vX + vm_vDX * 9e6 * dt; vm_vZ = vm_vZ + vm_vDZ * 9e6 * dt; vm_vYOff = vm_vYOff + vm_vYDir * 4e6 * dt; if math.abs(vm_vYOff) >= 2e9 then vm_vYDir = -vm_vYDir end; return Vector3.new(vm_vX, vm_vYBase + vm_vYOff, vm_vZ) end; if mode == "Circle" then local r = math.max(dist * 1000, 1e9) * (1 + math.sin(vm_vT)); return Vector3.new(vm_vX + math.cos(vm_vT * 3) * r, vm_vYBase + vm_vYOff, vm_vZ + math.sin(vm_vT * 3) * r) end; if mode == "Figure Eight" then local r = math.max(dist * 2000, 2e9); return Vector3.new(vm_vX + math.sin(vm_vT * 2) * r, vm_vYBase + math.sin(vm_vT * 4) * r * 0.1, vm_vZ + math.sin(vm_vT * 3) * r) end; if mode == "Grid Hop" then local cell = math.max(dist * 5000, 5e8); local step = math.floor(vm_vT * 8); local gx = (step % 5) - 2; local gz = (math.floor(step / 5) % 5) - 2; local gy = 0; if step % 2 == 1 then gy = cell * 0.18 end; return Vector3.new(vm_vX + gx * cell, vm_vYBase + gy, vm_vZ + gz * cell) end; if mode == "Blink" then if tick() % 0.1 < 0.05 then return Vector3.new(vm_vX * 2, vm_vYBase + 1e11, vm_vZ * 2) end; return Vector3.new(vm_vX, vm_vYBase, vm_vZ) end; local r = math.max(dist * 10000, 1e11); local sgn = 1; if math.random() < 0.5 then sgn = -1 end; return Vector3.new(vm_vX + r * sgn + math.random(-1e9, 1e9), vm_vYBase + math.random(-1e8, 1e8), vm_vZ + r * sgn + math.random(-1e9, 1e9)) end;
    local function vmSpinTick(dt) local char = local_player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); if not root then return end; local t = tick() - vm_riotT0; local spread = VM.spin_spread / 300; local yaw = math.rad(VM.spin_speed * dt); local pitch = math.rad(VM.spin_speed * 0.37 * dt * math.sin(t * 3.1)); local roll = math.rad(VM.spin_speed * 0.19 * dt * math.cos(t * 5.7 + vm_riotSeed)); local scf = root.CFrame * CFrame.Angles(pitch, yaw, roll); local jX = (math.random() - 0.5) * VM.spin_jitter_x * spread * 2; local jY = (math.random() - 0.5) * VM.spin_jitter_y * spread; local jZ = (math.random() - 0.5) * VM.spin_jitter_x * spread * 2; local ny = scf.Position.Y + jY; if ny < 2 then ny = 2 end; root.CFrame = scf + Vector3.new(jX, ny - scf.Position.Y, jZ) end;
    trove:Add(run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt) if not VM.enable then return end; if not vmInDuel() then return end; local char = local_player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); if not root then return end; if tick() - vm_lastTp < VM.interval then if VM.spin then vmSpinTick(dt) end; return end; vm_lastTp = tick(); local pos = vmFarPos(dt or 0.035); root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero; root.CFrame = CFrame.new(pos); if VM.spin then vmSpinTick(dt or 0.016) end end)));
    local vmBox = Tabs.Main:AddRightGroupbox("void movement");
    vmBox:AddToggle("vm_enable", { Text = "void movement (duels only)", Default = false, Callback = function(v) VM.enable = v; if v then vmResetPattern(); vm_riotT0 = tick(); if local_player.Character and local_player.Character:FindFirstChild("HumanoidRootPart") then vm_home = local_player.Character.HumanoidRootPart.CFrame end else local char = local_player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); if root and vm_home then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero; root.CFrame = vm_home end end end });
    vmBox:AddDropdown("vm_pattern", { Text = "void pattern", Values = { "Random Far", "Still Point", "Slow Drift", "Circle", "Figure Eight", "Grid Hop", "Blink" }, Default = "Random Far", Callback = function(v) VM.pattern = tostring(v) end });
    vmBox:AddSlider("vm_distance", { Text = "distance", Default = 500, Min = 50, Max = 50000000, Rounding = 0, Suffix = " studs", Callback = function(v) VM.distance = v end });
    vmBox:AddSlider("vm_interval", { Text = "step interval", Default = 0.035, Min = 0.01, Max = 2, Rounding = 3, Suffix = "s", Callback = function(v) VM.interval = v end });
    vmBox:AddSlider("vm_jitter", { Text = "jitter strength", Default = 14, Min = 0, Max = 60, Rounding = 0, Callback = function(v) VM.jitter = v end });
    vmBox:AddToggle("vm_spin", { Text = "spin motion (duels only)", Default = false, Callback = function(v) VM.spin = v; if v then vm_riotT0 = tick() end end });
    vmBox:AddSlider("vm_spin_speed", { Text = "spin speed", Default = 720, Min = 0, Max = 12000, Rounding = 0, Suffix = " deg/s", Callback = function(v) VM.spin_speed = v end });
    vmBox:AddSlider("vm_spin_jx", { Text = "horizontal jitter", Default = 30, Min = 0, Max = 120, Rounding = 0, Callback = function(v) VM.spin_jitter_x = v end });
    vmBox:AddSlider("vm_spin_jy", { Text = "vertical jitter", Default = 8, Min = 0, Max = 60, Rounding = 0, Callback = function(v) VM.spin_jitter_y = v end });
    vmBox:AddSlider("vm_spin_spread", { Text = "spread distance", Default = 300, Min = 1, Max = 5000, Rounding = 0, Suffix = " studs", Callback = function(v) VM.spin_spread = v end });
    vmBox:AddButton("reset pattern", function() vmResetPattern() end);
    -- == SUBJECT ORBIT (ported from Phillnoob, duels-only gate, silent) ==
    ELI.orbit = ELI.orbit or { enable = false, target = "", mode = "Circle", face = true, radius = 8, height = 4, speed = 1.8 };
    local OB = ELI.orbit; local ob_angle = 0;
    local function obTarget()
        local char = local_player.Character;
        local root = char and char:FindFirstChild("HumanoidRootPart");
        if not root then return nil end;
        if OB.target ~= "" then
            local sel = nil;
            pcall(function() sel = players:FindFirstChild(OB.target) end);
            if sel and sel ~= local_player and sel.Character then
                local r = sel.Character:FindFirstChild("HumanoidRootPart");
                local h = sel.Character:FindFirstChildOfClass("Humanoid");
                if r and h and h.Health > 0 then return sel end;
            end;
        end;
        local closest, bestDist = nil, math.huge;
        for _, s in ipairs(players:GetPlayers()) do
            if s ~= local_player and s.Character then
                local r = s.Character:FindFirstChild("HumanoidRootPart");
                local h = s.Character:FindFirstChildOfClass("Humanoid");
                if r and h and h.Health > 0 then
                    local d = (root.Position - r.Position).Magnitude;
                    if d < bestDist then bestDist = d; closest = s end;
                end;
            end;
        end;
        return closest;
    end;
    local function obOffset(a) if OB.mode == "Figure Eight" then return Vector3.new(math.sin(a) * OB.radius, OB.height, math.sin(a * 2) * OB.radius * 0.5) end; if OB.mode == "Vertical Wave" then return Vector3.new(math.cos(a) * OB.radius, OB.height + math.sin(a * 2) * OB.radius * 0.5, math.sin(a) * OB.radius) end; if OB.mode == "Square" then local t = (a / math.pi) % 4; local side = math.floor(t); local f = t - side; local r = OB.radius; if side == 0 then return Vector3.new(-r + f * 2 * r, OB.height, -r) end; if side == 1 then return Vector3.new(r, OB.height, -r + f * 2 * r) end; if side == 2 then return Vector3.new(r - f * 2 * r, OB.height, r) end; return Vector3.new(-r, OB.height, r - f * 2 * r) end; return Vector3.new(math.cos(a) * OB.radius, OB.height, math.sin(a) * OB.radius) end;
    trove:Add(run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt) if not OB.enable then return end; if not vmInDuel() then return end; local char = local_player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); if not root then return end; local tgt = obTarget(); local tr = tgt and tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart"); if tr then ob_angle = ob_angle + dt * OB.speed; local pos = tr.Position + obOffset(ob_angle); if OB.face then root.CFrame = CFrame.new(pos, tr.Position) else root.CFrame = CFrame.new(pos) * (root.CFrame - root.Position) end end end)));
    local obBox = Tabs.Main:AddRightGroupbox("subject orbit");
    obBox:AddDropdown("ob_target", { Text = "subject", Values = (function() local o = {}; pcall(function() for _, s in eli_ipairs(players:GetPlayers()) do if s ~= local_player then o[#o+1] = s.Name end end end); table.sort(o); return o end)(), Default = "", AllowNull = true, Callback = function(v) OB.target = tostring(v or "") end });
    obBox:AddToggle("ob_enable", { Text = "orbit subject (duels only)", Default = false, Callback = function(v) OB.enable = v end });
    obBox:AddDropdown("ob_mode", { Text = "orbit mode", Values = { "Circle", "Figure Eight", "Vertical Wave", "Square" }, Default = "Circle", Callback = function(v) OB.mode = tostring(v) end });
    obBox:AddToggle("ob_face", { Text = "face target", Default = true, Callback = function(v) OB.face = v end });
    obBox:AddSlider("ob_radius", { Text = "orbit radius", Default = 8, Min = 2, Max = 60, Rounding = 0, Suffix = " studs", Callback = function(v) OB.radius = v end });
    obBox:AddSlider("ob_height", { Text = "orbit height", Default = 4, Min = -20, Max = 40, Rounding = 0, Suffix = " studs", Callback = function(v) OB.height = v end });
    obBox:AddSlider("ob_speed", { Text = "orbit speed", Default = 1.8, Min = 0.1, Max = 12, Rounding = 1, Callback = function(v) OB.speed = v end });
    obBox:AddButton("snap to orbit", function() local char = local_player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); local tgt = obTarget(); local tr = tgt and tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart"); if not (root and tr) then return end; local pos = tr.Position + obOffset(ob_angle); if OB.face then root.CFrame = CFrame.new(pos, tr.Position) else root.CFrame = CFrame.new(pos) * (root.CFrame - root.Position) end end);
    vmBox:AddButton("stop + return", function() VM.enable = false; if Toggles.vm_enable then Toggles.vm_enable:SetValue(false) end; local char = local_player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); if root and vm_home then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero; root.CFrame = vm_home end end);
end

-- == RAGE EVASION + LIVE ANTI-AIM ==
-- Evasion positions the rep root, anti-aim rotates it.
-- Yields to DesyncService while rage is actively firing.
do
    getgenv()._eliRageSaved = getgenv()._eliRageSaved or nil;
    getgenv()._eliEvAccum = getgenv()._eliEvAccum or 0;
    getgenv()._eliEvPos = getgenv()._eliEvPos or nil;

    local function voidFloor()
        local y = -460;
        pcall(function()
            local f = workspace.FallenPartsDestroyHeight;
            if type(f) == 'number' and f < -100 then y = f + 40 end;
        end);
        return y;
    end;

    -- Translocate compute (f257 port): OutOfBounds kill part, stand on its underside
    -- LAGFIX: part lookup cached 5s. old code walked CollectionService tags
    -- and on miss the WHOLE workspace tree, every 0.12s = 0 fps by itself.
    local evPartCache, evPartCacheAt = nil, 0;
    local function evTranslocateCF(clientCF)
        local pos = clientCF.Position;
        local offset = ELI.ragebot.evasion_offset or 2;
        local part = nil;
        if evPartCache and evPartCache.Parent and tick() - evPartCacheAt < 5 then
            part = evPartCache;
        else
            pcall(function()
                local CS = game:GetService('CollectionService');
                for _, inst in ipairs(CS:GetTagged('OutOfBoundsPart')) do
                    if inst:IsA('BasePart') and inst:GetAttribute('KillDelay') == 0 then
                        part = inst;
                        break;
                    end;
                end;
            end);
            if not part then
                pcall(function()
                    for _, d in ipairs(workspace:GetDescendants()) do
                        if d:IsA('BasePart') and d.Name == 'OutOfBoundsPart' and d:GetAttribute('KillDelay') == 0 then
                            part = d;
                            break;
                        end;
                    end;
                end);
            end;
            if part then evPartCache, evPartCacheAt = part, tick() end;
        end;
        if not part then return CFrame.new(pos) end;
        return part.CFrame * CFrame.new(0, -part.Size.Y / 2 + offset, 0);
    end;

    -- single rage movement loop: evasion positions, anti-aim rotates
    trove:Add(run_service.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function(dt)
        local rb = ELI.ragebot;
        local wantAA = rb.aa_enabled == true;
        local wantEv = rb.evasion_enabled == true and (rb.evasion_mode or 'Off') ~= 'Off';
        if not (wantAA or wantEv) or not getgenv().elisium_in_duel() then
            local saved = getgenv()._eliRageSaved;
            if saved and saved.root and saved.root.Parent then
                pcall(function()
                    saved.root.CFrame = saved.cf;
                    saved.root.AssemblyLinearVelocity = Vector3.zero;
                    saved.root.RotVelocity = Vector3.zero;
                end);
            end;
            getgenv()._eliRageSaved = nil;
            getgenv()._eliEvPos = nil;
            return;
        end;
        -- DesyncService owns the body while rage is firing; don't fight it
        if ELI.DesyncService and ELI.DesyncService.active then return end;
        local char = local_player.Character;
        local hrp = char and char:FindFirstChild('HumanoidRootPart');
        if not hrp then return end;
        local hum = char:FindFirstChildOfClass('Humanoid');
        if hum and hum.Health <= 0 then return end;
        local rep = char:FindFirstChild('PhysicsRepRootPart') or hrp;
        if not getgenv()._eliRageSaved then
            getgenv()._eliRageSaved = { root = rep, cf = rep.CFrame };
        end;
        local basePos = hrp.Position;
        if wantEv then
            getgenv()._eliEvAccum = (getgenv()._eliEvAccum or 0) + (dt or 0.016);
            local emode = rb.evasion_mode or 'Off';
            if emode == 'Translocate' then
                if getgenv()._eliEvAccum >= 0.12 then
                    getgenv()._eliEvAccum = 0;
                    local cf;
                    pcall(function() cf = evTranslocateCF(hrp.CFrame) end);
                    if cf then getgenv()._eliEvPos = cf.Position end;
                end;
                if getgenv()._eliEvPos then basePos = getgenv()._eliEvPos end;
            elseif emode == 'Random' then
                -- camera-anchored random, like ragebot Camera mode
                if getgenv()._eliEvAccum >= 0.12 then
                    getgenv()._eliEvAccum = 0;
                    local base = hrp.Position;
                    pcall(function()
                        local cam = workspace.CurrentCamera;
                        if cam then base = cam.CFrame.Position end;
                    end);
                    local r = math.max((rb.evasion_offset or 2) * 10, 5);
                    local np = base + Vector3.new(math.random(-r, r), math.random(-r * 0.4, r * 0.4), math.random(-r, r));
                    local fl = voidFloor() + 6;
                    if np.Y < fl then np = Vector3.new(np.X, fl, np.Z) end;
                    getgenv()._eliEvPos = np;
                end;
                if getgenv()._eliEvPos then basePos = getgenv()._eliEvPos end;
            end;
        end;
        if wantAA and rb.aa_floor_hide and hrp.Position.Y < 8 then
            local cf = hrp.CFrame * CFrame.new(0, -3, 0);
            pcall(function()
                rep.CFrame = cf;
                rep.AssemblyLinearVelocity = Vector3.zero;
                rep.RotVelocity = Vector3.zero;
            end);
            return;
        end;
        local yaw = 0; local pitch = 0;
        if wantAA then
            yaw = math.rad((rb.aa_yaw or 0) + (rb.aa_custom_yaw or 0));
            pitch = math.rad((rb.aa_pitch or 0) + (rb.aa_custom_pitch or 0));
        end;
        if wantEv then
            -- teleport cheat: pin position + kill velocity so it sticks
            local cf = CFrame.new(basePos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0);
            if rb.evasion_force_crouch then
                cf = cf * CFrame.new(0, -1.5, 0);
            end;
            pcall(function()
                rep.CFrame = cf;
                rep.AssemblyLinearVelocity = Vector3.zero;
                rep.RotVelocity = Vector3.zero;
            end);
        elseif wantAA then
            -- anti-aim alone: rotate in place, never touch position or velocity
            -- so jumping, falling and walkspeed feel untouched
            pcall(function()
                rep.CFrame = CFrame.new(rep.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0);
            end);
        end;
    end)));
end

do
    local opt_tab = Tabs.misc_tab;
    local function apply(kind) pcall(function() getgenv().elisium_apply_opt(kind) end) end;

    local boost_box = opt_tab:AddLeftGroupbox('fps boost');

    boost_box:AddToggle('opt_no_particles', {
        Text = 'remove particles & effects',
        Default = false,
