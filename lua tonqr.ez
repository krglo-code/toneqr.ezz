-- LOADOUT FIX: never Replicate WeaponInventory while CanPickWeapons is true
local function elisium_safe_weapon_inv_rep()
    local picking = false
    pcall(function()
        local lf = fighter_controller and fighter_controller.LocalFighter
        picking = lf and lf:Get("CanPickWeapons") == true
    end)
    if picking then return false end
    pcall(function()
        if data_ctrl and data_ctrl.CurrentData then
            data_ctrl.CurrentData:Replicate("WeaponInventory")
        end
    end)
    return true
end
getgenv().elisium_safe_weapon_inv_rep = elisium_safe_weapon_inv_rep

