		crimson = {'ff3b5c','120a0e','1a0f13','221418','3a1d22','2e2024','f5e8ea'},
		emerald = {'2fe08a','08120d','0e1a13','12241a','1d3a2a','203027','e8f5ec'},
		royal = {'965afa','0e0a16','130f1d','1a1426','2a1f3d','262133','efe8f7'},
		sunset = {'ff8a3c','140e08','1a120c','241a10','3d2a1c','33271d','f7ece0'},
		ocean = {'3cb8ff','081018','0d141d','111c28','1c2a3d','1f2a3a','e0f0f7'},
		mono = {'ffffff','0a0a0a','121212','1a1a1a','262626','202020','f5f5f5'},
		grape = {'c86bff','100a14','150e1e','1d1428','2e1f3d','2a2136','f2e8f7'},
	};
	samples_sec:AddDropdown('toneqr_sample', {
		Text = 'preset',
		Values = {'periwinkle','crimson','emerald','royal','sunset','ocean','mono','grape'},
		Default = 'periwinkle',
		Callback = function(v)
			local pr = toneqrLumenData[v];
			if not pr then return end
			Lumen.Theme.Accent = Color3.fromHex(pr[1]);
			Lumen.Theme.Background = Color3.fromHex(pr[2]);
			Lumen.Theme.Surface = Color3.fromHex(pr[3]);
			Lumen.Theme.SurfaceAlt = Color3.fromHex(pr[4]);
			Lumen.Theme.Border = Color3.fromHex(pr[5]);
			Lumen.Theme.SectionBorder = Color3.fromHex(pr[6]);
			Lumen.Theme.Text = Color3.fromHex(pr[7]);
			Lumen:ApplyTheme();
		end;
	});
end;
do
pcall(function() if makefolder and isfolder and not isfolder('toneqr.ez') then makefolder('toneqr.ez') end end);
	local lbg_sec = Tabs.Theme:AddRightGroupbox('background');
	local lbg = { img = nil };
	local function lbg_files()
		local out = { 'none' };
		pcall(function()
			if listfiles and isfolder and isfolder('toneqr.ez') then
				for _, f in ipairs(listfiles('toneqr.ez')) do
					local n = tostring(f):match('([^/\\]+)$');
					if n then
						local l = n:lower();
						if l:sub(-4) == '.png' or l:sub(-4) == '.jpg' or l:sub(-5) == '.jpeg' then
							table.insert(out, n);
						end;
					end;
				end;
			end;
		end);
		table.sort(out);
		return out;
	end
	local function lbg_canvas()
		if LumenWindow and LumenWindow.Canvas then return LumenWindow.Canvas end
		return nil;
	end
	local function lbg_clear()
		if lbg.img then pcall(function() lbg.img:Destroy() end) lbg.img = nil end
		local cv = lbg_canvas();
		if cv then cv.BackgroundTransparency = 0 end
	end
	local function lbg_current()
		local idTxt = Options.toneqr_lbg_id and Options.toneqr_lbg_id.Value or '';
		local f = Options.toneqr_lbg_file and Options.toneqr_lbg_file.Value or 'none';
		local asset = '';
		if idTxt ~= '' then
			local digits = tostring(idTxt):match('(%d+)');
			if digits then asset = 'rbxassetid://' .. digits
			elseif tostring(idTxt):match('^rbxasset') then asset = tostring(idTxt) end
		end;
		if asset == '' and f ~= '' and f ~= 'none' then
			local ok, a = pcall(getcustomasset, 'toneqr.ez/' .. f);
			if ok and a then asset = a end
		end;
		return asset;
	end
	local function lbg_refresh()
		lbg_clear();
		local on = Toggles.toneqr_lbg_enable and Toggles.toneqr_lbg_enable.Value;
		if not on then return end
		local asset = lbg_current();
		if asset == '' then return end
		local cv = lbg_canvas();
		if not cv then return end
		local img = Instance.new('ImageLabel');
		img.Name = 'toneqrBackground';
		img.BackgroundTransparency = 1;
		img.BorderSizePixel = 0;
		img.Size = UDim2.new(1, 0, 1, 0);
		img.Image = asset;
		img.ImageTransparency = (Options.toneqr_lbg_trans and tonumber(Options.toneqr_lbg_trans.Value)) or 0.15;
		img.ScaleType = Enum.ScaleType.Crop;
		img.ZIndex = 0;
		img.Parent = cv;
		lbg.img = img;
		cv.BackgroundTransparency = 0.35;
	end
	lbg_sec:AddToggle('toneqr_lbg_enable', {
		Text = 'enable background',
		Default = false,
		Callback = function(v) lbg_refresh() end;
	});
	lbg_sec:AddDropdown('toneqr_lbg_file', {
		Text = 'image file (toneqr.ez/)',
		Values = lbg_files(),
		Default = 'none',
		Callback = function(v) lbg_refresh() end;
	});
	lbg_sec:AddInput('toneqr_lbg_id', {
		Text = 'asset id (optional)',
		Default = '',
		Placeholder = 'rbxassetid://...',
		Callback = function(v) lbg_refresh() end;
	});
	lbg_sec:AddSlider('toneqr_lbg_trans', {
		Text = 'image transparency',
		Default = 0.15,
		Min = 0,
		Max = 1,
		Rounding = 2,
		Callback = function(v)
			if lbg.img then lbg.img.ImageTransparency = v end
		end;
	});
	lbg_sec:AddButton('refresh list', function()
		if Options.toneqr_lbg_file then Options.toneqr_lbg_file:SetValues(lbg_files()) end
	end);
	lbg_sec:AddLabel('drop any .png / .jpg into the toneqr.ez folder, then refresh', true);
end;

