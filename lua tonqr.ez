-- Extra emotes: game-scanned animations + your custom id. Same shape as
-- HUB_EMOTES (name -> asset-id pool, first rig-compatible id wins through
-- the same hubLoadEmoteTrack path), so everything plays uniformly.
getgenv()._HubEmoteExtra = getgenv()._HubEmoteExtra or {}


function hubEmoteIdsFor(name)
    if HUB_EMOTES[name] then return HUB_EMOTES[name] end
    local ex = getgenv()._HubEmoteExtra
    if type(ex) == "table" and ex[name] then return ex[name] end
    return nil
end


function hubEmoteNames()
    local out, seen = {}, {}
    local function push(nm)
        nm = tostring(nm or "")
        if nm ~= "" and nm ~= "..." and not seen[nm] then seen[nm] = true table.insert(out, nm) end
    end
    for nm in pairs(HUB_EMOTES) do push(nm) end
    local ex = getgenv()._HubEmoteExtra
    if type(ex) == "table" then
        for nm in pairs(ex) do push(nm) end
    end
    table.sort(out)
    return out
end


function hubEmoteCleanName(s)
    s = tostring(s or ""):gsub("[%c%z]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #s > 40 then s = s:sub(1, 40) end
    return s
end


-- Deep emote-library reader: ReplicatedStorage.Modules.*Emote* ??" the file
-- with ALL the emotes. Handles a ModuleScript table (required and dumped
-- exactly like the skins code already does for CosmeticLibrary), folders of
-- Animation instances, and value objects. Caps everywhere so a weirdly
-- shaped library can never hang the scan.
function hubEmoteScanModules()
    local added = 0
    local ex = getgenv()._HubEmoteExtra
    if type(ex) ~= "table" then ex = {} getgenv()._HubEmoteExtra = ex end
    local function add(name, id)
        name = hubEmoteCleanName(name)
        local digits = tostring(id or ""):match("(%d+)")
        if name == "" or not digits or #digits < 5 then return end
        if HUB_EMOTES[name] then return end
        ex[name] = ex[name] or {}
        local asset = "rbxassetid://" .. digits
        for _, e in ipairs(ex[name]) do if e == asset then return end end
        if #ex[name] == 0 then added += 1 end
        table.insert(ex[name], asset)
        if #ex[name] > 4 then table.remove(ex[name], 1) end
    end
    local function dumpTable(t, depth, seen)
        if depth > 4 or type(t) ~= "table" then return end
        if seen[t] then return end
        seen[t] = true
        local n = 0
        for k, v in pairs(t) do
            n += 1
            if n > 500 then break end
            if type(v) == "string" then
                if type(k) == "string" and v:match("%d+") then add(k, v) end
            elseif type(v) == "number" then
                if type(k) == "string" then
                    local digits = tostring(math.floor(v)):match("(%d+)")
                    if digits and #digits >= 8 then add(k, v) end
                end
            elseif type(v) == "table" then
                local nm, id = nil, nil
                pcall(function()
                    if type(v.Name) == "string" then nm = v.Name end
                    for _, fk in ipairs({ "AnimationId", "Id", "ID", "AssetId", "AssetID" }) do
                        local fv = v[fk]
                        if type(fv) == "string" and fv:match("%d+") then id = fv break end
                        if type(fv) == "number" then id = tostring(fv) break end
                    end
                end)
                if nm and id then add(nm, id)
                else dumpTable(v, depth + 1, seen) end
            elseif typeof(v) == "Instance" then
                local okIsAn, isAn = pcall(function() return v:IsA("Animation") end)
                if okIsAn and isAn then
                    local aid = ""
                    pcall(function() aid = v.AnimationId end)
                    add((type(k) == "string" and k) or v.Name, aid)
                end
            end
        end
    end
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cands = {}
        if mods then
            for _, c in ipairs(mods:GetChildren()) do
                local nm = ""
                pcall(function() nm = string.lower(c.Name or "") end)
                local kind = nil
                if nm == "emotes" or string.find(nm, "emote", 1, true) then kind = "full"
                elseif string.find(nm, "dance", 1, true) then kind = "full"
                elseif string.find(nm, "animation", 1, true) then kind = "walk" end
                if kind then table.insert(cands, { inst = c, kind = kind }) end
            end
        end
        local top = ReplicatedStorage:FindFirstChild("Emotes")
        if top then table.insert(cands, { inst = top, kind = "full" }) end
        for _, e in ipairs(cands) do
            local c, kind = e.inst, e.kind
            local isMod = false
            pcall(function() isMod = c:IsA("ModuleScript") end)
            if isMod and kind == "full" then
                local okM, lib = pcall(require, c)
                if okM and type(lib) == "table" then dumpTable(lib, 1, {}) end
            else
                pcall(function()
                    local scanned = 0
                    for _, d in ipairs(c:GetDescendants()) do
                        scanned += 1
                        if scanned > 600 then break end
                        if d:IsA("Animation") then
                            local aid = ""
                            pcall(function() aid = d.AnimationId end)
                            add(d.Name, aid)
                        elseif d:IsA("StringValue") then
                            local sv = ""
                            pcall(function() sv = d.Value end)
                            if tostring(sv):match("%d+") then add(d.Name, sv) end
                        elseif d:IsA("ModuleScript") then
                            local okM, lib = pcall(require, d)
                            if okM and type(lib) == "table" then dumpTable(lib, 1, {}) end
                        end
                    end
                end)
            end
        end
    end)
    return added
end


-- Cosmetic emotes: the same library that holds skins/finishers/charms often
-- holds Type=="Emote" entries too. Names always list (that's the catalog);
-- ids ride along when the entry carries one, otherwise playback falls back
-- to the engine pipe by raw name.
function hubEmoteScanCosmetics()
    local added = 0
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local cl = mods and mods:FindFirstChild("CosmeticLibrary")
        local lib = cl and require(cl)
        local all = lib and lib.Cosmetics or {}
        local ex = getgenv()._HubEmoteExtra
        if type(ex) ~= "table" then ex = {} getgenv()._HubEmoteExtra = ex end
        for name, info in pairs(all) do
            if type(info) == "table" and string.lower(tostring(info.Type or "")) == "emote" then
                if not HUB_EMOTES[name] and not ex[name] then
                    local ids = {}
                    for _, fk in ipairs({ "AnimationId", "Id", "ID", "AssetId", "AssetID", "EmoteId" }) do
                        local fv = info[fk]
                        local digits = type(fv) == "string" and fv:match("(%d+)")
                            or (type(fv) == "number" and tostring(fv):match("(%d+)"))
                        if digits and #digits >= 5 then table.insert(ids, "rbxassetid://" .. digits) end
                    end
                    ex[name] = ids
                    added += 1
                end
            end
        end
    end)
    return added
end


-- Scan the game for emote animations (emote folders, Animation instances,
-- emote shop UI) and merge them into the dropdown. Read-only, re-runnable.
function hubEmoteScan()
    local found = {}
    getgenv()._HubEmoteRemotes = nil
    local function addId(name, id)
        name = hubEmoteCleanName(name)
        local digits = tostring(id or ""):match("(%d+)")
        if name == "" or not digits then return end
        if HUB_EMOTES[name] then return end
        found[name] = found[name] or {}
        local asset = "rbxassetid://" .. digits
        for _, e in ipairs(found[name]) do if e == asset then return end end
        table.insert(found[name], asset)
        if #found[name] > 4 then table.remove(found[name], 1) end
    end
    pcall(function()
        local roots = {}
        if ReplicatedStorage then table.insert(roots, ReplicatedStorage) end
        local ps = LP:FindFirstChildOfClass("PlayerScripts")
        if ps then table.insert(roots, ps) end
        if getgenv()._EmoteLP.PlayerGui then table.insert(roots, getgenv()._EmoteLP.PlayerGui) end
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                local isEmoteBin = false
                pcall(function()
                    if string.find(string.lower(d.Name or ""), "emote", 1, true) then
                        isEmoteBin = true
                    end
                end)
                if isEmoteBin then
                    if d:IsA("Animation") then
                        pcall(function() addId(d.Name, d.AnimationId) end)
                    end
                    pcall(function()
                        for _, c in ipairs(d:GetDescendants()) do
                            if c:IsA("Animation") then addId(c.Name, c.AnimationId) end
                        end
                    end)
                elseif d:IsA("Animation") then
                    local dn = ""
                    pcall(function() dn = string.lower(d.Name or "") end)
                    if string.find(dn, "dance", 1, true) or string.find(dn, "floss", 1, true)
                        or string.find(dn, "wave", 1, true) or string.find(dn, "cheer", 1, true)
                        or string.find(dn, "dab", 1, true) or string.find(dn, "shuffle", 1, true)
                        or string.find(dn, "groove", 1, true) or string.find(dn, "party", 1, true) then
                        pcall(function() addId(d.Name, d.AnimationId) end)
                    end
                end
            end
        end
    end)
    local ex = getgenv()._HubEmoteExtra
    if type(ex) ~= "table" then ex = {} getgenv()._HubEmoteExtra = ex end
    local n = 0
    for nm, ids in pairs(found) do
        if not HUB_EMOTES[nm] then ex[nm] = ids n += 1 end
    end
    -- the Modules emote library itself (all the emotes in one file)
    pcall(function() n += hubEmoteScanModules() end)
    -- cosmetic emotes riding in CosmeticLibrary next to the finishers
    pcall(function() n += hubEmoteScanCosmetics() end)
    if getgenv()._EmoteCfg.EmoteCustomId ~= "" then
        local digits = tostring(getgenv()._EmoteCfg.EmoteCustomId):match("(%d+)")
        if digits then ex["Custom"] = { "rbxassetid://" .. digits } end
    end
    hubRefreshEmotes()
    return n
end


function hubRefreshEmotes()
    local names = hubEmoteNames()
    if #names == 0 then return end
    hubSetDropdown("EmoteName", names)
    local cur = tostring(getgenv()._EmoteCfg.EmoteName or "")
    if cur == "" or cur == "..." then
        getgenv()._EmoteCfg.EmoteName = names[1]
        local o = getgenv().Options and getgenv().Options.EmoteName
        if o then pcall(function() o:SetValue(names[1]) end) end
    end
end


function hubPlayCustomEmote()
    local digits = tostring(getgenv()._EmoteCfg.EmoteCustomId or ""):match("(%d+)")
    if not digits then
        hubNotify("Custom emote: paste an animation id first", 2, "miss")
        return
    end
    local ex = getgenv()._HubEmoteExtra
    if type(ex) ~= "table" then ex = {} getgenv()._HubEmoteExtra = ex end
    ex["Custom"] = { "rbxassetid://" .. digits }
    hubRefreshEmotes()
    getgenv()._EmoteCfg.EmoteName = "Custom"
    local o = getgenv().Options and getgenv().Options.EmoteName
    if o then pcall(function() o:SetValue("Custom") end) end
    hubPlayEmote("Custom", getgenv()._EmoteCfg.EmoteSpeed, getgenv()._EmoteCfg.EmoteLoop)
end


function hubStopEmote()
    getgenv()._HubEmoteLoop = false
    getgenv()._HubEmoteName = nil
    -- Stop RIVALS native emote instance (path 0: PlayClient)
    pcall(function()
        local inst = getgenv()._HubEmoteRivalsInst
        if inst and type(inst.Destroy) == "function" then inst:Destroy() end
        getgenv()._HubEmoteRivalsInst = nil
    end)
    pcall(function()
        local t = getgenv()._HubEmoteTrack
        if t then t:Stop() end
        getgenv()._HubEmoteTrack = nil
    end)
    pcall(function()
        -- also stop engine-driven default emotes (PlayEmote path)
        local char = getgenv()._EmoteLP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local an = hum and hum:FindFirstChildOfClass("Animator")
        if an then
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                if tr.Priority == Enum.AnimationPriority.Action then
                    tr:Stop()
                end
            end
        end
    end)
end


-- Speed slider rides whatever is playing (both engine + custom paths).
function hubEmoteSetSpeed(spd)
    getgenv()._EmoteCfg.EmoteSpeed = spd
    pcall(function()
        local t = getgenv()._HubEmoteTrack
        if t then t:AdjustSpeed(spd) end
        local char = getgenv()._EmoteLP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local an = hum and hum:FindFirstChildOfClass("Animator")
        if an then
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                if tr.Priority == Enum.AnimationPriority.Action then
                    tr:AdjustSpeed(spd)
                end
            end
        end
    end)
end


-- Best-effort SERVER emote: finds the game's own emote RemoteEvent and
-- fires it so EVERYONE sees the dance, not just you. Shop/purchase/equip
-- remotes are never touched ??" firing those could buy things. RemoteEvents
-- only (never Functions: a wrong InvokeServer can hang the thread).
function hubPlayEmoteRemote(name, ids)
    local fired = false
    pcall(function()
        local cache = getgenv()._HubEmoteRemotes
        if type(cache) ~= "table" then
            cache = {}
            getgenv()._HubEmoteRemotes = cache
            local rems = ReplicatedStorage:FindFirstChild("Remotes")
            local roots = {}
            if rems then table.insert(roots, rems) end
            table.insert(roots, ReplicatedStorage)
            for _, root in ipairs(roots) do
                for _, d in ipairs(root:GetDescendants()) do
                    local okE = false
                    pcall(function() okE = d:IsA("RemoteEvent") end)
                    if okE then
                        local nm = string.lower(d.Name or "")
                        local isEmote = string.find(nm, "emote", 1, true)
                            or string.find(nm, "dance", 1, true)
                        local isShop = string.find(nm, "buy", 1, true)
                            or string.find(nm, "purchase", 1, true)
                            or string.find(nm, "shop", 1, true)
                            or string.find(nm, "equip", 1, true)
                            or string.find(nm, "unlock", 1, true)
                            or string.find(nm, "price", 1, true)
                            or string.find(nm, "cost", 1, true)
                            or string.find(nm, "store", 1, true)
                        if isEmote and not isShop then table.insert(cache, d) end
                    end
                end
            end
        end
        for _, r in ipairs(cache) do
            pcall(function()
                r:FireServer(tostring(name))
                fired = true
            end)
            if ids and ids[1] then
                pcall(function() r:FireServer(tostring(ids[1])) end)
            end
        end
    end)
    return fired
end


-- Asset loader, hardened: Animation parented to the Animator before load
-- (bare instances fail on some builds), content preloaded, then verified.
-- Returns a loaded track or nil - never a dead handle.
function hubLoadEmoteTrack(an, ids)
    for _, id in ipairs(ids or {}) do
        local track = nil
        pcall(function()
            local aid = tostring(id or "")
            if aid == "" then return end
            if not aid:match("%d+") then return end
            if not string.find(aid, "rbxassetid://", 1, true) then
                local digits = aid:match("(%d+)")
                if digits then aid = "rbxassetid://" .. digits end
            end
            local a = Instance.new("Animation")
            a.AnimationId = aid
            a.Parent = an
            pcall(function()
                game:GetService("ContentProvider"):PreloadAsync({ a })
            end)
            local t = an:LoadAnimation(a)
            if t then
                local t0 = tick()
                while (t.Length or 0) <= 0.1 and tick() - t0 < 1.2 do task.wait(0.1) end
                if (t.Length or 0) > 0.1 then track = t end
            end
        end)
        if track then return track end
    end
    return nil
end


-- Play-verify: actually Plays each candidate id and keeps the first one
-- that reports IsPlaying. Fixes "emote picked but nothing moves": old code
-- trusted LoadAnimation alone, and dead/moderated ids load as ghosts.
function hubPlayEmoteAsset(an, ids, speed, loop)
    for _, id in ipairs(ids or {}) do
        local ok, track = pcall(function() return hubLoadEmoteTrack(an, { id }) end)
        if ok and track then
            local played = false
            pcall(function()
                track.Looped = loop and true or false
                track.Priority = Enum.AnimationPriority.Action
                track:Play(0.15, 1, speed or 1)
                track:AdjustSpeed(speed or 1)
                local t0 = tick()
                while not track.IsPlaying and tick() - t0 < 0.8 do task.wait(0.05) end
                played = track.IsPlaying and true or false
                if not played then track:Stop() end
            end)
            if played then return track end
        end
    end
    return nil
end


-- Snapshot of playing tracks, so engine-emote paths only claim tracks that
-- STARTED after our invoke (gun poses/idles that were already playing must
-- never count as "your emote played").
function hubPlayingSet(an)
    local s = {}
    pcall(function()
        if an then
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                s[tr] = true
            end
        end
    end)
    return s
end


function hubPlayEmote(name, speed, loop, notify)
    hubStopEmote()
    name = name or getgenv()._EmoteCfg.EmoteName or "Dance 1"
    speed = speed or getgenv()._EmoteCfg.EmoteSpeed or 1
    loop = (loop ~= nil and loop) or getgenv()._EmoteCfg.EmoteLoop or false
    -- manual presses notify; auto replays (loop/persist) stay silent
    local doNotify = (notify ~= false) and (ELI.emote_notify ~= false);
    local char = getgenv()._EmoteLP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        hubNotify("Emote: no character yet", 2, "miss")
        return
    end
    -- Sit is a state, not an animation
    if name == "Sit" then
        pcall(function() hum.Sit = true end)
        getgenv()._HubEmoteName = name
        if doNotify then hubNotify("Emote: Sit", 2, "hit") end
        return
    end
    -- path 0: RIVALS native PlayClient ” the game's own emote OOP class.
    -- Handles multi-part emotes (props, sounds, networked character anim).
    -- This is what the game calls when you press an emote button in-game.
    do
        local rivalsPlayed = false
        pcall(function()
            local modFolder = game:GetService("ReplicatedStorage").Modules.Emotes
            local mod = modFolder and modFolder:FindFirstChild(name)
            if not mod then return end
            local ok, cls = pcall(require, mod)
            if not ok or type(cls) ~= "table" then return end
            local FC = require(getgenv()._EmoteLP.PlayerScripts.Controllers.FighterController)
            local lf = FC and FC.LocalFighter
            if not lf then return end
            local inst = nil
            pcall(function() inst = cls.new() end)
            if not inst then pcall(function() inst = cls.new(lf) end) end
            if not inst then return end
            local okPC = pcall(function() inst:PlayClient(lf, 1, {}) end)
            if okPC then
                getgenv()._HubEmoteRivalsInst = inst
                getgenv()._HubEmoteName = name
                if doNotify then hubNotify("Emote: " .. tostring(name), 2, "hit") end
                rivalsPlayed = true
            end
        end)
        if rivalsPlayed then return end
    end
    -- server-first: the game's own emote remote makes EVERYONE see it.
    -- Local tracks below still play as the guaranteed visual.
    pcall(function() hubPlayEmoteRemote(name, hubEmoteIdsFor(name)) end)
    local an = hum:FindFirstChildOfClass("Animator")
    if not an then
        pcall(function() an = hum:WaitForChild("Animator", 3) end)
    end
    -- path 1: the GAME's own emote pipe (Animate.PlayEmote bindable).
    -- rig-correct by definition ??" this is what /e dance uses.
    local defName = HUB_EMOTE_DEFAULTS[name]
    if defName and char then
        local before1 = hubPlayingSet(an)
        pcall(function()
            local animate = char:FindFirstChild("Animate")
            local bf = animate and animate:FindFirstChild("PlayEmote")
            if bf then bf:Invoke(defName) end
        end)
        task.wait(0.3)
        local played = false
        if an then
            pcall(function()
                for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                    if tr.IsPlaying and not before1[tr] then -- v16: no Length gate (streaming rigs report 0)
                        tr:AdjustSpeed(speed)
                        getgenv()._HubEmoteTrack = tr
                        played = true
                    end
                end
            end)
        end
        if played then
            getgenv()._HubEmoteName = name
            if loop then hubEmoteLoopWatch(name) end
            if doNotify then hubNotify("Emote: " .. tostring(name), 2, "hit") end
            return
        end
    end
    -- path 2: engine default (Humanoid:PlayEmote) for classic names
    if defName then
        local before2 = hubPlayingSet(an)
        pcall(function() hum:PlayEmote(defName) end)
        task.wait(0.3)
        local played2 = false
        if an then
            pcall(function()
                for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                    if tr.IsPlaying and not before2[tr] then -- v16: no Length gate (streaming rigs report 0)
                        tr:AdjustSpeed(speed)
                        getgenv()._HubEmoteTrack = tr
                        played2 = true
                    end
                end
            end)
        end
        if played2 then
            getgenv()._HubEmoteName = name
            if loop then hubEmoteLoopWatch(name) end
            if doNotify then hubNotify("Emote: " .. tostring(name), 2, "hit") end
            return
        end
    end
    -- path 3: asset pools, play-verified per id (dead ids are skipped,
    -- the first id that actually moves the rig wins)
    if not an then
        hubNotify("Emote: no Animator", 2, "miss")
        return
    end
    local track = nil
    local ids = hubEmoteIdsFor(name)
    if ids and #ids > 0 then track = hubPlayEmoteAsset(an, ids, speed, loop) end
    if not track and an then
        -- id-less game emote: last resort is the engine pipe by raw name
        pcall(function() hum:PlayEmote(name) end)
        task.wait(0.3)
        pcall(function()
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                if tr.IsPlaying then -- v16: no Length gate (streaming rigs report 0)
                    tr:AdjustSpeed(speed)
                    getgenv()._HubEmoteTrack = tr
                    track = tr
                end
            end
        end)
    end
    if not track then
        local n = (ids and #ids) or 0
        hubNotify("Emote failed: " .. tostring(name) .. " (" .. tostring(n) .. " ids, none played)", 3, "miss")
        return
    end
    getgenv()._HubEmoteTrack = track
    getgenv()._HubEmoteName = name
    pcall(function()
        track.Looped = loop
        track.Priority = Enum.AnimationPriority.Action4
        track:Play(0.15, 1, speed)
        track:AdjustSpeed(speed)
    end)
    if loop then hubEmoteLoopWatch(name) end
    if doNotify then hubNotify("Emote: " .. tostring(name), 2, "hit") end
end


function hubEmoteWalkTick() -- walk while emoting: stop facing-lock while moving --
    if getgenv()._HubEmoteName == nil then return end
    pcall(function()
        local char = getgenv()._EmoteLP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum.MoveDirection.Magnitude > 0.1 then
            if hum.AutoRotate ~= false then hum.AutoRotate = false end
        elseif hum.AutoRotate ~= true then
            hum.AutoRotate = true
        end
    end)
end
function hubEmotePersistTick() -- match-proof: replay whenever the track dies --
    local want = getgenv()._HubEmoteName
    if not want then return end
    local alive = false
    pcall(function()
        local char = getgenv()._EmoteLP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then alive = true return end
        local an = hum:FindFirstChildOfClass("Animator")
        if an then
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                if tr.IsPlaying and tr.Priority == Enum.AnimationPriority.Action then
                    alive = true
                    break
                end
            end
        end
        if not alive and getgenv()._HubEmoteRivalsInst then alive = true end
    end)
    if not alive and (getgenv()._HubEmoteRetryAt or 0) + 1.0 < tick() then
        getgenv()._HubEmoteRetryAt = tick()
        local nm = getgenv()._HubEmoteName
        getgenv()._HubEmoteName = nil
        getgenv()._HubEmoteInst = nil
        hubPlayEmote(nm, getgenv()._EmoteCfg.EmoteSpeed, getgenv()._EmoteCfg.EmoteLoop, false)
    end
end
function hubEmoteLoopWatch(name)
    getgenv()._HubEmoteLoop = true
    task.spawn(function()
        while getgenv()._HubEmoteLoop and getgenv()._HubEmoteName == name do
            task.wait(0.5)
            -- Check if track is still alive
            local alive = false
            pcall(function()
                local t = getgenv()._HubEmoteTrack
                if t and t.IsPlaying then
                    alive = true
                    t:AdjustSpeed(getgenv()._EmoteCfg.EmoteSpeed or 1)
                end
            end)
            -- Check current character health (not captured var ” always live getgenv()._EmoteLP.Character)
            local ch = getgenv()._EmoteLP.Character
            local h2 = ch and ch:FindFirstChildOfClass("Humanoid")
            local charAlive = h2 and h2.Health > 0
            if not alive then
                if getgenv()._HubEmoteLoop and getgenv()._HubEmoteName == name then
                    if charAlive then
                        -- Track died but char is alive: stun/interrupt ” replay now
                        getgenv()._HubEmoteLoop = false
                        hubPlayEmote(name, getgenv()._EmoteCfg.EmoteSpeed, true, false)
                        return
                    else
                        -- Char dead/resetting ” wait for new character to spawn then replay
                        local waited = 0
                        while waited < 8 do
                            task.wait(0.3)
                            waited += 0.3
                            local newCh = getgenv()._EmoteLP.Character
                            local newHum = newCh and newCh:FindFirstChildOfClass("Humanoid")
                            if newHum and newHum.Health > 0 then
                                task.wait(0.5) -- let character fully load
                                if getgenv()._HubEmoteLoop and getgenv()._HubEmoteName == name then
                                    getgenv()._HubEmoteLoop = false
                                    hubPlayEmote(name, getgenv()._EmoteCfg.EmoteSpeed, true, false)
                                end
                                return
                            end
                        end
                        break -- timed out waiting for respawn
                    end
                end
                break
            end
            if not charAlive then break end
        end
    end)
end


-- Manual shots: equipped mag dropped since last frame = a bullet left.
-- (Refills/reloads only ever RAISE the number, so they can't false-fire.)
_shotAmmoBase = nil
_shotItemId   = nil


function detectShotSound()
    if not getgenv()._EmoteCfg.HitSoundEnabled then return end
    local fc = getFC()
    local lf = fc and fc.LocalFighter
    local it = lf and lf.EquippedItem
    local ammo = it and it.Data and it.Data.Ammo
    local oid = nil
    pcall(function() oid = it and it:Get("ObjectID") end)
    if oid ~= _shotItemId then
        _shotItemId = oid
        _shotAmmoBase = ammo
        return
    end
    if type(ammo) == "number" and type(_shotAmmoBase) == "number" then
        local drop = _shotAmmoBase - ammo
            if drop > 0 and drop <= 50 then playHitSound() hubTracerManual() end
    end
    _shotAmmoBase = ammo
end


-- Kills: elimination-feed slot whose Eliminator label is you. Victim labels
-- with your name are ignored (that's you dying, no jingle for that).
_killFeedBase = nil


function detectKillSound()
    if not getgenv()._EmoteCfg.KillSoundEnabled then
        _killFeedBase = nil
        return
    end
    -- NOLAG: cached feed ref (recursive FindFirstChild is a full-tree walk).
    local feed = getgenv()._HubKillFeed
    if not (feed and feed.Parent) then
        local mg = getgenv()._EmoteLP.PlayerGui:FindFirstChild("MainGui")
        feed = mg and mg:FindFirstChild("EliminationFeed", true)
        getgenv()._HubKillFeed = feed
    end
    if not feed then
        _killFeedBase = nil
        return
    end
    local myDisp = getgenv()._EmoteLP.DisplayName
    local n = 0
    local _desc = feed:GetDescendants()
    for _i = 1, math.min(#_desc, 200) do
        local c = _desc[_i]
        if c:IsA("TextLabel") and c.Parent and c.Parent.Name == "Eliminator" then
            local t = c.Text
            if t == REAL_NAME or t == REAL_DISPLAY or t == myDisp
                or (getgenv()._EmoteCfg.SettingsDisplay ~= "" and t == getgenv()._EmoteCfg.SettingsDisplay) then
                n += 1
            end
        end
    end
    if _killFeedBase == nil then
        _killFeedBase = n
    elseif n > _killFeedBase then
        _killFeedBase = n
        playKillSound()
        -- v16: secret-inspect chance roll on every elimination
        if (getgenv()._EmoteCfg.InspectChance or 0) > 0 and math.random(1, 100) <= getgenv()._EmoteCfg.InspectChance then
            task.spawn(function() pcall(function() hubSecretInspect() end) end)
        end
    elseif n < _killFeedBase then
        _killFeedBase = n
    end
end



