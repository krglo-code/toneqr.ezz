-- RIVALS HUB emote engine (ported verbatim, elisium-wired)
-- bridge: rivals Cfg/LP/hubNotify -> elisium ELI/local_player/Library:Notify
ELI.emote_name = ELI.emote_name or 'Dance 1';
ELI.emote_speed = ELI.emote_speed or 1;
ELI.emote_loop = ELI.emote_loop or false;
if ELI.emote_notify == nil then ELI.emote_notify = true end;
ELI.emote_custom = ELI.emote_custom or '';
getgenv()._EmoteCfg = setmetatable({}, { __index = function(_, k)
    if k == 'EmoteName' then return ELI.emote_name end;
    if k == 'EmoteSpeed' then return ELI.emote_speed end;
    if k == 'EmoteLoop' then return ELI.emote_loop end;
    if k == 'EmoteCustomId' then return ELI.emote_custom end;
    return ELI[k];
end, __newindex = function(_, k, v)
    if k == 'EmoteName' then ELI.emote_name = v return end;
    if k == 'EmoteSpeed' then ELI.emote_speed = v return end;
    if k == 'EmoteLoop' then ELI.emote_loop = v return end;
    if k == 'EmoteCustomId' then ELI.emote_custom = v return end;
    ELI[k] = v;
end });
getgenv()._EmoteLP = local_player;
local function hubNotify(text, secs, kind)
    pcall(function() Library:Notify(text, secs) end);
end;
local function hubSetDropdown(flag, values)
    local o = Options and Options[flag];
    if not o then return false end;
    if type(values) ~= 'table' or #values == 0 then values = { '...' } end;
    o.Values = values;
    pcall(function() o:SetValues() end);
    return true;
end;
